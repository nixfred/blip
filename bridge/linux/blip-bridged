#!/usr/bin/env python3
"""blip-bridged — keeps `imsg serve` channels open to the Mac.

Every one-shot bridge call pays a fixed toll before it reads a single row:
~16 ms ssh round trip, ~25 ms for blip-dispatch's Python start, ~20 ms for
imsg's own, and ~27 ms to open a 218 MB chat.db — while the SQL underneath
runs in about a millisecond. That toll, not the work, is what made Blip feel
subtly laggy. This daemon pays it once per channel and holds the channel open,
so a query costs the query.

Measured on the gateway Mac, one-shot → on the channel:
    recent 150      100 ms →  11 ms
    groups          145 ms →  25 ms
    thread 40 rich  197 ms →  71 ms
    chats 300       341 ms → 259 ms   (compute-bound, not startup-bound)

Shape
-----
A unix socket at $XDG_RUNTIME_DIR/blip/bridge.sock. Without XDG_RUNTIME_DIR
the base is /tmp/blip-<uid>, created 0700 by this uid. Both directories are
checked before use — a real directory, not a symlink, owned by this uid, no
group or other bits — and so is the socket; anything else and the daemon
refuses to start. The client (collector.ts) runs the same checks before it
connects, and the daemon answers only peers with its own uid (SO_PEERCRED):
a socket someone else planted never receives a request or answers one.

One connection is one request: the client writes a single JSON line and reads
a framed reply, then the connection closes.

    ->  {"argv": ["--json","recent","150"], "stdin": "optional"}
    <-  {"status":0,"len":N}\\n  followed by exactly N bytes

`stdin` is passed through to the command, so message text keeps riding stdin
rather than argv (`search --stdin`) exactly as it does one-shot.

A reply of {"fallback":true,"status":75,"len":N} means the daemon could not
answer — busy, a deadline, a dead channel, a bad bridge.conf — and the client
takes the one-shot path. The N bytes say why; they are never command output.

Requests get the SAME `--hide-spam` / `--hide-unknown` the shim injects,
read from bridge.conf on every request just as the shim reads it on every
call, so the fast path never shows a conversation the slow one hides.

Channels are POOLED. Blip refreshes the thread list and reloads the open
conversation in parallel on every push ping; with a single channel the reload
would queue behind a 259 ms `chats` call and the fix would make the case it
was meant to help slower.

Everything that touches the network has a deadline: the spawn handshake, the
request write and the complete reply. A silent half-open peer costs at most
one deadline, after which that ssh child is killed and reaped and its slot is
free again; ssh's ServerAlive probes catch a dead link on the idle channel.
At most MAX_QUEUED clients wait for a slot; the rest are told to fall back at
once instead of queueing behind a stall.

This daemon is an accelerator and never a dependency. If it is not running,
cannot start, or dies mid-flight, the shim's ordinary one-shot ssh path still
answers — the client falls back on any error at all. That is also why it may
exit freely when idle.
"""
from __future__ import annotations

import errno
import json
import os
import re
import select
import signal
import socket
import stat
import struct
import subprocess
import sys
import threading
import time

# Same allowlists the shim applies (audit #7): bridge.conf is DATA, and
# python/remote_bin are interpolated into a remote shell command when the
# dedicated key is absent. A hostile value would execute on the Mac.
_HOST_RE = re.compile(r"^([A-Za-z0-9._-]+@)?[A-Za-z0-9._:-]+$")
_PYTHON_RE = re.compile(r"^[A-Za-z0-9._/-]+$")
_REMOTE_BIN_RE = re.compile(r"^[A-Za-z0-9._/\$-]+$")
_KEY_RE = re.compile(r"^[A-Za-z0-9._/-]+$")

EX_CONFIG = 78                  # the shim's exit for a refused bridge.conf
POOL_SIZE = 2
MAX_QUEUED = 4                  # clients that may wait for a slot; more fall back
IDLE_EXIT_SECONDS = 15 * 60
CONNECT_TIMEOUT = "8"
SPAWN_TIMEOUT = 12.0            # ssh connect + two Python starts + "ready"
REQUEST_TIMEOUT = 12.0          # queue wait + spawn + write + the complete reply
CLIENT_IO_TIMEOUT = 5.0         # reading the request line from the local client
REPLY_IO_TIMEOUT = 10.0         # writing the reply back to it
MAX_REQUEST = 1 << 20           # a request line is argv (+ a search's stdin)
MAX_BODY = 256 << 20            # a reply header claiming more is a desync
FALLBACK_STATUS = 75            # EX_TEMPFAIL, only ever inside a fallback frame
_TRUTHY = {"on", "yes", "true", "1"}


class ConfError(Exception):
    """bridge.conf holds something the shim would refuse."""


class ChannelError(Exception):
    """The serve channel is unusable; it has been (or will be) killed."""


class ChannelTimeout(ChannelError):
    """A deadline passed while waiting on the Mac."""


class Busy(Exception):
    """More clients are waiting than MAX_QUEUED allows."""


class UntrustedRuntime(Exception):
    """The socket's directory is not provably this uid's alone."""


# ------------------------------------------------------------ socket trust

def check_private_dir(path: str, uid: int) -> None:
    """Refuse anything but a real directory owned by `uid` with no group or
    other bits. lstat, so a symlink is refused rather than followed."""
    try:
        st = os.lstat(path)
    except OSError as e:
        raise UntrustedRuntime(f"{path}: {e.strerror}") from None
    if stat.S_ISLNK(st.st_mode):
        raise UntrustedRuntime(f"{path} is a symlink")
    if not stat.S_ISDIR(st.st_mode):
        raise UntrustedRuntime(f"{path} is not a directory")
    if st.st_uid != uid:
        raise UntrustedRuntime(f"{path} is owned by uid {st.st_uid}, not {uid}")
    if st.st_mode & 0o077:
        raise UntrustedRuntime(f"{path} has mode {stat.S_IMODE(st.st_mode):o}, want 700")


def check_private_socket(path: str, uid: int) -> None:
    st = os.lstat(path)
    if not stat.S_ISSOCK(st.st_mode):
        raise UntrustedRuntime(f"{path} is not a socket")
    if st.st_uid != uid:
        raise UntrustedRuntime(f"{path} is owned by uid {st.st_uid}, not {uid}")
    if st.st_mode & 0o077:
        raise UntrustedRuntime(f"{path} has mode {stat.S_IMODE(st.st_mode):o}, want 600")


def _private_mkdir(path: str) -> None:
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass                    # whatever is there is checked next, never trusted


def runtime_dir(env=None, uid: int | None = None, create: bool = True,
                tmp_root: str = "/tmp") -> str:
    """$XDG_RUNTIME_DIR/blip, or /tmp/blip-<uid>/blip without one. Every
    level is verified, never assumed: `/tmp/blip-<uid>` is a predictable name
    another local user can create first, and makedirs(exist_ok=True) would
    have accepted their directory."""
    env = os.environ if env is None else env
    uid = os.getuid() if uid is None else uid
    base = env.get("XDG_RUNTIME_DIR") or ""
    if base:
        if not os.path.isabs(base):
            raise UntrustedRuntime("XDG_RUNTIME_DIR is not an absolute path")
    else:
        base = os.path.join(tmp_root, f"blip-{uid}")
        if create:
            _private_mkdir(base)
    check_private_dir(base, uid)
    d = os.path.join(base, "blip")
    if create:
        _private_mkdir(d)
    check_private_dir(d, uid)
    return d


def socket_path(env=None, uid: int | None = None, create: bool = True) -> str:
    return os.path.join(runtime_dir(env, uid, create), "bridge.sock")


def peer_uid(conn: socket.socket) -> int:
    creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    return struct.unpack("3i", creds)[1]


# ------------------------------------------------------------ bridge.conf

def validate_conf(conf: dict) -> None:
    """Refuse values the shim would refuse, before any channel interpolates
    them into a remote shell command."""
    host = conf.get("host") or ""
    if host and not _HOST_RE.match(host):
        raise ConfError("blip-bridged: refusing host — expected [user@]hostname")
    python = conf.get("python") or ""
    remote_bin = conf.get("remote_bin") or ""
    key = conf.get("key") or ""
    if not (_PYTHON_RE.match(python) and _REMOTE_BIN_RE.match(remote_bin) and _KEY_RE.match(key)):
        raise ConfError("blip-bridged: refusing python/remote_bin/key — plain paths only")


def _unquote(v: str) -> str:
    """The shim's quote stripping, exactly: one leading and one trailing
    double quote, then one leading and one trailing single quote."""
    v = v[1:] if v.startswith('"') else v
    v = v[:-1] if v.endswith('"') else v
    v = v[1:] if v.startswith("'") else v
    v = v[:-1] if v.endswith("'") else v
    return v


def read_conf(env=None) -> dict:
    """The keys the shim parses, with the same rules: the file is DATA, never
    sourced, remote_bin stays literal (the Mac expands it), the last line for
    a key wins, and BLIP_MAC_HOST overrides host=. Raises ConfError."""
    env = os.environ if env is None else env
    home = env.get("HOME") or os.path.expanduser("~")
    path = env.get("BLIP_BRIDGE_CONF") or os.path.join(home, ".config/blip/bridge.conf")
    conf = {"host": "", "key": os.path.join(home, ".ssh/blip_ed25519"),
            "remote_bin": "$HOME/.blip/bin", "python": "python3",
            "hide_spam": "", "hide_unknown": ""}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.split("#", 1)[0]
                line = "".join(line.split())
                if "=" not in line:
                    continue
                k, v = line.split("=", 1)
                if k in conf:
                    conf[k] = _unquote(v)
    except OSError:
        pass
    conf["host"] = env.get("BLIP_MAC_HOST") or conf["host"]
    validate_conf(conf)
    return conf


def imsg_flags(conf: dict) -> list[str]:
    """What the shim puts in front of every imsg call, in the shim's order."""
    flags = []
    if conf.get("hide_spam", "").lower() in _TRUTHY:
        flags.append("--hide-spam")
    if conf.get("hide_unknown", "").lower() in _TRUTHY:
        flags.append("--hide-unknown")
    return flags


def build_request(line: bytes, conf: dict) -> bytes:
    """The client's request with the configured filters in front of argv —
    the same argv the shim would have sent one-shot. Raises ValueError."""
    req = json.loads(line)
    if not isinstance(req, dict):
        raise ValueError("request must be an object")
    argv = req.get("argv")
    if not isinstance(argv, list) or not all(isinstance(a, str) for a in argv):
        raise ValueError("argv must be a list of strings")
    out: dict = {"argv": imsg_flags(conf) + argv}
    stdin = req.get("stdin")
    if stdin is not None:
        if not isinstance(stdin, str):
            raise ValueError("stdin must be a string")
        out["stdin"] = stdin
    return json.dumps(out).encode("utf-8") + b"\n"


def fallback_frame(reason: str) -> bytes:
    body = f"blip-bridged: {reason}\n".encode("utf-8", "replace")
    head = {"fallback": True, "status": FALLBACK_STATUS, "len": len(body)}
    return json.dumps(head).encode() + b"\n" + body


# ------------------------------------------------------------ channels

def _connection(conf: dict) -> tuple:
    """What a running channel was spawned with. When it changes (an edited
    bridge.conf, the key appearing), the channel is respawned."""
    return (conf["host"], conf["key"], conf["python"], conf["remote_bin"],
            os.access(conf["key"], os.R_OK))


def ssh_command(conf: dict) -> list[str]:
    validate_conf(conf)
    if os.access(conf["key"], os.R_OK):
        # The dedicated key is enrolled with command="blip-dispatch", so the
        # remote command is bare and dispatch execs the tool. Its own
        # ControlMaster socket: sharing the general key's master would
        # silently bypass the forced command. IdentityAgent=none for the same
        # reason as blip-shim: an agent-held key outranks -i whatever the order.
        ssh = ["ssh", "-i", conf["key"], "-o", "IdentitiesOnly=yes",
               "-o", "IdentityAgent=none", "-o", "ControlMaster=auto",
               "-o", f"ControlPath={os.path.expanduser('~')}/.ssh/cm-blip-%r@%h:%p",
               "-o", "ControlPersist=10m"]
        remote = "imsg serve"
    else:
        ssh = ["ssh"]
        remote = (f"PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "
                  f"{conf['python']} {conf['remote_bin']}/imsg serve")
    # ServerAlive: a link that dies while the channel sits idle is noticed by
    # ssh itself, not by the next request's deadline.
    return ssh + ["-o", f"ConnectTimeout={CONNECT_TIMEOUT}", "-o", "BatchMode=yes",
                  "-o", "ServerAliveInterval=10", "-o", "ServerAliveCountMax=2",
                  "--", conf["host"], remote]


class Channel:
    """One `imsg serve` process behind one ssh session. Used by one request at
    a time (the Pool hands it out); every wait on it has a deadline."""

    def __init__(self, popen=subprocess.Popen, spawn_timeout: float = SPAWN_TIMEOUT) -> None:
        self.popen = popen
        self.spawn_timeout = spawn_timeout
        self.proc = None
        self.spawned_with: tuple | None = None
        self.buf = bytearray()

    # -- deadline-bounded pipe I/O
    def _wait(self, fd: int, writing: bool, deadline: float) -> None:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise ChannelTimeout("deadline passed waiting on the Mac")
        poller = select.poll()
        poller.register(fd, select.POLLOUT if writing else select.POLLIN)
        if not poller.poll(max(1, int(remaining * 1000))):
            raise ChannelTimeout("deadline passed waiting on the Mac")

    def _write_all(self, data: bytes, deadline: float) -> None:
        fd = self.proc.stdin.fileno()
        view = memoryview(data)
        while view:
            self._wait(fd, True, deadline)
            try:
                n = os.write(fd, view)
            except BlockingIOError:
                continue
            view = view[n:]

    def _fill(self, deadline: float) -> None:
        fd = self.proc.stdout.fileno()
        self._wait(fd, False, deadline)
        try:
            chunk = os.read(fd, 1 << 16)
        except BlockingIOError:
            return
        if not chunk:
            raise ChannelError("serve channel closed")
        self.buf += chunk

    def _read_line(self, deadline: float, limit: int = 1 << 16) -> bytes:
        while True:
            i = self.buf.find(b"\n")
            if i >= 0:
                line = bytes(self.buf[:i + 1])
                del self.buf[:i + 1]
                return line
            if len(self.buf) > limit:
                raise ChannelError("no line break from serve channel")
            self._fill(deadline)

    def _read_exact(self, n: int, deadline: float) -> bytes:
        while len(self.buf) < n:
            self._fill(deadline)
        out = bytes(self.buf[:n])
        del self.buf[:n]
        return out

    # -- lifecycle
    def _spawn(self, conf: dict, deadline: float) -> None:
        self.proc = self.popen(
            ssh_command(conf), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, bufsize=0)
        self.spawned_with = _connection(conf)
        self.buf.clear()
        os.set_blocking(self.proc.stdin.fileno(), False)
        os.set_blocking(self.proc.stdout.fileno(), False)
        line = self._read_line(min(deadline, time.monotonic() + self.spawn_timeout))
        if line.strip() != b"ready":
            raise ChannelError("serve channel did not come up")

    def kill(self) -> None:
        """Kill AND reap the ssh child, so a stalled channel leaves nothing
        behind but a free slot."""
        proc, self.proc = self.proc, None
        self.spawned_with = None
        self.buf.clear()
        if proc is None:
            return
        try:
            proc.kill()
        except OSError:
            pass
        try:
            proc.wait(timeout=2)
        except Exception:
            pass
        for f in (proc.stdin, proc.stdout):
            try:
                if f is not None:
                    f.close()
            except OSError:
                pass

    def request(self, payload: bytes, conf: dict, deadline: float) -> bytes:
        """Send one request line, return the framed reply (header + body).

        Any fault kills the channel rather than leaving it half-consumed: a
        desynchronised channel would hand the NEXT caller someone else's
        bytes, which is far worse than a client falling back to one-shot.
        """
        try:
            if self.proc is not None and (self.proc.poll() is not None
                                          or self.spawned_with != _connection(conf)):
                self.kill()
            if self.proc is None:
                self._spawn(conf, deadline)
            self._write_all(payload, deadline)
            header = self._read_line(deadline)
            meta = json.loads(header)
            want = int(meta["len"])
            if not 0 <= want <= MAX_BODY:
                raise ChannelError("implausible reply length")
            return header + self._read_exact(want, deadline)
        except ChannelError:
            self.kill()
            raise
        except Exception as e:
            self.kill()
            raise ChannelError(f"serve channel failed: {e}") from e
        except BaseException:
            self.kill()
            raise


class Pool:
    def __init__(self, size: int = POOL_SIZE, max_queued: int = MAX_QUEUED,
                 channel=Channel) -> None:
        self.channels = [channel() for _ in range(size)]
        self.free = list(self.channels)
        self.cond = threading.Condition()
        self.max_queued = max_queued
        self.waiting = 0

    def request(self, payload: bytes, conf: dict, deadline: float) -> bytes:
        with self.cond:
            if not self.free:
                if self.waiting >= self.max_queued:
                    raise Busy("every channel is busy")
                self.waiting += 1
                try:
                    while not self.free:
                        remaining = deadline - time.monotonic()
                        if remaining <= 0:
                            raise ChannelTimeout("no channel came free")
                        self.cond.wait(remaining)
                finally:
                    self.waiting -= 1
            ch = self.free.pop()
        try:
            return ch.request(payload, conf, deadline)
        finally:
            with self.cond:
                self.free.append(ch)
                self.cond.notify()

    def shutdown(self) -> None:
        for ch in self.channels:
            ch.kill()


# ------------------------------------------------------------ the socket

def _recv_line(conn: socket.socket) -> bytes | None:
    buf = b""
    while b"\n" not in buf:
        chunk = conn.recv(65536)
        if not chunk:
            return None
        buf += chunk
        if len(buf) > MAX_REQUEST:
            return None
    return buf.split(b"\n", 1)[0]


def answer(line: bytes, pool: Pool, conf_source=None,
           timeout: float = REQUEST_TIMEOUT) -> bytes:
    """One request line in, one frame out. Never raises: anything that keeps
    the daemon from answering becomes a fallback frame."""
    deadline = time.monotonic() + timeout
    try:
        # Read per request, as the shim reads it per call: a filter switched
        # on in bridge.conf applies to the very next query on either path.
        conf = (conf_source or read_conf)()
        if not conf["host"]:
            raise ConfError("no Mac configured")
        return pool.request(build_request(line, conf), conf, deadline)
    except (ConfError, ChannelError, Busy, ValueError, OSError) as e:
        return fallback_frame(str(e) or type(e).__name__)
    except Exception as e:         # never let one request take the daemon's reply away
        return fallback_frame(f"unexpected {type(e).__name__}")


def serve_client(conn: socket.socket, pool: Pool, uid: int, admitted=None) -> None:
    try:
        if peer_uid(conn) != uid:
            return              # not ours: no request read, no reply sent
        conn.settimeout(CLIENT_IO_TIMEOUT)
        line = _recv_line(conn)
        if line is None:
            return
        reply = answer(line, pool)
        conn.settimeout(REPLY_IO_TIMEOUT)
        conn.sendall(reply)
    except Exception:
        # Say nothing and close: a client that gets no usable frame falls back
        # to the one-shot path, which is the whole safety story here.
        pass
    finally:
        try:
            conn.close()
        except OSError:
            pass
        if admitted is not None:
            admitted.release()


def turn_away(conn: socket.socket, uid: int) -> None:
    """Over the thread cap: one fallback frame, then close, inline."""
    try:
        if peer_uid(conn) != uid:
            return
        conn.settimeout(1)
        conn.sendall(fallback_frame("every channel is busy"))
    except OSError:
        pass
    finally:
        try:
            conn.close()
        except OSError:
            pass


def _claim_socket(path: str, uid: int) -> bool:
    """False when a live daemon already serves `path`. A stale socket of ours
    is removed; anything that is not our socket is refused."""
    try:
        check_private_socket(path, uid)
    except FileNotFoundError:
        return True
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    probe.settimeout(1)
    try:
        probe.connect(path)
        return False                        # somebody is already serving
    except OSError as e:
        if e.errno != errno.ECONNREFUSED:
            return False
    finally:
        probe.close()
    os.unlink(path)
    return True


def main() -> None:
    uid = os.getuid()
    try:
        conf = read_conf()
    except ConfError as e:
        print(e, file=sys.stderr)
        sys.exit(EX_CONFIG)
    if not conf["host"]:
        print("blip-bridged: no Mac configured (host= in bridge.conf)", file=sys.stderr)
        sys.exit(EX_CONFIG)

    try:
        path = socket_path(uid=uid)
        if not _claim_socket(path, uid):
            return
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        old = os.umask(0o077)
        try:
            srv.bind(path)
        finally:
            os.umask(old)
        os.chmod(path, 0o600)
        check_private_socket(path, uid)
        srv.listen(16)
    except (OSError, UntrustedRuntime) as e:
        print(f"blip-bridged: not starting — {e}", file=sys.stderr)
        sys.exit(1)

    # The bar widget stops us with SIGTERM on a shell restart: unwind through
    # the finally below so the ssh children die with us instead of lingering.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    pool = Pool()
    admitted = threading.BoundedSemaphore(POOL_SIZE + MAX_QUEUED)
    last_seen = time.time()
    srv.settimeout(30)
    try:
        while True:
            try:
                conn, _ = srv.accept()
            except socket.timeout:
                if time.time() - last_seen > IDLE_EXIT_SECONDS:
                    break               # nothing wants us; the bar widget restarts us
                continue
            last_seen = time.time()
            if not admitted.acquire(blocking=False):
                turn_away(conn, uid)
                continue
            threading.Thread(target=serve_client, args=(conn, pool, uid, admitted),
                             daemon=True).start()
    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        pool.shutdown()
        try:
            os.unlink(path)
        except OSError:
            pass


if __name__ == "__main__":
    main()
