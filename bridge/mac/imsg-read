#!/usr/bin/env python3
"""imsg-read — tell Messages.app that a conversation has been read.

Blip's README said this was impossible. It said so on the strength of one
experiment: `open imessage://<handle>` does not flip `is_read`. That much is
true and still is — selecting a conversation from a URL leaves it unread. But
Messages has carried a **Conversation ▸ Mark All as Read** menu item since
Ventura, and a menu item is scriptable. Verified end to end on macOS 26.6:

    is_read 1 → "Mark as Unread" → 0 → "Mark All as Read" → 1

No SIP changes, no private API, no writing to chat.db behind Messages' back —
which matters, because a direct sqlite UPDATE would not reach the iPhone.
Going through Messages means the change syncs the way any read does.

    imsg-read --all              mark every conversation read
    imsg-read --chat <id>        mark ONE conversation read (DM or group)
    imsg-read --unread <handle>  mark ONE conversation unread (DMs only)
    imsg-read --pin <handle>     pin a DM
    imsg-read --unpin <handle>   unpin a DM
    imsg-read --mute <handle>    Hide Alerts
    imsg-read --unmute <handle>  Show Alerts
    imsg-read --status           report whether this Mac can do it at all

--all leaves the Mac alone: no window is raised, no selection changes, and
whatever app was frontmost stays frontmost (verified). --chat cannot: the only
way to aim the menu at one conversation is to open it, and opening it brings
Messages to the front. That is why Blip's default only pushes the explicit
mark-all-read gesture.

Exit 0 only after the database confirms the requested state. A disabled menu
alone is not success. --chat accepts --through <UTC stamp> to reject a stale
read when a newer inbound has arrived.

Needs Accessibility for whatever runs it. Over Blip's ssh key that is
/usr/libexec/sshd-keygen-wrapper, the same binary that already needs Full Disk
Access; `blip-check` reports it. Without the grant this exits 77 and says so,
rather than failing silently.
"""
import os
import fcntl
import plistlib
import re
import sqlite3
import subprocess
import sys
import time
import importlib.machinery
import importlib.util
import stat
from typing import Optional
from contextlib import contextmanager
from urllib.parse import urlencode

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from read_state import read_state

MENU = 'menu 1 of menu bar item "Conversation" of menu bar 1'
TIMEOUT = 150   # the first System Events call can be a consent prompt; give it the ~2 minutes macOS gives it (Astra C#8)


@contextmanager
def messages_ui_lock():
    """Serialize selection and menu clicks across simultaneous Blip reads.

    The owner-only lock contains no data. A second read must never change the
    selected conversation between the first read's URL and its menu click.
    """
    folder = os.path.expanduser("~/.blip")
    os.makedirs(folder, mode=0o700, exist_ok=True)
    parent = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    fd = None
    try:
        info = os.fstat(parent)
        if info.st_uid != os.getuid() or info.st_mode & 0o022:
            raise PermissionError("unsafe bridge directory")
        fd = os.open("messages-ui.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK,
                     0o600, dir_fd=parent)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise PermissionError("unsafe Messages lock")
        deadline = time.monotonic() + TIMEOUT
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise TimeoutError("Messages is busy with another Blip action")
                time.sleep(0.1)
        yield
    finally:
        if fd is not None:
            os.close(fd)
        os.close(parent)


def osa(script: str) -> tuple[int, str]:
    try:
        r = subprocess.run(["osascript", "-e", script], capture_output=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return 124, "osascript timed out"
    return r.returncode, (r.stdout or r.stderr).decode("utf-8", "replace").strip()


DB_PATH = os.path.expanduser("~/Library/Messages/chat.db")

IMSG = os.path.join(os.path.dirname(os.path.abspath(__file__)), "imsg")
_IMSG_MODULE = None


def imsg_module():
    """The vendored imsg beside us, loaded once. It owns conversation
    clustering; we ask it rather than keeping a second copy of the rules that
    would drift from the bridge's own."""
    global _IMSG_MODULE
    if _IMSG_MODULE is None:
        loader = importlib.machinery.SourceFileLoader("blip_imsg_for_read", IMSG)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        _IMSG_MODULE = module
    return _IMSG_MODULE


def cluster_ids(con, handle):
    """Every chat_identifier that IS this conversation, the argument included.

    Messages keeps a re-keyed group's retired chat rows, and merges a 1:1's
    phone row with its email row while both keep their own chat_identifier.
    Counting only the identifier Blip pushed says "nothing unread" whenever
    the unread landed on an alias, and --chat then exits 0 without pushing
    anything. Falls back to the identifier alone, which is no worse than not
    asking, when the cluster cannot be resolved."""
    try:
        ids = [c for c in imsg_module().chat_cluster_ids(con, handle) if c]
    except Exception:
        return [handle]
    return ids or [handle]


def unread_on_mac(handle=None):
    """Conversations read_state still counts as unread, or None when chat.db
    cannot be read. That snapshot follows is_read, so a manual unread below
    Apple's read cursor still counts, and so does an unread reaction.

    A handle is scoped to its whole conversation cluster, never to one chat
    row: the count is the referee for the push."""
    try:
        con = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True, timeout=5)
        # imsg's cluster queries read their columns by name.
        con.row_factory = sqlite3.Row
        try:
            rows = read_state(con)
            if not handle:
                return sum(1 for row in rows if row["unread"] > 0)
            ids = set(cluster_ids(con, handle))
            return sum(1 for row in rows if row["unread"] > 0 and (
                row["chat"] in ids or handle in (row["aliases"] or [])
                or any(alias in ids for alias in row["aliases"] or [])))
        finally:
            con.close()
    except Exception:
        return None


def newer_than_seen(handle, seen):
    """Recheck on the Mac immediately before selecting a chat for a read."""
    from datetime import datetime, timezone
    try:
        boundary = int(datetime.fromisoformat(seen.replace("Z", "+00:00")).timestamp() - 978307200) * 1000000000
        # Wire stamps have second precision; include the whole visible second.
        with sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True, timeout=5) as con:
            return any(row["latest"] >= boundary + 1000000000 for row in read_state(con)
                       if row["chat"] == handle or handle in row["aliases"])
    except Exception:
        return True  # cannot safely apply a stale read


def settle(before, handle=None, tries=8, pause=0.4):
    """Wait up to ~3 s for the requested scope to become fully read.

    A decreasing count is progress, not completion. Transient database errors
    can recover within this same bounded wait.
    """
    after = before
    for _ in range(tries):
        time.sleep(pause)
        after = unread_on_mac(handle)
        if after == 0:
            return after
    return after


def settle_unread(handle=None, tries=8, pause=0.4):
    """Wait until Messages counts this chat (or any chat) as unread."""
    after = unread_on_mac(handle)
    for _ in range(tries):
        if after is None or after > 0:
            return after
        time.sleep(pause)
        after = unread_on_mac(handle)
    return after


def report_unread(before, after, ok):
    """Exit 0 when the chat is unread on the Mac, including already-unread."""
    if before is None or after is None:
        sys.stderr.write("imsg-read: cannot verify read state in chat.db\n")
        sys.exit(75)
    if after > (before or 0):
        print(f"marked ({before} -> {after} unread)")
        return
    if after > 0:
        print("already unread")
        return
    why = ("Mark as Unread stayed disabled even after waking Messages, so the click could not land"
           if not ok else "Mark as Unread was clicked but the chat is still read")
    sys.stderr.write(f"imsg-read: {why}\n")
    sys.exit(75)


def report(before, after, ok, what):
    """Acknowledge only a verified zero unread count in the requested scope.

    A disabled menu can mean AppKit has not validated Messages' menus. A
    successful click can precede database writes. Neither proves completion;
    unavailable verification or a partially cleared count must remain failures.
    """
    if after is None or (before is None and after != 0):
        sys.stderr.write("imsg-read: cannot verify read state in chat.db\n")
        sys.exit(75)
    if after == 0:
        print("nothing unread" if before == 0 else "marked (0 unread)")
        return
    why = (f"{before} unread on the Mac but {what} stayed disabled even after waking "
           "Messages, so the click could not land"
           if not ok else f"{what} was clicked but {after} still unread")
    sys.stderr.write(f"imsg-read: {why}\n")
    sys.exit(75)   # EX_TEMPFAIL: the local marks moved, the Mac's did not


def messages_running() -> bool:
    code, out = osa('tell application "System Events" to (name of processes) contains "Messages"')
    return code == 0 and out == "true"


def ensure_messages() -> str:
    """Start Messages if needed, WITHOUT bringing it forward (-g) or opening a
    window (-j). Returns "" on success, else a reason."""
    if messages_running():
        return ""
    try:
        subprocess.run(["open", "-g", "-j", "-a", "Messages"], capture_output=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return "could not start Messages"
    for _ in range(20):
        if messages_running():
            return ""
        subprocess.run(["sleep", "0.5"], capture_output=True)
    return "Messages did not start"


SCREEN_LOCKED = ("the Mac's screen is locked, so System Events can reach no window; unlock it, or set "
                 "System Settings ▸ Lock Screen ▸ Start Screen Saver when inactive to Never "
                 "(README, Keeping the Mac awake)")


def screen_locked() -> bool:
    """True while the console session sits behind the lock screen.

    A locked screen hides every app's windows from System Events, so a
    windowless Messages is far more often a locked Mac than a quit one: the
    default screen saver (20 min) plus "require password after 5 minutes"
    locks a gateway Mac 25 minutes after its owner last touched it, with
    Messages open and healthy behind the lock. ioreg needs no TCC grant, and
    the key exists only while locked."""
    try:
        r = subprocess.run(["ioreg", "-n", "Root", "-d1", "-a"], capture_output=True, timeout=10)
        root = plistlib.loads(r.stdout) if r.returncode == 0 and r.stdout else {}
    except Exception:
        return False
    users = root.get("IOConsoleUsers") if isinstance(root, dict) else None
    return any(isinstance(u, dict) and bool(u.get("CGSSessionScreenIsLocked")) for u in users or [])


def accessibility() -> str:
    """"" when System Events can drive Messages, else why not."""
    code, out = osa(f'tell application "System Events" to tell process "Messages" to name of {MENU}')
    if code == 0:
        return ""
    if "not allowed assistive" in out or "1002" in out or "osascript is not allowed" in out:
        return ("Accessibility is not granted. System Settings ▸ Privacy & Security ▸ "
                "Accessibility → add /usr/libexec/sshd-keygen-wrapper (the same entry "
                "that has Full Disk Access).")
    if screen_locked():
        return SCREEN_LOCKED
    return out or "System Events could not reach Messages"


def click(item: str) -> tuple[bool, str]:
    """Click one Conversation-menu item. Returns (did_something, error).

    Two ways of saying "there is nothing to do", both success:
      * the item is present but DISABLED — nothing is unread;
      * the item is ABSENT (-1728) — the per-conversation entry is named for
        what it would do, so a chat that is already read offers only
        "Mark as Unread" and the lookup for "Mark as Read" fails.
    """
    code, out = osa(
        f'tell application "System Events" to tell process "Messages" to '
        f'enabled of menu item "{item}" of {MENU}'
    )
    if code != 0:
        return (False, "") if "-1728" in out else (False, out)
    if out != "true":
        return False, ""
    code, out = osa(
        f'tell application "System Events" to tell process "Messages" to '
        f'click menu item "{item}" of {MENU}'
    )
    return (code == 0), ("" if code == 0 else out)


GROUP_ID = re.compile(r"chat[0-9]{1,40}|[a-fA-F0-9]{32}")


def open_db():
    con = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True, timeout=5)
    # imsg's cluster queries read their columns by name.
    con.row_factory = sqlite3.Row
    return con


def chat_muted(handle: str) -> Optional[bool]:
    """Whether Hide Alerts is on for this conversation; None when unknown.

    Scoped to the conversation cluster the way `imsg chats` reports it: muted
    when ANY of its rows carries the flag, unmuted only when every row was
    read and none does. A missing conversation or a properties blob that is
    not a plist dictionary is unknown, never "alerts on" - otherwise a
    failed Show Alerts could be acknowledged as done."""
    try:
        con = open_db()
        try:
            mod = imsg_module()
            if "properties" not in {row[1] for row in con.execute("PRAGMA table_info(chat)")}:
                return None
            ids = sorted(set(mod.chat_cluster_ids(con, handle)) | {handle})
            rows = con.execute(
                f"SELECT properties FROM chat WHERE chat_identifier IN ({','.join('?' * len(ids))})",
                ids).fetchall()
        finally:
            con.close()
    except Exception:
        return None
    if not rows:
        return None
    flags = [mod.alerts_flag(row["properties"]) for row in rows]
    dnd = dnd_list_now(mod)
    if True in flags or (dnd is not None and dnd & set(ids)):
        return True
    return None if None in flags or dnd is None else False


def dnd_list_now(mod) -> Optional[set]:
    """macOS 27's Hide Alerts list (imsg.dnd_ids), asked of cfprefsd.

    The plist file trails the change by a few seconds, longer than
    settle_flag waits, so a verified Show Alerts could read the old file and
    fail. `defaults export` answers from cfprefsd, and a domain that was never
    written exports as an empty dictionary: nobody muted, not unknown."""
    try:
        r = subprocess.run(["defaults", "export", "com.apple.MobileSMS.CKDNDList", "-"],
                           capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    try:
        return mod.dnd_ids(plistlib.loads(r.stdout))
    except (plistlib.InvalidFileException, ValueError, TypeError):
        return None


def pin_list():
    """Messages' ordered pins (one alias set each), or None when no copy of
    the pin list can be read in the layout `imsg` understands.

    Same precedence as `imsg`'s reader: the first file with pins wins. An
    empty list means "read, and nothing is pinned", which is what a verified
    Unpin of the last pin looks like. `imsg` falls back to flattening every
    string of an unknown layout; a verification cannot, because a stale
    alias anywhere in the file would then pass for a pin."""
    mod = imsg_module()
    found = None
    for path in mod.PINNING_PLIST_PATHS:
        try:
            with open(path, "rb") as fh:
                data = plistlib.load(fh)
        except (OSError, plistlib.InvalidFileException, ValueError, TypeError):
            continue
        pins = mod.ordered_pins(data)
        if pins:
            return pins
        if pins is not None:
            found = []
    return found


def chat_pinned(handle: str) -> Optional[bool]:
    """Whether Messages lists this conversation as pinned; None when unknown.

    Matches the way `imsg chats` finds a pin: every identifier in the
    conversation cluster (a merged DM is pinned by whichever handle was
    tapped), guids and group ids included, against the ordered pin list."""
    pins = pin_list()
    if pins is None:
        return None
    try:
        con = open_db()
        try:
            mod = imsg_module()
            clusters = mod._group_cluster_map(con)
            canon = clusters.get(handle, handle)
            candidates = {handle, canon} | {c for c, k in clusters.items() if k == canon}
            candidates.update(mod._cluster_pin_candidates(con, clusters).get(canon, ()))
            pins = mod.expand_pins_via_lookup(con, pins)
        finally:
            con.close()
    except Exception:
        return None
    return mod.pin_order_for(pins, *sorted(candidates)) is not None


def settle_flag(fn, want: bool, tries: int = 8, pause: float = 0.4) -> Optional[bool]:
    """Wait up to ~3 s for fn() to report `want`. A transient unknown keeps
    waiting; the last reading is returned, so None at the end is unknown."""
    got = fn()
    for _ in range(tries):
        if got is want:
            return got
        time.sleep(pause)
        got = fn()
    return got


def keep_unread(handle: str, before) -> str:
    """Put back an unread that opening the conversation just read.

    Selecting a DM shows it, and Messages reads what it shows. A pin or a
    mute is not a read, so the dot the user left there goes back on with the
    same menu item --unread uses. "" when nothing was lost (or nothing was
    unread to begin with), else why it could not be put back. A read receipt
    Messages already sent cannot be recalled."""
    if before is None:
        return "could not tell beforehand whether it was unread"
    if before == 0:
        return ""
    now = unread_on_mac(handle)
    if now is None:
        return "could not check whether opening it read it"
    if now > 0:
        return ""
    ok, err = click("Mark as Unread")
    if not ok and not err:
        wake_messages()
        ok, err = click("Mark as Unread")
    if err:
        return err
    after = settle_unread(handle)
    if after and after > 0:
        return ""
    return "Mark as Unread did not land" if ok else "Mark as Unread was not available"


ACTIONS = {
    "--pin": ("Pin", "chat_pinned", True, "pinned"),
    "--unpin": ("Unpin", "chat_pinned", False, "unpinned"),
    "--mute": ("Hide Alerts", "chat_muted", True, "muted"),
    "--unmute": ("Show Alerts", "chat_muted", False, "unmuted"),
}
# macOS 27 has no Show Alerts: one Hide Alerts item toggles, its state shown
# only while Messages is in front ("Hide Alerts, On" on the sidebar row).
# Clicked only after chat_muted said the alerts are off, so it turns them on.
TOGGLES = {"--unmute": "Hide Alerts"}
# A toggle clicked in the wrong state does the opposite, so these check first.
CHECK_FIRST = ("--mute", "--unmute")


def conversation_action(flag: str, handle: str) -> None:
    """Select a DM, click one Conversation-menu item, verify it in Messages'
    own records, and hand focus back to whatever the user had in front.

    The front app is captured BEFORE the conversation is opened: `open
    imessage:` alone can bring Messages forward, and capturing after it
    restored Messages to itself. Verification is tri-state and fails closed:
    unknown (an unreadable pin list, a missing chat, a malformed plist) is
    not success for the "on" actions or the "off" ones."""
    item, probe_name, want, word = ACTIONS[flag]
    probe = globals()[probe_name]
    if GROUP_ID.fullmatch(handle):
        sys.stderr.write(f"imsg-read: {flag} is for direct messages; this is a group\n")
        sys.exit(64)
    if flag in CHECK_FIRST:
        now = probe(handle)
        if now is want:
            print(word)
            return
        if now is None:
            sys.stderr.write(f"imsg-read: Messages' records cannot say whether the conversation "
                             f"is muted, so {item} was not clicked\n")
            sys.exit(75)
    before = unread_on_mac(handle)
    prev = frontmost()
    selected = False
    try:
        why = select_chat(handle)
        if why:
            sys.stderr.write(f"imsg-read: {why}\n")
            sys.exit(64)
        selected = True
        ok, err = click(item)
        # A disabled menu is dormant while Messages is in the background.
        if not ok and not err:
            wake_messages()
            ok, err = click(item)
        if not ok and not err and flag in TOGGLES:
            ok, err = click(TOGGLES[flag])
        if err:
            sys.stderr.write(f"imsg-read: {err}\n")
            sys.exit(1)
        if not ok:
            sys.stderr.write(f"imsg-read: {item!r} was not available\n")
            sys.exit(1)
        got = settle_flag(lambda: probe(handle), want)
    finally:
        # Even a failed click opened the conversation; put its unread back
        # while it is still the selected one, then hand focus back.
        lost = keep_unread(handle, before) if selected else ""
        if lost:
            sys.stderr.write(f"imsg-read: its unread state on the Mac may not have survived "
                             f"opening it ({lost})\n")
        restore_front(prev)
    if got is None:
        sys.stderr.write(f"imsg-read: {item} was clicked but Messages' records cannot "
                         f"confirm the conversation is {word}\n")
        sys.exit(75)
    if got is not want:
        sys.stderr.write(f"imsg-read: {item} was clicked but the conversation is not {word}\n")
        sys.exit(75)
    print(word)


def frontmost() -> str:
    code, out = osa('tell application "System Events" to name of first application process whose frontmost is true')
    return out if code == 0 else ""


def wake_messages() -> str:
    """Make Messages the active app for a beat so AppKit validates its menus,
    and return the app that was in front so the caller can hand focus back.

    Measured 2026-09-04 (macOS 26.6): with a real unread and Messages in the
    background, EVERY Conversation item read disabled, even with the menu
    forced open; 0.7 s of activation flipped Mark All as Read to enabled, and
    it stayed enabled after the previous app was restored. The blip is under a
    second and happens only on this path — a menu that already validates is
    clicked without it."""
    prev = frontmost()
    osa('tell application "Messages" to activate')
    time.sleep(0.7)
    return prev


def restore_front(prev: str) -> None:
    if prev and prev != "Messages":
        name = prev.replace("\\", "\\\\").replace('"', '\\"')
        osa(f'tell application "System Events" to set frontmost of process "{name}" to true')


def chat_url(handle: str) -> str:
    """Address a group by its opaque identifier, never its name or speaker.

    Messages uses the same deep links as its own conversation shortcuts.
    Keep URL delimiters inside the value: an email must not inject a body.
    """
    if not isinstance(handle, str) or len(handle) > 254:
        raise ValueError("invalid conversation identifier")
    if re.fullmatch(r"chat[0-9]{1,40}|[a-fA-F0-9]{32}", handle):
        key = "groupid"
    elif re.fullmatch(r"\+?[0-9]{3,15}|[^@\s\x00-\x1f\x7f]+@[^@\s\x00-\x1f\x7f]+", handle):
        key = "address"
    else:
        raise ValueError("invalid conversation identifier")
    return "imessage:open?" + urlencode({key: handle})


def select_chat(handle: str) -> str:
    """Select the exact DM or group through Messages' address/groupid URL."""
    try:
        url = chat_url(handle)
    except ValueError as exc:
        return str(exc)
    try:
        r = subprocess.run(["open", url], capture_output=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return "opening the conversation timed out"
    if r.returncode != 0:
        # Selection did not move: clicking now would mark whatever Messages
        # had selected, some OTHER conversation (Astra C#4).
        return f"could not open the conversation (open exited {r.returncode})"
    subprocess.run(["sleep", "1.5"], capture_output=True)
    code, out = osa('tell application "System Events" to tell process "Messages" to count windows')
    if code != 0 or not out.isdecimal() or int(out) < 1:
        # Zero windows with Messages running is what a locked screen looks
        # like; say so, or the owner is sent to a Messages that is open and fine.
        if screen_locked():
            return SCREEN_LOCKED
        return "Messages has no accessible window; log in and open Messages on the Mac"
    return ""


def main() -> None:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)

    if argv[0] == "--status":
        why = ensure_messages() or accessibility()
        if why:
            print(f"unavailable: {why}")
            sys.exit(77)
        n = unread_on_mac()
        code, out = osa(f'tell application "System Events" to tell process "Messages" to '
                        f'enabled of menu item "Mark All as Read" of {MENU}')
        menu = "enabled" if (code == 0 and out == "true") else "disabled"
        if n is None:
            print("ready (chat.db not readable here, so a push cannot be verified)")
        elif n and menu == "disabled":
            print(f"ready but dormant: {n} unread on the Mac and Mark All as Read is disabled "
                  "(Messages validates its menu only while it is the active app) - "
                  "a push right now would do nothing")
        else:
            print(f"ready ({n} unread on the Mac, menu {menu})")
        sys.exit(0)

    why = ensure_messages()
    if why:
        sys.stderr.write(f"imsg-read: {why}\n")
        sys.exit(69)
    why = accessibility()
    if why:
        sys.stderr.write(f"imsg-read: {why}\n")
        sys.exit(77)

    if argv[0] == "--all":
        before = unread_on_mac()
        if before == 0:
            print("nothing unread")
            return
        ok, err = click("Mark All as Read")
        if not ok and not err and before:
            # Disabled, yet chat.db says unread: the menu is dormant, not empty.
            prev = wake_messages()
            ok, err = click("Mark All as Read")
            restore_front(prev)
        if err:
            sys.stderr.write(f"imsg-read: {err}\n")
            sys.exit(1)
        report(before, settle(before) if ok else before, ok, "Mark All as Read")
        return

    if argv[0] in ("--chat", "--unread"):
        if len(argv) < 2:
            sys.stderr.write("imsg-read: action needs a handle\n")
            sys.exit(64)
        handle = argv[1]
        want_unread = argv[0] == "--unread"
        before = unread_on_mac(handle)
        # Idempotency avoids opening an already-unread chat (which reads it)
        # and prevents polling from repeatedly stealing focus.
        if before is not None and ((before > 0) == want_unread):
            print("already unread" if want_unread else "nothing unread")
            return
        if not want_unread and "--through" in argv:
            i = argv.index("--through")
            if i + 1 >= len(argv) or newer_than_seen(handle, argv[i + 1]):
                sys.stderr.write("imsg-read: newer inbound arrived; leaving it unread\n")
                sys.exit(75)
        prev = frontmost()
        try:
            why = select_chat(handle)
            if why:
                sys.stderr.write(f"imsg-read: {why}\n")
                sys.exit(64)
            item = "Mark as Unread" if want_unread else "Mark as Read"
            ok, err = click(item)
            # A disabled menu is dormant while Messages is in the background.
            # Wake it and click once more; a real error still fails immediately.
            if not ok and not err:
                wake_messages()
                ok, err = click(item)
            if err:
                sys.stderr.write(f"imsg-read: {err}\n")
                sys.exit(1)
            # Opening can itself read the chat. Always check the database,
            # even when the menu was absent, disabled, or the count unknown.
            after = settle_unread(handle) if want_unread else settle(before, handle)
            if want_unread:
                report_unread(before, after, ok)
            else:
                report(before, after, ok, item)
        finally:
            restore_front(prev)
        return

    if argv[0] in ACTIONS:
        if len(argv) < 2:
            sys.stderr.write(f"imsg-read: {argv[0]} needs a handle\n")
            sys.exit(64)
        conversation_action(argv[0], argv[1])
        return

    sys.stderr.write(f"imsg-read: unknown option {argv[0]!r}\n")
    sys.exit(64)


if __name__ == "__main__":
    try:
        with messages_ui_lock():
            main()
    except (OSError, TimeoutError) as exc:
        sys.stderr.write(f"imsg-read: {exc}\n")
        sys.exit(75)
