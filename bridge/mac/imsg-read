#!/usr/bin/env python3
"""imsg-read — tell Messages.app that a conversation has been read.

Blip's README said this was impossible. It said so on the strength of one
experiment: `open imessage://<handle>` does not flip `is_read`. That much is
true and still is — selecting a conversation from a URL leaves it unread. But
Messages has carried a **Conversation ▸ Mark All as Read** menu item since
Ventura, and a menu item is scriptable. Verified end to end on macOS 26.6:

    is_read 1 → "Mark as Unread" → 0 → "Mark All as Read" → 1

No SIP changes, no private API, no writing to chat.db behind Messages' back —
which matters, because a direct sqlite UPDATE would not reach the iPhone.
Going through Messages means the change syncs the way any read does.

    imsg-read --all              mark every conversation read
    imsg-read --chat <id>        mark ONE conversation read (DM or group)
    imsg-read --status           report whether this Mac can do it at all

--all leaves the Mac alone: no window is raised, no selection changes, and
whatever app was frontmost stays frontmost (verified). --chat cannot: the only
way to aim the menu at one conversation is to open it, and opening it brings
Messages to the front. That is why Blip's default only pushes the explicit
mark-all-read gesture.

Exit 0 when there was nothing to do — the menu item is disabled when nothing
is unread, which is a free guard against pointless clicks.

Needs Accessibility for whatever runs it. Over Blip's ssh key that is
/usr/libexec/sshd-keygen-wrapper, the same binary that already needs Full Disk
Access; `blip-check` reports it. Without the grant this exits 77 and says so,
rather than failing silently.
"""
import os
import re
import sqlite3
import subprocess
import sys
import time
import fcntl
import importlib.machinery
import importlib.util
import stat
from contextlib import contextmanager
from urllib.parse import urlencode

MENU = 'menu 1 of menu bar item "Conversation" of menu bar 1'
TIMEOUT = 150   # the first System Events call can be a consent prompt; give it the ~2 minutes macOS gives it (Astra C#8)


@contextmanager
def messages_ui_lock():
    """Serialize selection and menu clicks across simultaneous Blip reads.

    The owner-only lock contains no data. A second read must never change the
    selected conversation between the first read's URL and its menu click.
    """
    folder = os.path.expanduser("~/.blip")
    os.makedirs(folder, mode=0o700, exist_ok=True)
    parent = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    fd = None
    try:
        info = os.fstat(parent)
        if info.st_uid != os.getuid() or info.st_mode & 0o022:
            raise PermissionError("unsafe bridge directory")
        fd = os.open("messages-ui.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK,
                     0o600, dir_fd=parent)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise PermissionError("unsafe Messages lock")
        deadline = time.monotonic() + TIMEOUT
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise TimeoutError("Messages is busy with another Blip action")
                time.sleep(0.1)
        yield
    finally:
        if fd is not None:
            os.close(fd)
        os.close(parent)


def osa(script: str) -> tuple[int, str]:
    try:
        r = subprocess.run(["osascript", "-e", script], capture_output=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return 124, "osascript timed out"
    return r.returncode, (r.stdout or r.stderr).decode("utf-8", "replace").strip()


DB_PATH = os.path.expanduser("~/Library/Messages/chat.db")

# What Messages ITSELF still counts as unread: an inbound, non-tapback,
# non-announcement row newer than its chat's own read cursor. That cursor
# (chat.last_read_message_timestamp) is what "Mark All as Read" advances and
# what the Dock badge follows; message.is_read alone carries ghosts.
UNREAD_SQL = """
SELECT count(DISTINCT c.ROWID)
  FROM message m
  JOIN chat_message_join j ON j.message_id = m.ROWID
  JOIN chat c ON c.ROWID = j.chat_id
 WHERE m.is_from_me = 0 AND m.is_read = 0 AND m.item_type = 0
   AND (m.associated_message_type IS NULL OR m.associated_message_type = 0)
   AND m.date > c.last_read_message_timestamp
"""


IMSG = os.path.join(os.path.dirname(os.path.abspath(__file__)), "imsg")
_IMSG_MODULE = None


def imsg_module():
    """The vendored imsg beside us, loaded once. It owns conversation
    clustering; we ask it rather than keeping a second copy of the rules that
    would drift from the bridge's own."""
    global _IMSG_MODULE
    if _IMSG_MODULE is None:
        loader = importlib.machinery.SourceFileLoader("blip_imsg_for_read", IMSG)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        _IMSG_MODULE = module
    return _IMSG_MODULE


def cluster_ids(con, handle):
    """Every chat_identifier that IS this conversation, the argument included.

    Messages keeps a re-keyed group's retired chat rows, and merges a 1:1's
    phone row with its email row while both keep their own chat_identifier.
    Counting only the identifier Blip pushed says "nothing unread" whenever
    the unread landed on an alias, and --chat then exits 0 without pushing
    anything. Falls back to the identifier alone, which is no worse than not
    asking, when the cluster cannot be resolved."""
    try:
        ids = [c for c in imsg_module().chat_cluster_ids(con, handle) if c]
    except Exception:
        return [handle]
    return ids or [handle]


def unread_on_mac(handle=None):
    """Conversations Messages still counts as unread (see UNREAD_SQL), or None
    when chat.db cannot be read — a guess would be worse than not knowing.

    A handle is scoped to its whole conversation cluster, never to one chat
    row: the count is the referee for the push, so it has to cover every row
    the push can clear."""
    try:
        con = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True, timeout=5)
        # imsg's cluster queries read their columns by name.
        con.row_factory = sqlite3.Row
        try:
            sql, args = UNREAD_SQL, ()
            if handle:
                ids = cluster_ids(con, handle)
                sql += f" AND c.chat_identifier IN ({', '.join('?' * len(ids))})"
                args = tuple(ids)
            return int(con.execute(sql, args).fetchone()[0])
        finally:
            con.close()
    except Exception:
        return None


def settle(before, handle=None, tries=8, pause=0.4):
    """Wait up to ~3 s for the requested scope to become fully read.

    A decreasing count is progress, not completion. Transient database errors
    can recover within this same bounded wait.
    """
    after = before
    for _ in range(tries):
        time.sleep(pause)
        after = unread_on_mac(handle)
        if after == 0:
            return after
    return after


def report(before, after, ok, what):
    """Acknowledge only a verified zero unread count in the requested scope.

    A disabled menu can mean AppKit has not validated Messages' menus. A
    successful click can precede database writes. Neither proves completion;
    unavailable verification or a partially cleared count must remain failures.
    """
    if after is None:
        sys.stderr.write("imsg-read: could not verify read state in chat.db\n")
        sys.exit(75)
    if after == 0:
        print("nothing unread" if before == 0 else "marked (0 unread)")
        return
    why = (f"{before} unread on the Mac but {what} stayed disabled even after waking "
           "Messages, so the click could not land"
           if not ok else f"{what} was clicked but {after} still unread")
    sys.stderr.write(f"imsg-read: {why}\n")
    sys.exit(75)   # EX_TEMPFAIL: the local marks moved, the Mac's did not


def messages_running() -> bool:
    code, out = osa('tell application "System Events" to (name of processes) contains "Messages"')
    return code == 0 and out == "true"


def ensure_messages() -> str:
    """Start Messages if needed, WITHOUT bringing it forward (-g) or opening a
    window (-j). Returns "" on success, else a reason."""
    if messages_running():
        return ""
    try:
        subprocess.run(["open", "-g", "-j", "-a", "Messages"], capture_output=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return "could not start Messages"
    for _ in range(20):
        if messages_running():
            return ""
        subprocess.run(["sleep", "0.5"], capture_output=True)
    return "Messages did not start"


def accessibility() -> str:
    """"" when System Events can drive Messages, else why not."""
    code, out = osa(f'tell application "System Events" to tell process "Messages" to name of {MENU}')
    if code == 0:
        return ""
    if "not allowed assistive" in out or "1002" in out or "osascript is not allowed" in out:
        return ("Accessibility is not granted. System Settings ▸ Privacy & Security ▸ "
                "Accessibility → add /usr/libexec/sshd-keygen-wrapper (the same entry "
                "that has Full Disk Access).")
    return out or "System Events could not reach Messages"


def click(item: str) -> tuple[bool, str]:
    """Click one Conversation-menu item. Returns (did_something, error).

    Two ways of saying "there is nothing to do", both success:
      * the item is present but DISABLED — nothing is unread;
      * the item is ABSENT (-1728) — the per-conversation entry is named for
        what it would do, so a chat that is already read offers only
        "Mark as Unread" and the lookup for "Mark as Read" fails.
    """
    code, out = osa(
        f'tell application "System Events" to tell process "Messages" to '
        f'enabled of menu item "{item}" of {MENU}'
    )
    if code != 0:
        return (False, "") if "-1728" in out else (False, out)
    if out != "true":
        return False, ""
    code, out = osa(
        f'tell application "System Events" to tell process "Messages" to '
        f'click menu item "{item}" of {MENU}'
    )
    return (code == 0), ("" if code == 0 else out)


def frontmost() -> str:
    code, out = osa('tell application "System Events" to name of first application process whose frontmost is true')
    return out if code == 0 else ""


def wake_messages() -> str:
    """Make Messages the active app for a beat so AppKit validates its menus,
    and return the app that was in front so the caller can hand focus back.

    Measured 2026-09-04 (macOS 26.6): with a real unread and Messages in the
    background, EVERY Conversation item read disabled, even with the menu
    forced open; 0.7 s of activation flipped Mark All as Read to enabled, and
    it stayed enabled after the previous app was restored. The blip is under a
    second and happens only on this path — a menu that already validates is
    clicked without it."""
    prev = frontmost()
    osa('tell application "Messages" to activate')
    time.sleep(0.7)
    return prev


def restore_front(prev: str) -> None:
    if prev and prev != "Messages":
        name = prev.replace("\\", "\\\\").replace('"', '\\"')
        osa(f'tell application "System Events" to set frontmost of process "{name}" to true')


def chat_url(handle: str) -> str:
    """Address a group by its opaque identifier, never its name or speaker.

    Messages uses the same deep links as its own conversation shortcuts.
    Keep URL delimiters inside the value: an email must not inject a body.
    """
    if not isinstance(handle, str) or len(handle) > 254:
        raise ValueError("invalid conversation identifier")
    if re.fullmatch(r"chat[0-9]{1,40}|[a-fA-F0-9]{32}", handle):
        key = "groupid"
    elif re.fullmatch(r"\+?[0-9]{3,15}|[^@\s\x00-\x1f\x7f]+@[^@\s\x00-\x1f\x7f]+", handle):
        key = "address"
    else:
        raise ValueError("invalid conversation identifier")
    return "imessage:open?" + urlencode({key: handle})


def select_chat(handle: str) -> str:
    """Select the exact DM or group through Messages' address/groupid URL."""
    try:
        url = chat_url(handle)
    except ValueError as exc:
        return str(exc)
    try:
        r = subprocess.run(["open", url], capture_output=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return "opening the conversation timed out"
    if r.returncode != 0:
        # Selection did not move: clicking now would mark whatever Messages
        # had selected, some OTHER conversation (Astra C#4).
        return f"could not open the conversation (open exited {r.returncode})"
    subprocess.run(["sleep", "1.5"], capture_output=True)
    code, out = osa('tell application "System Events" to tell process "Messages" to count windows')
    if code != 0 or not out.isdecimal() or int(out) < 1:
        return "Messages has no accessible window; log in and open Messages on the Mac"
    return ""


def main() -> None:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)

    if argv[0] == "--status":
        why = ensure_messages() or accessibility()
        if why:
            print(f"unavailable: {why}")
            sys.exit(77)
        n = unread_on_mac()
        code, out = osa(f'tell application "System Events" to tell process "Messages" to '
                        f'enabled of menu item "Mark All as Read" of {MENU}')
        menu = "enabled" if (code == 0 and out == "true") else "disabled"
        if n is None:
            print("ready (chat.db not readable here, so a push cannot be verified)")
        elif n and menu == "disabled":
            print(f"ready but dormant: {n} unread on the Mac and Mark All as Read is disabled "
                  "(Messages validates its menu only while it is the active app) - "
                  "a push right now would do nothing")
        else:
            print(f"ready ({n} unread on the Mac, menu {menu})")
        sys.exit(0)

    why = ensure_messages()
    if why:
        sys.stderr.write(f"imsg-read: {why}\n")
        sys.exit(69)
    why = accessibility()
    if why:
        sys.stderr.write(f"imsg-read: {why}\n")
        sys.exit(77)

    if argv[0] == "--all":
        before = unread_on_mac()
        if before == 0:
            print("nothing unread")
            return
        ok, err = click("Mark All as Read")
        if not ok and not err and before:
            # Disabled, yet chat.db says unread: the menu is dormant, not empty.
            prev = wake_messages()
            ok, err = click("Mark All as Read")
            restore_front(prev)
        if err:
            sys.stderr.write(f"imsg-read: {err}\n")
            sys.exit(1)
        report(before, settle(before) if ok else before, ok, "Mark All as Read")
        return

    if argv[0] == "--chat":
        if len(argv) < 2:
            sys.stderr.write("imsg-read: --chat needs a handle\n")
            sys.exit(64)
        before = unread_on_mac(argv[1])
        if before == 0:
            print("nothing unread")     # and no reason to pull Messages forward
            return
        prev = frontmost()
        try:
            why = select_chat(argv[1])
            if why:
                sys.stderr.write(f"imsg-read: {why}\n")
                sys.exit(64)
            # Never toggle: a conversation already read offers Mark as Unread.
            ok, err = click("Mark as Read")
            if err:
                sys.stderr.write(f"imsg-read: {err}\n")
                sys.exit(1)
            report(before, settle(before, argv[1]), ok, "Mark as Read")
        finally:
            restore_front(prev)
        return

    sys.stderr.write(f"imsg-read: unknown option {argv[0]!r}\n")
    sys.exit(64)


if __name__ == "__main__":
    try:
        with messages_ui_lock():
            main()
    except (OSError, TimeoutError) as exc:
        sys.stderr.write(f"imsg-read: {exc}\n")
        sys.exit(75)
