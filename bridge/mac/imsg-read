# Clicked only after chat_muted said the alerts are off, so it turns them on.
TOGGLES = {"--unmute": "Hide Alerts"}
# A toggle clicked in the wrong state does the opposite, so these check first.
CHECK_FIRST = ("--mute", "--unmute")
# macOS 27 has no Pin or Unpin in the Conversation menu (#132). The sidebar
# still offers both, as Accessibility custom actions on the SELECTED
# conversation: a row says "Pin <short name>", a pinned tile says "Unpin".
SIDEBAR = {"--pin": "Pin", "--unpin": "Unpin"}

# Run with `osascript -l JavaScript`, argv[0] = "Pin" or "Unpin", argv[1] = Messages' pid. Talks to the
# Accessibility API directly: walking the same tree through System Events cost
# 3 to 27 s (every element is an Apple Event round trip), this costs ~0.4 s.
# Only the direct children of the sidebar group ("Conversations") are
# candidates, and only the one Messages reports as selected: a message bubble
# offers a bare "Pin" of its own, which pins the MESSAGE, and must never match.
# When no built row is selected (a far-down chat), it pages the list from the
# top until the selected row exists, and returns the list to the top after.
# Prints one word: done, already (the tile/row shows the asked-for state), or
# none / error followed by a reason.
SIDEBAR_JS = r"""
ObjC.import('ApplicationServices');
// ~10 rows a page, so 150 pages cover ~1500 conversations. A page that moves
// returns as soon as the rows change (~0.35 s on the 27.0.1 mini); one that
// does not waits 0.6 s and ends the walk.
const MAX_PAGES = 150;
function attr(el, name) {
  const ref = Ref();
  if ($.AXUIElementCopyAttributeValue(el, $(name), ref) !== 0) return null;
  try { return ObjC.unwrap(ObjC.castRefToObject(ref[0])); } catch (e) { return null; }
}
function kids(el) {
  const ref = Ref();
  if ($.AXUIElementCopyAttributeValue(el, $('AXChildren'), ref) !== 0) return [];
  const arr = ObjC.castRefToObject(ref[0]), out = [];
  for (let i = 0; i < Number(arr.count); i++) out.push(arr.objectAtIndex(i));
  return out;
}
function actions(el) {
  const ref = Ref(), out = [];
  if ($.AXUIElementCopyActionNames(el, ref) !== 0) return out;
  const arr = ObjC.castRefToObject(ref[0]);
  for (let i = 0; i < Number(arr.count); i++) out.push(ObjC.unwrap(arr.objectAtIndex(i)));
  return out;
}
function run(argv) {
  const want = argv[0];
  // argv[1] is Messages' pid, from the process table (messages_pid in Python).
  // LaunchServices cannot be asked: from an ssh session on macOS 27.2,
  // NSRunningApplication and NSWorkspace list only background apps, never Finder
  // or Messages, while Accessibility by pid works. And JXA hands `count` back as
  // a STRING, so a `=== 0` guard never fires: compare Number(count).
  const pid = Number(argv[1]);
  if (!(pid > 0)) return 'none Messages is not running';
  const app = $.AXUIElementCreateApplication(pid);
  const stack = kids(app).filter(k => attr(k, 'AXRole') === 'AXWindow');
  if (!stack.length) return 'none Messages has no accessible window';
  let list = null, budget = 5000;
  while (stack.length && budget-- > 0) {
    const el = stack.pop();
    if (attr(el, 'AXDescription') === 'Conversations') { list = el; break; }
    for (const k of kids(el)) stack.push(k);
  }
  if (!list) return 'none the conversation list was not found';
  let picked = selected(list), moved = false;
  if (picked.length === 0) {
    // Messages builds only the rows near the viewport (~15), and `open
    // imessage:` selects a far-down chat without scrolling its row into view
    // (27.0.1 and 27.2, #132). Page from the top until the selected row is
    // built, then put the list back at the top whatever happens.
    moved = true;
    picked = reveal(list);
  }
  const result = perform(picked, want);
  if (moved) toTop(list);
  return result;
}
function selected(list) { return kids(list).filter(k => attr(k, 'AXSelected') === true); }
// One page in `dir`; false when the built rows did not change, which is the
// end of the list in that direction. Rows build a beat after the action.
function page(list, dir) {
  const sig = () => kids(list).map(k => String(attr(k, 'AXDescription'))).join('\n');
  const before = sig();
  if ($.AXUIElementPerformAction(list, $(dir)) !== 0) return false;
  for (let i = 0; i < 12; i++) { delay(0.05); if (sig() !== before) return true; }
  return false;
}
function toTop(list) { for (let i = 0; i < MAX_PAGES && page(list, 'AXScrollUpByPage'); i++); }
function reveal(list) {
  toTop(list);
  let picked = selected(list);
  for (let i = 0; picked.length === 0 && i < MAX_PAGES && page(list, 'AXScrollDownByPage'); i++) picked = selected(list);
  return picked;
}
function perform(picked, want) {
  if (picked.length !== 1) return 'none ' + picked.length + ' conversations are selected in the sidebar';
  const el = picked[0];
  const tile = String(attr(el, 'AXDescription') || '').endsWith(', Pinned');
  const names = actions(el);
  const first = n => n.split('\n')[0];
  const unpin = names.find(n => first(n) === 'Name:Unpin');
  const pin = names.find(n => first(n).startsWith('Name:Pin '));
  if (want === 'Pin' && tile && unpin) return 'already';
  if (want === 'Unpin' && !tile && pin) return 'already';
  const act = want === 'Pin' ? (!tile && pin) : (tile && unpin);
  if (!act) return 'none the selected conversation offers no ' + want;
  const err = $.AXUIElementPerformAction(el, $(act));
  return err === 0 ? 'done' : 'error AXError ' + err;
}
"""


def messages_pid() -> Optional[int]:
    """Messages' pid from the process table, or None unless there is exactly
    one. LaunchServices cannot answer this: over ssh on macOS 27.2,
    NSRunningApplication and NSWorkspace list only background apps (no Finder,
    no Messages) although `pgrep` and Accessibility by pid both see it."""
    try:
        r = subprocess.run(["/usr/bin/pgrep", "-x", "-U", str(os.getuid()), "Messages"],
                           capture_output=True, timeout=5)
    except (subprocess.TimeoutExpired, OSError):
        return None
    pids = r.stdout.decode("ascii", "replace").split()
    return int(pids[0]) if len(pids) == 1 and pids[0].isdigit() else None


def sidebar_action(item: str) -> tuple[bool, str]:
    """Pin or Unpin the selected conversation through its sidebar entry.
    Returns (did_it_or_already_so, error). The last thing tried, so a
    sidebar that offers nothing is an error that says why."""
    pid = messages_pid()
    if pid is None:
        return False, f"{item} needs Messages running as exactly one process, and it is not"
    try:
        r = subprocess.run(["osascript", "-l", "JavaScript", "-e", SIDEBAR_JS, item, str(pid)],
                           capture_output=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return False, "osascript timed out"
    out = (r.stdout or r.stderr).decode("utf-8", "replace").strip()
    if r.returncode != 0:
        return False, out or "the sidebar could not be read"
    word, _, why = out.partition(" ")
    if word in ("done", "already"):
        return True, ""
    if word == "none":
        return False, f"{item} is not in the Conversation menu or the sidebar ({why})"
    return False, why or out


# macOS 27 refuses a tenth pin with a sheet on the Messages window ("You can
# pin up to 9 conversations ..."), and the sidebar action itself still returns
# success, so the helper above used to end in "clicked but not pinned" with the
# sheet left open on the Mac (found live on the 27.2 gateway, 2026-11-09).
# This reads that sheet's text. It presses the button only on a ONE-button sheet
# whose text is about pinning; an alert of any other kind is somebody's decision,
# so it is read out and left alone. Prints "none" or "alert <0|1 closed> <text>".
PIN_ALERT_JS = r"""
ObjC.import('ApplicationServices');
function attr(el, name) {
  const ref = Ref();
  if ($.AXUIElementCopyAttributeValue(el, $(name), ref) !== 0) return null;
  try { return ObjC.unwrap(ObjC.castRefToObject(ref[0])); } catch (e) { return null; }
}
function kids(el) {
  const ref = Ref();
  if ($.AXUIElementCopyAttributeValue(el, $('AXChildren'), ref) !== 0) return [];
  const arr = ObjC.castRefToObject(ref[0]), out = [];
  for (let i = 0; i < Number(arr.count); i++) out.push(arr.objectAtIndex(i));
  return out;
}
function run(argv) {
  const pid = Number(argv[0]);
  if (!(pid > 0)) return 'none';
  const app = $.AXUIElementCreateApplication(pid);
  for (const win of kids(app).filter(k => attr(k, 'AXRole') === 'AXWindow')) {
    for (const sheet of kids(win).filter(k => attr(k, 'AXRole') === 'AXSheet')) {
      const text = kids(sheet).filter(k => attr(k, 'AXRole') === 'AXStaticText')
        .map(k => String(attr(k, 'AXValue') || '')).filter(t => t !== '').join(' ').replace(/\s+/g, ' ').slice(0, 300);
      const buttons = kids(sheet).filter(k => attr(k, 'AXRole') === 'AXButton');
      let closed = 0;
      if (buttons.length === 1 && /pin/i.test(text) && $.AXUIElementPerformAction(buttons[0], $('AXPress')) === 0) closed = 1;
      return 'alert ' + closed + ' ' + text;
    }
  }
  return 'none';
}
"""


def pin_refusal() -> str:
    """What Messages said when it would not pin, from the alert sheet it put up;
    "" when there is none (or it cannot be read). Only asked after a pin that
    did not land, so a pin that worked never touches the window again."""
    pid = messages_pid()
    if pid is None:
        return ""
    try:
        r = subprocess.run(["osascript", "-l", "JavaScript", "-e", PIN_ALERT_JS, str(pid)],
                           capture_output=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return ""
    out = (r.stdout or b"").decode("utf-8", "replace").strip()
    word, _, rest = out.partition(" ")
    if r.returncode != 0 or word != "alert":
        return ""
    closed, _, text = rest.partition(" ")
    text = "".join(c for c in text if c.isprintable()).strip()[:300]
    if not text:
        return ""
    return (f'Pin was clicked but Messages refused: "{text}" '
            + ("(the alert was dismissed)" if closed == "1" else "(the alert was left open on the Mac)"))


def conversation_action(flag: str, handle: str) -> None:
    """Select a DM, click one Conversation-menu item, verify it in Messages'
    own records, and hand focus back to whatever the user had in front.

    The front app is captured BEFORE the conversation is opened: `open
    imessage:` alone can bring Messages forward, and capturing after it
    restored Messages to itself. Verification is tri-state and fails closed:
    unknown (an unreadable pin list, a missing chat, a malformed plist) is
    not success for the "on" actions or the "off" ones."""
    item, probe_name, want, word = ACTIONS[flag]
    probe = globals()[probe_name]
    if GROUP_ID.fullmatch(handle):
        sys.stderr.write(f"imsg-read: {flag} is for direct messages; this is a group\n")
        sys.exit(64)
    if flag in CHECK_FIRST:
        now = probe(handle)
        if now is want:
            print(word)
            return
        if now is None:
            sys.stderr.write(f"imsg-read: Messages' records cannot say whether the conversation "
                             f"is muted, so {item} was not clicked\n")
            sys.exit(75)
    before = unread_on_mac(handle)
    prev = frontmost()
    selected = False
    try:
        why = select_chat(handle)
        if why:
            sys.stderr.write(f"imsg-read: {why}\n")
            sys.exit(64)
        selected = True
        ok, err = click(item)
        # A disabled menu is dormant while Messages is in the background.
        if not ok and not err:
            wake_messages()
            ok, err = click(item)
        if not ok and not err and flag in TOGGLES:
            ok, err = click(TOGGLES[flag])
        if not ok and not err and flag in SIDEBAR:
            ok, err = sidebar_action(SIDEBAR[flag])
        if err:
            sys.stderr.write(f"imsg-read: {err}\n")
            sys.exit(1)
        if not ok:
            sys.stderr.write(f"imsg-read: {item!r} was not available\n")
            sys.exit(1)
        # A sidebar pin on macOS 27 reached the pin list 4.4 to 5.5 s after
        # the action returned (six live round trips, 2026-11-04), past the
        # default ~3.5 s. The wait ends the moment the record agrees.
        got = settle_flag(lambda: probe(handle), want,
                          **({"tries": 30, "pause": 0.5} if flag in SIDEBAR else {}))
    finally:
        # Even a failed click opened the conversation; put its unread back
        # while it is still the selected one, then hand focus back.
        lost = keep_unread(handle, before) if selected else ""
        if lost:
            sys.stderr.write(f"imsg-read: its unread state on the Mac may not have survived "
                             f"opening it ({lost})\n")
        restore_front(prev)
    if flag == "--pin" and got is not want:
        why = pin_refusal()
        if why:
            sys.stderr.write(f"imsg-read: {why}\n")
            sys.exit(75)
    if got is None:
        sys.stderr.write(f"imsg-read: {item} was clicked but Messages' records cannot "
                         f"confirm the conversation is {word}\n")
        sys.exit(75)
    if got is not want:
        sys.stderr.write(f"imsg-read: {item} was clicked but the conversation is not {word}\n")
        sys.exit(75)
    print(word)


def frontmost() -> str:
    code, out = osa('tell application "System Events" to name of first application process whose frontmost is true')
    return out if code == 0 else ""


def wake_messages() -> str:
    """Make Messages the active app for a beat so AppKit validates its menus,
    and return the app that was in front so the caller can hand focus back.

    Measured 2026-09-04 (macOS 26.6): with a real unread and Messages in the
    background, EVERY Conversation item read disabled, even with the menu
    forced open; 0.7 s of activation flipped Mark All as Read to enabled, and
    it stayed enabled after the previous app was restored. The blip is under a
    second and happens only on this path — a menu that already validates is
    clicked without it."""
    prev = frontmost()
    osa('tell application "Messages" to activate')
    time.sleep(0.7)
    return prev


def restore_front(prev: str) -> None:
    if prev and prev != "Messages":
        name = prev.replace("\\", "\\\\").replace('"', '\\"')
        osa(f'tell application "System Events" to set frontmost of process "{name}" to true')


def chat_url(handle: str) -> str:
    """Address a group by its opaque identifier, never its name or speaker.

    Messages uses the same deep links as its own conversation shortcuts.
    Keep URL delimiters inside the value: an email must not inject a body.
    """
    if not isinstance(handle, str) or len(handle) > 254:
        raise ValueError("invalid conversation identifier")
    if re.fullmatch(r"chat[0-9]{1,40}|[a-fA-F0-9]{32}", handle):
        key = "groupid"
    elif re.fullmatch(r"\+?[0-9]{3,15}|[^@\s\x00-\x1f\x7f]+@[^@\s\x00-\x1f\x7f]+", handle):
        key = "address"
    else:
        raise ValueError("invalid conversation identifier")
    return "imessage:open?" + urlencode({key: handle})


def select_chat(handle: str) -> str:
    """Select the exact DM or group through Messages' address/groupid URL."""
    try:
        url = chat_url(handle)
    except ValueError as exc:
        return str(exc)
    try:
        r = subprocess.run(["open", url], capture_output=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return "opening the conversation timed out"
    if r.returncode != 0:
        # Selection did not move: clicking now would mark whatever Messages
        # had selected, some OTHER conversation (Astra C#4).
        return f"could not open the conversation (open exited {r.returncode})"
    subprocess.run(["sleep", "1.5"], capture_output=True)
    code, out = osa('tell application "System Events" to tell process "Messages" to count windows')
    if code != 0 or not out.isdecimal() or int(out) < 1:
        # Zero windows with Messages running is what a locked screen looks
        # like; say so, or the owner is sent to a Messages that is open and fine.
        if screen_locked():
            return SCREEN_LOCKED
        return "Messages has no accessible window; log in and open Messages on the Mac"
    return ""


def main() -> None:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)

    if argv[0] == "--status":
        why = ensure_messages() or accessibility()
        if why:
            print(f"unavailable: {why}")
            sys.exit(77)
        n = unread_on_mac()
        code, out = osa(f'tell application "System Events" to tell process "Messages" to '
                        f'enabled of menu item "Mark All as Read" of {MENU}')
        menu = "enabled" if (code == 0 and out == "true") else "disabled"
        if n is None:
            print("ready (chat.db not readable here, so a push cannot be verified)")
        elif n and menu == "disabled":
            print(f"ready but dormant: {n} unread on the Mac and Mark All as Read is disabled "
                  "(Messages validates its menu only while it is the active app) - "
                  "a push right now would do nothing")
        else:
            print(f"ready ({n} unread on the Mac, menu {menu})")
        sys.exit(0)

    why = ensure_messages()
    if why:
        sys.stderr.write(f"imsg-read: {why}\n")
        sys.exit(69)
    why = accessibility()
    if why:
        sys.stderr.write(f"imsg-read: {why}\n")
        sys.exit(77)

    if argv[0] == "--all":
        before = unread_on_mac()
        if before == 0:
            print("nothing unread")
            return
        ok, err = click("Mark All as Read")
        if not ok and not err and before:
            # Disabled, yet chat.db says unread: the menu is dormant, not empty.
            prev = wake_messages()
            ok, err = click("Mark All as Read")
            restore_front(prev)
        if err:
            sys.stderr.write(f"imsg-read: {err}\n")
            sys.exit(1)
        report(before, settle(before) if ok else before, ok, "Mark All as Read")
        return

    if argv[0] in ("--chat", "--unread"):
        if len(argv) < 2:
            sys.stderr.write("imsg-read: action needs a handle\n")
            sys.exit(64)
        handle = argv[1]
        want_unread = argv[0] == "--unread"
        before = unread_on_mac(handle)
        # Idempotency avoids opening an already-unread chat (which reads it)
        # and prevents polling from repeatedly stealing focus.
        if before is not None and ((before > 0) == want_unread):
            print("already unread" if want_unread else "nothing unread")
            return
        if not want_unread and "--through" in argv:
            i = argv.index("--through")
            if i + 1 >= len(argv) or newer_than_seen(handle, argv[i + 1]):
                sys.stderr.write("imsg-read: newer inbound arrived; leaving it unread\n")
                sys.exit(75)
        prev = frontmost()
        try:
            why = select_chat(handle)
            if why:
                sys.stderr.write(f"imsg-read: {why}\n")
                sys.exit(64)
            item = "Mark as Unread" if want_unread else "Mark as Read"
            ok, err = click(item)
            # A disabled menu is dormant while Messages is in the background.
            # Wake it and click once more; a real error still fails immediately.
            if not ok and not err:
                wake_messages()
                ok, err = click(item)
            if err:
                sys.stderr.write(f"imsg-read: {err}\n")
                sys.exit(1)
            # Opening can itself read the chat. Always check the database,
            # even when the menu was absent, disabled, or the count unknown.
            after = settle_unread(handle) if want_unread else settle(before, handle)
            if want_unread:
                report_unread(before, after, ok)
            else:
                report(before, after, ok, item)
        finally:
            restore_front(prev)
        return

    if argv[0] in ACTIONS:
        if len(argv) < 2:
            sys.stderr.write(f"imsg-read: {argv[0]} needs a handle\n")
            sys.exit(64)
        conversation_action(argv[0], argv[1])
        return

    sys.stderr.write(f"imsg-read: unknown option {argv[0]!r}\n")
    sys.exit(64)


if __name__ == "__main__":
    try:
        with messages_ui_lock():
            main()
    except (OSError, TimeoutError) as exc:
        sys.stderr.write(f"imsg-read: {exc}\n")
        sys.exit(75)
