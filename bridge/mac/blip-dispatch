#!/usr/bin/env python3
"""blip-dispatch — forced-command entry for Blip's dedicated ssh key.

blip-setup enrolls ~/.ssh/blip_ed25519.pub on this Mac as

    restrict,command="$HOME/.blip/bin/blip-dispatch" ssh-ed25519 AAAA…

so that key can run exactly the bridge tools and nothing else: no shell,
no forwarding, no pty, no paths. sshd hands us the client's requested command
in SSH_ORIGINAL_COMMAND; we split it like a shell would and exec the tool
directly (argv list, never a shell), with stdin/stdout passed straight through
so `imsg-send --file-stdin` and `imsg attachment` streaming keep working.
"""
import os
import shlex
import sys

# tcc-check is deliberately NOT reachable through the confined key: it drives
# Mail/Calendar/Notes/Reminders and pops four Automation prompts on the Mac.
# blip-check covers what Blip needs.
TOOLS = {"imsg", "imsg-send", "imsg-read", "contacts", "contact-save", "blip-check"}


def refuse(msg: str) -> None:
    sys.stderr.write(f"blip-dispatch: {msg}\n")
    sys.exit(64)  # EX_USAGE


def main() -> None:
    raw = os.environ.get("SSH_ORIGINAL_COMMAND", "").strip()
    if not raw:
        refuse("this key only runs the Blip bridge tools (no shell)")
    try:
        argv = shlex.split(raw)
    except ValueError as e:
        refuse(f"unparseable command: {e}")
    if not argv:
        refuse("empty command")
    if argv == ["ping"]:  # the shim's connectivity probe
        print("pong")
        return
    tool = argv[0]
    if tool not in TOOLS or "/" in tool:
        refuse(f"'{tool}' is not a Blip tool")
    bindir = os.path.dirname(os.path.realpath(__file__))
    path = os.environ.get("PATH", "/usr/bin:/bin")
    os.environ["PATH"] = "/opt/homebrew/bin:/usr/local/bin:" + path
    os.execv(sys.executable, [sys.executable, os.path.join(bindir, tool)] + argv[1:])


if __name__ == "__main__":
    main()
