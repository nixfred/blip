#!/usr/bin/env python3
"""
imsg: read-only iMessage / SMS query tool

Reads ~/Library/Messages/chat.db using sqlite3 in read-only mode and decodes
the typedstream-encoded `attributedBody` BLOB used by macOS Ventura+ for
message text.

Subcommands:
  recent [N], last N messages across all chats (default 20)
  from <handle> [N], messages exchanged with one handle (phone/email)
                                  matches by substring against handle.id
  search <text> [N], full-text-ish LIKE search across messages
  thread <handle> [N], same as `from`, oldest→newest
  contacts, list known handles with message counts
  chats, list chats (group + 1:1) with last activity and pin metadata
  groups [N], group chats with the AppleScript GUID needed to send to them

All output is `ts | who | text` (or JSON with --json).
"""

from __future__ import annotations

import argparse
import datetime as dt
import functools
import html
import json
import os
import plistlib
import re
import sqlite3
import struct
import subprocess
import sys
from glob import glob

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from calling_codes import REGION_TO_CALLING_CODE, split_calling_code  # noqa: E402  (sibling module)

DB_PATH = os.path.expanduser("~/Library/Messages/chat.db")
PINNING_PLIST_PATHS = (
    os.path.expanduser("~/Library/Preferences/com.apple.messages.pinning.plist"),
    os.path.expanduser(
        "~/Library/Containers/com.apple.MobileSMS/Data/Library/Preferences/"
        "com.apple.messages.pinning.plist"
    ),
)
APPLE_EPOCH = 978307200  # 2001-01-01 UTC
CONTACT_HELPER = os.path.expanduser("~/.blip/bin/contact-delete")

# ---------- Contacts name resolution (built-in, no external deps) ----------

_AB_GLOB = os.path.expanduser(
    "~/Library/Application Support/AddressBook/Sources/*/AddressBook-v22.abcddb"
)

_ACCOUNTS_DB = os.path.expanduser("~/Library/Accounts/Accounts4.sqlite")


def _archived_bool(blob) -> bool:
    """True when an NSKeyedArchiver plist archives the single value YES."""
    try:
        p = plistlib.loads(blob)
        root = p["$top"]["root"]
        v = p["$objects"][root.data] if isinstance(root, plistlib.UID) else root
        return v is True
    except Exception:
        return False


def _child_delegate_sources() -> set[str]:
    """Identifiers of Contacts stores that mirror a Family Sharing child's
    address book (Screen Time -> Manage Contacts). Each child gets its own
    CardDAV store under AddressBook/Sources/<id>/, and the Accounts database
    flags that account with isChildDelegate = YES. Contacts.app keeps them out
    of All Contacts; the bridge must too, or a child's "Mom" card outvotes your
    own spelling of the same number (two sons, two "Mom"s, one "Monica").
    Any failure -> empty set, i.e. the old read-every-source behavior."""
    out: set[str] = set()
    try:
        con = sqlite3.connect(f"file:{_ACCOUNTS_DB}?mode=ro", uri=True)
        rows = con.execute(
            "SELECT a.ZIDENTIFIER, p.ZVALUE FROM ZACCOUNTPROPERTY p "
            "JOIN ZACCOUNT a ON a.Z_PK = p.ZOWNER WHERE p.ZKEY = 'isChildDelegate'"
        ).fetchall()
        con.close()
    except sqlite3.DatabaseError:
        return out
    for ident, blob in rows:
        if ident and _archived_bool(blob):
            out.add(str(ident))
    return out


# Contacts sources are NOT equal, and counting them is how a name goes wrong.
# A synced directory — a work Exchange account, a Google export, a company
# address book — can hold thousands of rows and outvote the one card the owner
# typed themselves. Rank the sources instead of tallying them:
#   0  the local store, "On My Mac": no backing account. The owner typed it.
#   1  the owner's own iCloud (a CardDAV account owned by Apple ID settings).
#   2  every other synced source.
# Lowest rank that offers a name wins; only WITHIN a rank does the most common
# spelling still decide. An unreadable Accounts database ranks everything the
# same, which is exactly the old count-the-votes behaviour.
_RANK_LOCAL, _RANK_ICLOUD, _RANK_SYNCED = 0, 1, 2


def _source_ranks() -> dict:
    """Source identifier -> rank. Empty when Accounts cannot be read."""
    out: dict = {}
    try:
        con = sqlite3.connect(f"file:{_ACCOUNTS_DB}?mode=ro", uri=True)
        rows = con.execute(
            "SELECT a.ZIDENTIFIER, COALESCE(t.ZIDENTIFIER, ''), "
            "       COALESCE(a.ZOWNINGBUNDLEID, ''), COALESCE(a.ZACCOUNTDESCRIPTION, '') "
            "FROM ZACCOUNT a LEFT JOIN ZACCOUNTTYPE t ON t.Z_PK = a.ZACCOUNTTYPE"
        ).fetchall()
        con.close()
    except sqlite3.DatabaseError:
        return out
    for ident, kind, bundle, desc in rows:
        if not ident:
            continue
        apple = "AppleIDSettings" in (bundle or "") or (desc or "").strip().lower() == "icloud"
        out[str(ident)] = _RANK_ICLOUD if apple else _RANK_SYNCED
    return out


def _rank_of(path: str, ranks: dict) -> int:
    """A source directory with no account behind it is the local store."""
    return ranks.get(os.path.basename(os.path.dirname(path)), _RANK_LOCAL)


def _ab_sources() -> list[str]:
    """Every AddressBook source db that belongs to the user, minus the
    child-delegate mirrors, NEAREST SOURCE FIRST. The Sources/<id>/ folder name
    IS the account id.

    Order matters beyond names: cmd_avatar takes the first source that has a
    photo, so glob order let a synced directory's stock headshot beat the one
    the owner set. Ranked, the owner's own book answers first for both.
    """
    skip = _child_delegate_sources()
    ranks = _source_ranks()
    paths = [
        p for p in sorted(glob(_AB_GLOB))
        if os.path.basename(os.path.dirname(p)) not in skip
    ]
    return sorted(paths, key=lambda p: (_rank_of(p, ranks), p))


def _digits(s: str) -> str:
    return re.sub(r"\D", "", s or "")


def _normalize_phone(s: str) -> str:
    digits = _digits(s)
    return digits[-10:] if len(digits) >= 10 else digits


# ---- Phone numbers the way Contacts compares them ------------------------
#
# The last-ten key above is exact and is tried first, so nothing that resolves
# today can change. It is also North American: ten digits is a whole national
# number there and nothing anywhere else, so a card saved as "123 45 678" never
# met the handle +4712345678 and its owner showed as a bare number.
#
# The fallback is libphonenumber's rule, which is what Contacts runs on: give a
# number saved without a country code the Mac's own region, and call two
# numbers the same when their calling codes are equal and one national number
# ends with the other. Two guards on top: a floor of seven shared digits (a
# local number), and a North American card shorter than ten digits is missing
# its area code and matches nothing — Contacts would guess; Blip does not.

_GLOBAL_PREFS = os.path.expanduser("~/Library/Preferences/.GlobalPreferences.plist")
_LOCAL_NUMBER_DIGITS = 7

Phone = tuple[str, str]   # (calling code, national number), digits only


def _calling_code_for_locale(locale: str) -> str | None:
    """"en_US@rg=nozzzz" (a region override) or "nb_NO" -> "47"; None when unknown."""
    m = re.search(r"rg=([a-z]{2})", locale, re.I) or re.search(r"_([A-Z]{2})", locale)
    cc = REGION_TO_CALLING_CODE.get(m.group(1).upper()) if m else None
    return str(cc) if cc else None


@functools.lru_cache(maxsize=None)
def _home_calling_code() -> str | None:
    """The Mac's region as a calling code, from AppleLocale."""
    try:
        with open(_GLOBAL_PREFS, "rb") as f:
            return _calling_code_for_locale(str(plistlib.load(f).get("AppleLocale", "")))
    except (OSError, plistlib.InvalidFileException):
        return None


def _parse_phone(raw: str) -> Phone | None:
    """"+47 123 45 678" and "0047…" split on the calling code; "123 45 678"
    takes the Mac's region. None when neither applies."""
    s = (raw or "").strip()
    digits = _digits(s)
    if s.startswith("+"):
        return split_calling_code(digits)
    if s.startswith("00"):
        return split_calling_code(digits[2:])
    home = _home_calling_code()
    return (home, digits) if home and digits else None


def _same_number(handle: Phone, card: Phone) -> bool:
    """libphonenumber's SHORT_NSN_MATCH with Blip's two guards (see above)."""
    if card[0] != handle[0]:
        return False
    if card[0] == "1" and len(card[1]) < 10:
        return False
    for nsn in {card[1], card[1].removeprefix("0")}:   # a saved trunk zero (07700…) is not in the handle
        if min(len(nsn), len(handle[1])) >= _LOCAL_NUMBER_DIGITS and (handle[1].endswith(nsn) or nsn.endswith(handle[1])):
            return True
    return False


def _vote(local: dict, key, name: str) -> None:
    """One source's answer for a key: the single name it gives, or None once two
    names have collided — and None STAYS None. The old one-liner let a third
    card with the same number resurrect a name after two had cancelled out
    (Alice, Bob → ambiguous; Carol → "Carol") (Astra #2)."""
    if key in local:
        if local[key] != name:
            local[key] = None
    else:
        local[key] = name


_NAME_INDEX: dict[str, str] | None = None            # exact keys: last-ten digits, lowercased email
_PHONE_INDEX: dict[Phone, str] | None = None          # every saved number, parsed, for the region-aware fallback


def _is_dm_id(s: str | None) -> bool:
    """True for a chat_identifier that names a PERSON rather than a group.

    Groups are `chat<digits>` or 32 hex chars (see cmd_groups); a DM's
    chat_identifier IS the counterpart's handle. The guard matters: name_for
    keys on the last ten digits, so a group id's digits could otherwise
    collide with a real contact, and a group member's name must come from the
    sender alone or your own messages get labelled with the group.
    """
    s = (s or "").strip()
    if not s:
        return False
    if "@" in s:
        return True
    if re.fullmatch(r"chat\d+", s) or re.fullmatch(r"[0-9a-f]{32}", s, re.I):
        return False
    return bool(re.fullmatch(r"\+?\d[\d\s\-().]*", s))


def _dm_name(handle: str | None, chat_identifier: str | None) -> str | None:
    """The name to show for a row. An OUTBOUND row has no handle, and both
    JSON paths used to fall through to the raw chat key — so a one-to-one
    conversation was labelled with a phone number for exactly as long as your
    own message was the newest, and flipped back when they replied (#17,
    @znayer). For a DM the conversation IS the person, so resolve that.
    """
    if handle:
        return name_for(handle)
    return name_for(chat_identifier) if _is_dm_id(chat_identifier) else None


def name_for(handle: str | None) -> str | None:
    """Resolve a Messages handle (phone or email) to a Contacts display name.
    Lazily builds an in-memory index from all AddressBook source DBs on first
    call. Returns None if no contact match."""
    global _NAME_INDEX, _PHONE_INDEX
    if not handle:
        return None
    if _NAME_INDEX is None:
        # One person usually exists in SEVERAL sources under slightly different
        # spellings ("Rob" vs "Robert"). That is not ambiguity. Ambiguity is two
        # DIFFERENT records inside ONE source sharing the key — that source is
        # skipped for that key. A Family Sharing child's mirrored address book is
        # not one of yours at all (_ab_sources drops it).
        # Across sources the OWNER'S book wins outright (see _source_ranks); the
        # most common spelling only breaks ties within one rank. Counting every
        # source equally let a synced directory's bulk rows rename people.
        # key -> name -> [best source rank seen, times seen]
        votes: dict[str | Phone, dict[str, list]] = {}
        ranks = _source_ranks()
        for path in _ab_sources():
            rank = _rank_of(path, ranks)
            try:
                con = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
                con.row_factory = sqlite3.Row
                names = {
                    r["pk"]: " ".join(filter(None, [r["first"], r["last"]])).strip()
                    or r["org"] or r["nick"] or ""
                    for r in con.execute(
                        "SELECT Z_PK AS pk, ZFIRSTNAME AS first, ZLASTNAME AS last, "
                        "ZORGANIZATION AS org, ZNICKNAME AS nick FROM ZABCDRECORD"
                    )
                }
                local: dict[str | Phone, str | None] = {}   # None = ambiguous within this source
                for r in con.execute(
                    "SELECT ZOWNER AS pk, ZFULLNUMBER AS num FROM ZABCDPHONENUMBER"
                ):
                    name = names.get(r["pk"])
                    key = _normalize_phone(r["num"] or "")
                    if name and key:
                        _vote(local, key, name)
                    parsed = _parse_phone(r["num"] or "")
                    if name and parsed:
                        _vote(local, parsed, name)
                for r in con.execute(
                    "SELECT ZOWNER AS pk, ZADDRESS AS addr FROM ZABCDEMAILADDRESS"
                ):
                    name = names.get(r["pk"])
                    addr = (r["addr"] or "").strip().lower()
                    if name and addr:
                        _vote(local, addr, name)
                con.close()
                for key, name in local.items():
                    if name:
                        slot = votes.setdefault(key, {})
                        if name in slot:
                            slot[name][0] = min(slot[name][0], rank)
                            slot[name][1] += 1
                        else:
                            slot[name] = [rank, 1]
            except sqlite3.DatabaseError:
                continue
        # Nearest source first; only then the most common spelling.
        resolved = {k: min(v.items(), key=lambda kv: (kv[1][0], -kv[1][1]))[0] for k, v in votes.items()}
        _NAME_INDEX = {k: n for k, n in resolved.items() if isinstance(k, str)}
        _PHONE_INDEX = {k: n for k, n in resolved.items() if isinstance(k, tuple)}
    if "@" in handle:
        return _NAME_INDEX.get(handle.strip().lower()) or None
    hit = _NAME_INDEX.get(_normalize_phone(handle))
    if hit:
        return hit
    # No exact key: a unique region-aware match names it; two different names do not.
    parsed = _parse_phone(handle)
    near = {n for card, n in _PHONE_INDEX.items() if parsed and _same_number(parsed, card)}
    return near.pop() if len(near) == 1 else None


def unified_names(handles: list[str]) -> dict[str, dict[str, str]]:
    """Resolve a bounded set through the same unified-card view Messages uses."""
    bounded = []
    seen = set()
    for value in handles[:128]:
        if (isinstance(value, str) and 1 <= len(value) <= 320
                and not re.search(r"[\x00-\x1f\x7f-\x9f\u202a-\u202e\u2066-\u2069]", value)
                and value not in seen):
            seen.add(value)
            bounded.append(value)
    if not bounded or not os.path.isfile(CONTACT_HELPER):
        return {}
    try:
        result = subprocess.run(
            [CONTACT_HELPER], input=json.dumps({"operation": "names", "handles": bounded}),
            text=True, capture_output=True, timeout=10, check=False,
        )
        payload = json.loads(result.stdout) if result.returncode == 0 else {}
        rows = payload.get("names") if isinstance(payload, dict) else None
        if not isinstance(rows, list):
            return {}
        return {
            row["handle"]: {
                "name": str(row.get("name") or "")[:160],
                "short": str(row.get("shortName") or row.get("name") or "")[:160],
            }
            for row in rows
            if isinstance(row, dict) and row.get("handle") in seen and row.get("name")
        }
    except (OSError, subprocess.SubprocessError, ValueError, TypeError):
        return {}


def label(handle: str | None, is_from_me: int, with_names: bool) -> str:
    """Pretty label for the 'who' column."""
    if is_from_me:
        return "me"
    if not handle:
        return "?"
    if with_names:
        n = name_for(handle)
        if n:
            return f"{n} <{handle}>"
    return handle


def open_db() -> sqlite3.Connection:
    if not os.path.exists(DB_PATH):
        sys.exit(f"chat.db not found at {DB_PATH}")
    # mode=ro alone (without immutable=1) so we still see uncommitted WAL writes
    con = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True)
    # macOS 12 and earlier have no Recently Deleted table: filter without it
    # instead of dying with a traceback on every command.
    global MESSAGE_SRC
    if not con.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='chat_recoverable_message_join'"
    ).fetchone():
        MESSAGE_SRC = message_src(has_recently_deleted=False)
    con.row_factory = sqlite3.Row
    return con


def decode_attributed_body(blob: bytes | None) -> str | None:
    """Pull text from the NSAttributedString typedstream blob.
    Layout after class chain: \\x84\\x01+ <length> <utf-8 bytes>.
    Length: 1 byte, or 0x81 + u16 LE, or 0x82 + u32 LE."""
    if not blob:
        return None
    i = blob.find(b"NSString")
    if i == -1:
        return None
    marker = blob.find(b"\x84\x01+", i)
    if marker == -1:
        return None
    p = marker + 3
    if p >= len(blob):
        return None
    first = blob[p]
    if first == 0x81:
        length = struct.unpack_from("<H", blob, p + 1)[0]
        p += 3
    elif first == 0x82:
        length = struct.unpack_from("<I", blob, p + 1)[0]
        p += 5
    else:
        length = first
        p += 1
    return blob[p : p + length].decode("utf-8", errors="replace")


def fmt_ts(apple_ns: int | None) -> str:
    if not apple_ns:
        return "?"
    return dt.datetime.fromtimestamp(apple_ns / 1e9 + APPLE_EPOCH).strftime(
        "%Y-%m-%d %H:%M:%S"
    )


def message_text(row: sqlite3.Row) -> str:
    return _app_card_text(row) or row["text"] or decode_attributed_body(row["attributedBody"]) or ""


def _unarchive(blob) -> dict | None:
    """The NSKeyedArchiver plist in a blob, or None if it is not one."""
    try:
        p = plistlib.loads(bytes(blob))
        return p if isinstance(p.get("$objects"), list) and "root" in p["$top"] else None
    except Exception:
        return None


def _deref(objs: list, v, depth: int = 0):
    """Follow archive references: UIDs into the object table, NSURL to its
    string, NSDictionary to a plain dict. Anything deeper than six hops is
    a cycle or an object we do not model — None."""
    if depth > 6:
        return None
    if isinstance(v, plistlib.UID):
        if v.data == 0:   # $null
            return None
        return _deref(objs, objs[v.data], depth + 1) if v.data < len(objs) else None
    if isinstance(v, dict) and "NS.relative" in v:   # NSURL
        return _deref(objs, v["NS.relative"], depth + 1)
    if isinstance(v, dict) and "NS.keys" in v and "NS.objects" in v:   # NSDictionary
        pairs = ((_deref(objs, k, depth + 1), _deref(objs, o, depth + 1))
                 for k, o in zip(v["NS.keys"], v["NS.objects"]))
        return {k: o for k, o in pairs if isinstance(k, str)}
    return v


def _app_card_text(row) -> str | None:
    """Messages' own words for an iMessage-app card — Ask to Buy, Fitness
    sharing, Find My, … The text column holds U+FFFD for these; the payload is
    an MSMessage archive whose `ldtext` is the sentence Messages shows when the
    app cannot render the card, then the card's caption, then the app's name.
    Link cards are not apps and keep their URL. Anything unreadable → None.
    Apple escapes some of these sentences as HTML ("Photo &amp; Video") and
    leaves others raw; html.unescape makes them one thing."""
    if "payload_data" not in row.keys():   # a snippet row, not a base_select row
        return None
    bundle = row["balloon_bundle_id"] or ""
    if not bundle or bundle.endswith("URLBalloonProvider") or not row["payload_data"]:
        return None
    p = _unarchive(row["payload_data"])
    root = _deref(p["$objects"], p["$top"]["root"]) if p else None
    if not isinstance(root, dict):
        return None
    info = root.get("userInfo") if isinstance(root.get("userInfo"), dict) else {}
    for text in (root.get("ldtext"), info.get("caption"), root.get("an")):
        if isinstance(text, str) and text.strip():
            return html.unescape(text.strip())[:500]
    return None


def pinned_chat_identifiers() -> list[set[str]]:
    """Ordered pins from Messages' pinning preferences, one alias set each.

    Observed layout (macOS 15/26, undocumented): ``pD.pP`` is the ORDERED list
    of pin ids — a handle for a DM, a dashed UUID for a group — and ``pD.pZ``
    maps a group's pin id to ``{"o": <original group id>, "h": <hash>}``. A
    pinned group can be stored under either id, so each entry carries both.
    Flattening every string in the file (the first cut) ranked a group by
    the position of its ``pZ`` alias, ahead of every DM. When ``pD.pP`` is
    missing the flatten is the fallback, so an unknown layout still yields
    something rather than nothing.
    """
    def alias_set(value) -> set[str]:
        return {value.strip()} if isinstance(value, str) and value.strip() else set()

    def flatten(item, out: list[set[str]], seen: set[str]) -> None:
        if isinstance(item, str):
            item = item.strip()
            if item and item not in seen:
                seen.add(item)
                out.append({item})
        elif isinstance(item, dict):
            for child in item.values():
                flatten(child, out, seen)
        elif isinstance(item, (list, tuple)):
            for child in item:
                flatten(child, out, seen)

    for path in PINNING_PLIST_PATHS:
        try:
            with open(path, "rb") as f:
                data = plistlib.load(f)
        except (OSError, plistlib.InvalidFileException, ValueError, TypeError):
            continue
        pd = data.get("pD") if isinstance(data, dict) else None
        ordered = pd.get("pP") if isinstance(pd, dict) else None
        if isinstance(ordered, (list, tuple)):
            aliases = pd.get("pZ") if isinstance(pd.get("pZ"), dict) else {}
            out: list[set[str]] = []
            for pin_id in ordered:
                ids = alias_set(pin_id)
                if not ids:
                    continue
                extra = aliases.get(pin_id)
                if isinstance(extra, dict):
                    ids |= alias_set(extra.get("o"))
                out.append(ids)
            if out:
                return out
        flat: list[set[str]] = []
        flatten(data, flat, set())
        if flat:
            return flat
    return []


def _pin_id(value: str) -> str:
    """Reduce an Apple chat id (or service-qualified id) to its chat id."""
    value = str(value or "").strip().lower()
    for separator in (";+;", ";-;"):
        if separator in value:
            value = value.rsplit(separator, 1)[1]
    return value


def _same_chat_id(left: str, right: str) -> bool:
    left = _pin_id(left)
    right = _pin_id(right)
    if left == right:
        return True
    # Some preference/database versions omit the plus on phone identifiers.
    if re.fullmatch(r"\+?[0-9]{5,}", left) and re.fullmatch(r"\+?[0-9]{5,}", right):
        return left.lstrip("+") == right.lstrip("+")
    return False


def pin_order_for(pins: list[set[str]], chat_identifier: str, guid: str | None,
                  group_id: str | None = None, original_group_id: str | None = None) -> int | None:
    """Return the Messages pin position for one chat, or None.

    DMs are pinned by handle (chat_identifier / guid). GROUPS are pinned by
    the chat row's `group_id` (or `original_group_id`) — dashed UUIDs that
    never equal the chat_identifier (chat<digits>) or the guid
    (any;+;chat<digits>), so a pinned group was invisible without them.
    """
    candidates = [c for c in (chat_identifier, guid, group_id, original_group_id) if c]
    for index, ids in enumerate(pins):
        for pin_id in ids:
            if any(_same_chat_id(pin_id, c) for c in candidates):
                return index
    return None


# ---------- --rich enrichment (tapbacks, read receipts, replies, attachments) ----------

# Tapback rows are their own messages pointing at a target via
# associated_message_guid ("p:0/<GUID>" / "bp:<GUID>"). 2xxx adds, 3xxx removes;
# a sender's latest row for a target wins.
TAPBACK_EMOJI = {0: "❤️", 1: "\U0001f44d", 2: "\U0001f44e",
                 3: "\U0001f602", 4: "‼️", 5: "❓"}

_COLS: set[str] | None = None


def _has_col(con, name: str) -> bool:
    global _COLS
    if _COLS is None:
        _COLS = {r["name"] for r in con.execute("PRAGMA table_info(message)")}
    return name in _COLS


def _strip_assoc(guid: str | None) -> str:
    """'p:0/ABC' / 'bp:ABC' / 'ABC' → 'ABC'."""
    if not guid:
        return ""
    if "/" in guid:
        return guid.rsplit("/", 1)[1]
    if ":" in guid:
        return guid.rsplit(":", 1)[1]
    return guid


def _effect_name(style_id: str | None) -> str | None:
    """'com.apple.messages.effect.CKConfettiEffect' → 'confetti'."""
    if not style_id:
        return None
    last = style_id.rsplit(".", 1)[-1]
    if last.startswith("CK"):
        last = last[2:]
    if last.endswith("Effect"):
        last = last[: -len("Effect")]
    return last.lower() or None


def _chunked_in(con, sql_tmpl: str, ids: list, chunk: int = 500):
    for i in range(0, len(ids), chunk):
        part = ids[i : i + chunk]
        marks = ",".join("?" * len(part))
        yield from con.execute(sql_tmpl.format(marks=marks), part)


def _parse_rich_link(blob: bytes) -> dict | None:
    """Decode a URL balloon's payload_data (NSKeyedArchiver plist wrapping an
    LPLinkMetadata) into {url, title, summary, image_index}. image_index
    indexes the message's .pluginPayloadAttachment rows (ROWID order), which
    hold the preview PNGs. Best-effort: any oddity → None."""
    p = _unarchive(blob)
    if not p:
        return None
    objs = p["$objects"]

    def deref(v):
        return _deref(objs, v)

    md = None
    for o in objs:
        if isinstance(o, dict) and "richLinkMetadata" in o:
            md = deref(o["richLinkMetadata"])
            break
    if not isinstance(md, dict):
        for o in objs:  # bare LPLinkMetadata archives
            if isinstance(o, dict) and "URL" in o and "title" in o:
                md = o
                break
    if not isinstance(md, dict):
        return None
    url = deref(md.get("URL")) or deref(md.get("originalURL"))
    title = deref(md.get("title"))
    summary = deref(md.get("summary"))
    idx = None
    for key in ("image", "icon"):
        im = deref(md.get(key))
        if isinstance(im, dict) and isinstance(im.get("richLinkImageAttachmentSubstituteIndex"), int):
            idx = im["richLinkImageAttachmentSubstituteIndex"]
            break
    if not isinstance(url, str) or not url:
        return None
    return {
        "url": url[:2048],
        "title": (title if isinstance(title, str) else "")[:300],
        "summary": (summary if isinstance(summary, str) else "")[:500],
        "image_index": idx,
    }


def _unsent(summary_info) -> bool:
    """True when message_summary_info lists withdrawn parts (`rp`).

    macOS 26 records an Undo Send as an edit: date_edited is stamped, the body
    is cleared, and date_retracted stays 0 — `rp` in this plist is the only
    trace. A real edit carries `ec` (the history) and no `rp`. Anything
    unreadable is not an unsend."""
    try:
        return bool(plistlib.loads(bytes(summary_info)).get("rp"))
    except (plistlib.InvalidFileException, ValueError, TypeError, AttributeError):
        return False


def _edit_flags(date_edited, date_retracted, summary_info) -> dict:
    """An unsend is not an edit, whatever date_edited says."""
    if date_retracted or _unsent(summary_info):
        return {"retracted": True}
    return {"edited": True} if date_edited else {}


def enrich(con, rows, with_names: bool):
    """Per-ROWID extras for --rich JSON. Returns (kept_rows, extras) where
    tapback rows are folded onto their targets and dropped from kept_rows."""
    rows = list(rows)
    has_emoji = _has_col(con, "associated_message_emoji")
    has_edit = _has_col(con, "date_edited")

    kept = [r for r in rows if not (r["assoc_type"] and 2000 <= r["assoc_type"] < 4000)]
    targets = {r["guid"]: r["ROWID"] for r in kept if r["guid"]}
    extras: dict[int, dict] = {r["ROWID"]: {} for r in kept}

    # Tapbacks: scan every assoc row in the DB (type-filtered), net per sender+target.
    emoji_col = ", m.associated_message_emoji AS emo" if has_emoji else ""
    latest: dict[tuple[str, str], sqlite3.Row] = {}
    for r in con.execute(
        f"""SELECT m.associated_message_guid AS ag, m.associated_message_type AS t,
                   m.is_from_me, m.date, h.id AS handle{emoji_col}
            FROM {MESSAGE_SRC} m LEFT JOIN handle h ON h.ROWID = m.handle_id
            WHERE m.associated_message_type BETWEEN 2000 AND 3999"""
    ):
        tg = _strip_assoc(r["ag"])
        if tg not in targets:
            continue
        who = "me" if r["is_from_me"] else (r["handle"] or "?")
        key = (who, tg)
        if key not in latest or r["date"] > latest[key]["date"]:
            latest[key] = r
    for (who, tg), r in latest.items():
        if not (2000 <= r["t"] < 3000):
            continue  # net-removed
        kind = r["t"] - 2000
        emoji = (r["emo"] if has_emoji and r["emo"] else None) or TAPBACK_EMOJI.get(kind, "⭐")
        extras[targets[tg]].setdefault("tapbacks", []).append({
            "emoji": emoji,
            "from_me": bool(r["is_from_me"]),
            "by": None if r["is_from_me"] else (name_for(r["handle"]) if with_names else None) or r["handle"],
        })

    # Attachments. transfer_name is null mid-download; .pluginPayloadAttachment
    # blobs are rich-link-preview internals (a URL message can carry four of
    # them), not user files — both are noise to a client.
    rowids = [r["ROWID"] for r in kept]
    for a in _chunked_in(
        con,
        """SELECT maj.message_id AS mid, a.ROWID AS aid, a.transfer_name AS name,
                  a.mime_type AS mime, a.total_bytes AS bytes
           FROM message_attachment_join maj
           JOIN attachment a ON a.ROWID = maj.attachment_id
           WHERE a.transfer_name IS NOT NULL
             AND a.transfer_name NOT LIKE '%.pluginPayloadAttachment'
             AND maj.message_id IN ({marks})""",
        rowids,
    ):
        extras.setdefault(a["mid"], {}).setdefault("attachments", []).append(
            # id as a STRING: attachment ROWIDs are 64-bit and JS number
            # consumers lose precision past 2^53.
            {"id": str(a["aid"]), "name": a["name"], "mime": a["mime"], "bytes": a["bytes"]}
        )

    # Rich-link cards: the balloon payload names the URL/title/summary; the
    # preview image is the nth .pluginPayloadAttachment row of the message.
    payload_ids: dict[int, list[int]] = {}
    link_rows = [r for r in kept if (r["balloon_bundle_id"] or "").endswith("URLBalloonProvider") and r["payload_data"]]
    if link_rows:
        for a in _chunked_in(
            con,
            """SELECT maj.message_id AS mid, a.ROWID AS aid
               FROM message_attachment_join maj JOIN attachment a ON a.ROWID = maj.attachment_id
               WHERE a.transfer_name LIKE '%.pluginPayloadAttachment' AND a.total_bytes > 0
                 AND maj.message_id IN ({marks}) ORDER BY a.ROWID""",
            [r["ROWID"] for r in link_rows],
        ):
            payload_ids.setdefault(a["mid"], []).append(a["aid"])
        for r in link_rows:
            link = _parse_rich_link(r["payload_data"])
            if not link:
                continue
            ids = payload_ids.get(r["ROWID"], [])
            idx = link.pop("image_index")
            link["image_id"] = str(ids[idx]) if isinstance(idx, int) and 0 <= idx < len(ids) else (str(ids[0]) if ids else "")
            extras[r["ROWID"]]["link"] = link

    # Inline-reply context: resolve originator guids (often outside the window).
    origins = sorted({r["orig_guid"] for r in kept if r["orig_guid"]})
    osnip: dict[str, dict] = {}
    if origins:
        for o in _chunked_in(
            con,
            f"SELECT guid, text, attributedBody, is_from_me FROM {MESSAGE_SRC} m WHERE guid IN ({{marks}})",
            origins,
        ):
            osnip[o["guid"]] = {
                "text": (o["text"] or decode_attributed_body(o["attributedBody"]) or "")[:120],
                "from_me": bool(o["is_from_me"]),
            }

    for r in kept:
        e = extras[r["ROWID"]]
        if r["is_from_me"] and r["date_read"]:
            e["read_at"] = fmt_ts(r["date_read"])
        if has_edit:
            e.update(_edit_flags(r["date_edited"], r["date_retracted"], r["message_summary_info"]))
        if r["orig_guid"] and r["orig_guid"] in osnip:
            e["reply_to"] = osnip[r["orig_guid"]]
        fx = _effect_name(r["style_id"])
        if fx:
            e["effect"] = fx
        if r["is_audio_message"]:
            e["audio"] = True
    return kept, extras


def render(rows, as_json: bool, with_names: bool = True, con=None, rich: bool = False) -> None:
    if as_json:
        extras: dict[int, dict] = {}
        if rich and con is not None:
            rows, extras = enrich(con, rows, with_names)
        out = []
        for r in rows:
            row = {
                # Stable identity for clients (toast dedupe, read ledgers): a
                # message's text can change between polls (body decoded after
                # the row lands) and its ts can sit ahead of the client's clock.
                "id": r["ROWID"],
                "ts": fmt_ts(r["date"]),
                "from_me": bool(r["is_from_me"]),
                "handle": r["handle"],
                "name": _dm_name(r["handle"], r["chat_identifier"]) if with_names else None,
                "service": r["service"],
                "chat": r["room_name"] or r["chat_identifier"],
                "text": message_text(r),
                # The APPLE-side read state — is_read syncs from the iPhone
                # via Messages in iCloud, so a client can mirror the phone's
                # badge. Own messages are trivially "read".
                "read": bool(r["is_from_me"]) or bool(r["is_read"]),
                # edited / retracted ride the plain rows as well: the collector
                # polls without --rich, and its self-thread unsend handling
                # (dedupeSelfEcho) never saw the flag (Astra #16).
                **_edit_flags(r["date_edited"], r["date_retracted"], r["message_summary_info"]),
                # Tapback rows are messages too, but no Apple client counts
                # them toward a badge — flag them so clients can match.
                "tapback": bool(r["assoc_type"] and 2000 <= r["assoc_type"] < 4000),
                # Delivery failure code on OWN messages (0 = fine). AppleScript
                # reports success for sends that die later; this is the only
                # place the truth lands (e.g. 25 = attachment not readable).
                "error": int(r["error"] or 0) if r["is_from_me"] else 0,
            }
            if rich:
                row["guid"] = r["guid"]
                row.update(extras.get(r["ROWID"], {}))
            out.append(row)
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return
    for r in rows:
        who = label(r["handle"], r["is_from_me"], with_names)
        text = message_text(r).replace("\n", " | ")
        chat = r["room_name"] or r["chat_identifier"] or ""
        chat_tag = f" [{chat}]" if chat and chat != (r["handle"] or "") else ""
        print(f"{fmt_ts(r['date'])}  {who:>30}{chat_tag}: {text}")


# Two kinds of rows live in the message table without being messages. Both are
# hidden at the source, so every query — recent, thread, chats, unread — agrees.
#
#   Recently Deleted: the 30-day bin, synced from the iPhone via Messages in
#   iCloud. Left in, a conversation deleted on the phone lingers in every client
#   for a month. IMSG_INCLUDE_DELETED=1 shows them.
#
#   Announcements (item_type != 0): someone joined or left, a rename, location
#   sharing started or stopped. Messages.app draws them as grey centered text
#   and never marks them read, so left in they surface as empty bubbles that
#   count as unread forever. Group names are still recovered from rename rows;
#   cmd_groups reads the raw table for that.
HIDE_DELETED = os.environ.get("IMSG_INCLUDE_DELETED") != "1"


def message_src(has_recently_deleted: bool) -> str:
    where = ["item_type = 0"]
    if HIDE_DELETED and has_recently_deleted:
        where.append("ROWID NOT IN (SELECT message_id FROM chat_recoverable_message_join)")
    return f"(SELECT * FROM message WHERE {' AND '.join(where)})"


MESSAGE_SRC = message_src(has_recently_deleted=True)

_BASE_SELECT_CACHE: str | None = None


def base_select(con) -> str:
    """Column list adapts to the schema: date_edited/date_retracted arrived in
    macOS 13, associated_message_emoji in 14 — older DBs must still query."""
    global _BASE_SELECT_CACHE
    if _BASE_SELECT_CACHE is None:
        edit_cols = (
            "m.date_edited, m.date_retracted, m.message_summary_info,"
            if _has_col(con, "date_edited")
            else "0 AS date_edited, 0 AS date_retracted, NULL AS message_summary_info,"
        )
        _BASE_SELECT_CACHE = f"""
            SELECT m.ROWID, m.date, m.is_from_me, m.text, m.attributedBody,
                   m.service, h.id AS handle, c.chat_identifier, c.room_name,
                   m.guid, m.date_read, m.is_read, m.error, {edit_cols}
                   m.associated_message_type AS assoc_type,
                   m.thread_originator_guid AS orig_guid,
                   m.expressive_send_style_id AS style_id,
                   m.is_audio_message,
                   m.balloon_bundle_id, m.payload_data
            FROM {MESSAGE_SRC} m
            LEFT JOIN handle h ON h.ROWID = m.handle_id
            LEFT JOIN chat_message_join cmj ON cmj.message_id = m.ROWID
            LEFT JOIN chat c ON c.ROWID = cmj.chat_id
        """
    return _BASE_SELECT_CACHE


def cmd_recent(con, args):
    rows = con.execute(
        base_select(con) + " ORDER BY m.date DESC LIMIT ?", (args.n,)
    ).fetchall()
    render(reversed(rows) if args.chrono else rows, args.json,
           with_names=not args.no_names, con=con, rich=args.rich)


def cmd_from(con, args):
    rows = con.execute(
        base_select(con)
        + " WHERE h.id LIKE ? ORDER BY m.date DESC LIMIT ?",
        (f"%{args.handle}%", args.n),
    ).fetchall()
    render(reversed(rows) if args.chrono else rows, args.json,
           with_names=not args.no_names, con=con, rich=args.rich)


def cmd_thread(con, args):
    if args.chat:
        # Exact chat_identifier match — the ONLY way to load a group (its
        # 32-hex / chat<digits> id never matches a handle LIKE), and exact
        # for DMs too. Clients previously scanned `recent 1500` and filtered,
        # which both cost more and missed anything older than the window.
        # `imsg thread --chat <id> 40`: the count lands in the (unused)
        # handle slot, so accept it from either positional.
        n = int(args.handle) if str(args.handle).isdigit() else args.n
        # A re-keyed group's history is split across chat rows; load them all
        # so opening the conversation shows everything Messages shows.
        clusters = _group_cluster_map(con)
        canon = clusters.get(args.chat, args.chat)
        ids = sorted({c for c, k in clusters.items() if k == canon} | {args.chat, canon})
        placeholders = ",".join("?" for _ in ids)
        rows = con.execute(
            base_select(con)
            + f" WHERE c.chat_identifier IN ({placeholders}) ORDER BY m.date DESC LIMIT ?",
            (*ids, n),
        ).fetchall()
        render(reversed(rows), args.json,
               with_names=not args.no_names, con=con, rich=args.rich)
        return
    if not args.handle:
        sys.exit("error: pass a handle, or --chat <chat_identifier>")
    rows = con.execute(
        base_select(con)
        + " WHERE h.id LIKE ? ORDER BY m.date DESC LIMIT ?",
        (f"%{args.handle}%", args.n),
    ).fetchall()
    render(reversed(rows), args.json,
           with_names=not args.no_names, con=con, rich=args.rich)


def _search_needles(query: str) -> list[str]:
    """Case variants to scan inside attributedBody.
    instr() on a BLOB is byte-exact; LIKE on m.text is already ASCII
    case-insensitive. Newer messages often have NULL text and only a
    UTF-8 needle inside the typedstream, so a lowercase query would miss
    a body that starts with a capital letter."""
    q = query or ""
    out: list[str] = []
    seen: set[str] = set()
    for v in (q, q.lower(), q.upper(), q[:1].upper() + q[1:].lower() if q else ""):
        if v and v not in seen:
            seen.add(v)
            out.append(v)
    return out


def cmd_search(con, args):
    # text column is null for newer messages; also scan attributedBody as bytes
    needles = _search_needles(args.query)
    blob_or = " OR ".join("instr(m.attributedBody, CAST(? AS BLOB)) > 0" for _ in needles)
    rows = con.execute(
        base_select(con)
        + f"""
        WHERE m.text LIKE ?
           OR (m.attributedBody IS NOT NULL AND ({blob_or}))
        ORDER BY m.date DESC LIMIT ?""",
        (f"%{args.query}%", *needles, args.n),
    ).fetchall()
    render(reversed(rows) if args.chrono else rows, args.json,
           with_names=not args.no_names, con=con, rich=args.rich)


def cmd_contacts(con, args):
    rows = con.execute(
        """
        SELECT h.id AS handle, h.service, COUNT(m.ROWID) AS n,
               MAX(m.date) AS last_date
        FROM handle h LEFT JOIN message m ON m.handle_id = h.ROWID
        GROUP BY h.id, h.service
        HAVING n > 0
        ORDER BY last_date DESC
        LIMIT ?""",
        (args.n,),
    ).fetchall()
    if args.json:
        print(
            json.dumps(
                [
                    {"handle": r["handle"], "service": r["service"],
                     "messages": r["n"], "last": fmt_ts(r["last_date"])}
                    for r in rows
                ],
                indent=2,
            )
        )
        return
    for r in rows:
        nm = name_for(r["handle"]) if not args.no_names else None
        suffix = f"  ({nm})" if nm else ""
        print(f"{fmt_ts(r['last_date'])}  {r['n']:>6}  {r['service']:>8}  {r['handle']}{suffix}")


def cmd_chats(con, args):
    # Every conversation, newest activity first — the COMPLETE list a client
    # should build its sidebar from (deriving it from a window of recent
    # messages loses every quiet conversation). JSON rows carry a preview of
    # the latest visible message so the list needs no second query.
    # original_group_id is absent on older chat.db schemas; probe once.
    chat_cols = {row[1] for row in con.execute("PRAGMA table_info(chat)")}
    orig_col = "c.original_group_id" if "original_group_id" in chat_cols else "NULL"
    rows = con.execute(
        f"""
        SELECT c.ROWID AS cid, c.chat_identifier, c.guid, c.group_id,
               {orig_col} AS original_group_id, c.display_name, c.room_name, c.style,
               c.service_name, MAX(m.date) AS last_date,
               COUNT(m.ROWID) AS n
        FROM chat c
        LEFT JOIN chat_message_join cmj ON cmj.chat_id = c.ROWID
        LEFT JOIN {MESSAGE_SRC} m ON m.ROWID = cmj.message_id
        GROUP BY c.ROWID
        HAVING n > 0
        ORDER BY last_date DESC
        LIMIT ?""",
        (args.n,),
    ).fetchall()
    if args.json:
        pin_ids = pinned_chat_identifiers()
        # One entry per CONVERSATION: a group re-keyed by Messages leaves
        # several chat rows and used to list once per row.
        clusters = _group_cluster_map(con)
        merged_counts: dict[str, int] = {}
        pin_orders: dict[str, int] = {}
        for r in rows:
            chat_id = r["chat_identifier"]
            canon = clusters.get(chat_id, chat_id)
            merged_counts[canon] = merged_counts.get(canon, 0) + r["n"]
            order = pin_order_for(pin_ids, chat_id, r["guid"],
                                  r["group_id"], r["original_group_id"])
            if order is not None and (canon not in pin_orders or order < pin_orders[canon]):
                pin_orders[canon] = order

        selected = []
        seen_ids = set()
        for r in rows:
            chat_id = r["chat_identifier"]
            if chat_id in seen_ids:
                continue
            seen_ids.add(chat_id)
            canon = clusters.get(chat_id)
            if canon and canon != chat_id:
                continue                 # an older row of a conversation listed under `canon`
            selected.append(r)

        latest = {}
        for r in selected:
            last = con.execute(
                f"""SELECT m.ROWID AS mid, m.text, m.attributedBody, m.is_from_me,
                            h.id AS handle
                    FROM chat_message_join cmj
                    JOIN {MESSAGE_SRC} m ON m.ROWID = cmj.message_id
                    LEFT JOIN handle h ON h.ROWID = m.handle_id
                    WHERE cmj.chat_id = ?
                    ORDER BY m.date DESC LIMIT 1""",
                (r["cid"],),
            ).fetchone()
            if last:
                latest[r["cid"]] = last

        attachments = {}
        for attachment in _chunked_in(
            con,
            """SELECT maj.message_id AS mid, a.transfer_name AS name, a.mime_type AS mime
                 FROM message_attachment_join maj
                 JOIN attachment a ON a.ROWID = maj.attachment_id
                WHERE maj.message_id IN ({marks})
                  AND COALESCE(a.transfer_name, '') NOT LIKE '%.pluginPayloadAttachment'
                ORDER BY a.ROWID""",
            [last["mid"] for last in latest.values()],
        ):
            attachments.setdefault(attachment["mid"], {
                "name": attachment["name"] or "", "mime": attachment["mime"] or "",
            })

        participants = {}
        for member in _chunked_in(
            con,
            """SELECT chj.chat_id AS cid, h.id AS handle
                 FROM chat_handle_join chj JOIN handle h ON h.ROWID = chj.handle_id
                WHERE chj.chat_id IN ({marks}) ORDER BY chj.chat_id, h.ROWID""",
            [r["cid"] for r in selected if r["style"] == 43],
        ):
            if member["handle"]:
                participants.setdefault(member["cid"], []).append(member["handle"])

        wanted_names = []
        for r in selected:
            if r["chat_identifier"] not in pin_orders:
                continue
            if r["style"] == 43:
                wanted_names.extend(participants.get(r["cid"], []))
            else:
                wanted_names.append(r["chat_identifier"])
        contact_names = unified_names(wanted_names)

        out = []
        for r in selected:
            chat_id = r["chat_identifier"]
            last = latest.get(r["cid"])
            raw_name = r["display_name"] or r["room_name"] or ""
            explicit_name = raw_name if raw_name != chat_id else ""
            pin_order = pin_orders.get(chat_id)
            pin_name = ""
            if pin_order is not None:
                if r["style"] == 43:
                    member_names = [
                        contact_names.get(handle, {}).get("short") or name_for(handle) or handle
                        for handle in participants.get(r["cid"], [])
                    ]
                    if len(member_names) == 2:
                        generated_name = " & ".join(member_names)
                    elif len(member_names) > 2:
                        generated_name = ", ".join(member_names[:-1]) + " & " + member_names[-1]
                    else:
                        generated_name = member_names[0] if member_names else ""
                    pin_name = explicit_name or generated_name
                else:
                    pin_name = contact_names.get(chat_id, {}).get("short") or ""

            out.append({
                "id": chat_id,
                "name": explicit_name or None,
                "service": r["service_name"],
                "messages": merged_counts.get(chat_id, r["n"]),
                "last": fmt_ts(r["last_date"]),
                "last_text": message_text(last) if last else "",
                "last_from_me": bool(last["is_from_me"]) if last else False,
                "last_handle": (last["handle"] if last else None) or "",
                "last_name": (None if args.no_names
                              else _dm_name(last["handle"] if last else None, r["chat_identifier"])),
                "last_attachment": attachments.get(last["mid"]) if last else None,
                "pinned": pin_order is not None,
                "pin_order": pin_order,
                "pin_name": pin_name or None,
                # Other chat rows of this same conversation. A client must fold
                # any thread carrying one of these onto this id.
                "aliases": [c for c, k in clusters.items()
                            if k == chat_id and c != chat_id][:15],
            })
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return
    for r in rows:
        name = r["display_name"] or r["room_name"] or r["chat_identifier"]
        print(f"{fmt_ts(r['last_date'])}  {r['n']:>5}  {r['service_name']:>8}  {name}")


def cmd_groups(con, args):
    """Group chats with the metadata a sender needs: the bare chat_identifier
    that appears in message rows, the full GUID that AppleScript's `chat id`
    requires (`any;+;<id>`), the display_name (empty for unnamed groups), and
    the member handles. Sending to a group MUST use --chat-id <guid>; a group
    message's `handle` is whichever member spoke last, and sending to that
    silently DMs one person."""
    rows = con.execute(
        """
        SELECT c.chat_identifier, c.guid,
               -- display_name can be blanked by an iCloud re-sync; the latest
               -- rename event (message.group_title) is the durable name.
               COALESCE(NULLIF(c.display_name, ''),
                        (SELECT m2.group_title
                           FROM chat_message_join j2 JOIN message m2 ON m2.ROWID = j2.message_id
                          WHERE j2.chat_id = c.ROWID AND m2.group_title IS NOT NULL
                          ORDER BY m2.ROWID DESC LIMIT 1),
                        '') AS display_name,
               (SELECT GROUP_CONCAT(h.id, ',')
                  FROM chat_handle_join chj JOIN handle h ON h.ROWID = chj.handle_id
                 WHERE chj.chat_id = c.ROWID) AS participants,
               (SELECT MAX(m.date)
                  FROM chat_message_join cmj JOIN message m ON m.ROWID = cmj.message_id
                 WHERE cmj.chat_id = c.ROWID) AS last_date
        FROM chat c
        WHERE c.style = 43
        ORDER BY last_date DESC""",
    ).fetchall()
    # macOS keeps one `chat` row per service, so one conversation that moved
    # from iMessage to SMS to RCS leaves several rows sharing a chat_identifier.
    # The rows it no longer uses hold zero messages, and AppleScript cannot
    # resolve one of those: `send ... to chat id "SMS;+;chat<digits>"`
    # fails with -1728, "Can't get chat id". Callers key on chat_identifier and
    # let the last row win, so an empty row can replace the live one.
    # Rows arrive newest first and SQLite sorts a NULL last_date last, so the
    # first row for an identifier is the live one. Keep it and drop the rest.
    seen = set()
    live = []
    for r in rows:
        if r["chat_identifier"] in seen:
            continue
        seen.add(r["chat_identifier"])
        live.append(r)
    rows = live[: args.n]
    if args.json:
        participant_lists = [
            (r["participants"] or "").split(",") if r["participants"] else []
            for r in rows
        ]
        contact_names = unified_names([
            handle for members in participant_lists for handle in members
        ]) if not args.no_names else {}
        print(
            json.dumps(
                [
                    {
                        "chat": r["chat_identifier"],
                        "guid": r["guid"],
                        "name": r["display_name"] or "",
                        "participants": participant_lists[index],
                        "participant_names": {
                            handle: (
                                contact_names.get(handle, {}).get("name")
                                or name_for(handle)
                                or handle
                            )
                            for handle in participant_lists[index]
                        } if not args.no_names else {},
                        "last": fmt_ts(r["last_date"]) if r["last_date"] else None,
                    }
                    for index, r in enumerate(rows)
                ],
                indent=2,
            )
        )
        return
    for r in rows:
        members = ", ".join(
            (name_for(h) if not args.no_names else None) or h
            for h in ((r["participants"] or "").split(",") if r["participants"] else [])
        )
        name = r["display_name"] or members or r["chat_identifier"]
        print(f"{fmt_ts(r['last_date']) if r['last_date'] else '':19}  {r['guid']}  {name}")


ATTACHMENTS_ROOT = os.path.expanduser("~/Library/Messages/Attachments")
# Files Blip sent: imsg-send keeps them here because Messages may leave the
# attachment row pointing at the (deleted) ~/Pictures/.blip-outbox staging path.
OUTBOX_ROOT = os.path.expanduser("~/Pictures/.blip-outbox")
SENT_ROOT = os.path.expanduser("~/.blip/sent")
ATTACH_MAX_BYTES = 100 * 1024 * 1024  # hard ceiling, deliberately no flag


def _sniff_image(head: bytes) -> str:
    if head[:2] == b"\xff\xd8":
        return "jpeg"
    if head[:8] == b"\x89PNG\r\n\x1a\n":
        return "png"
    if len(head) >= 12 and head[4:8] == b"ftyp":
        return "heic"
    return ""


def _group_cluster_map(con) -> dict:
    """chat_identifier -> canonical chat_identifier, for group rows that are
    the SAME Messages conversation split across several chat rows.

    Messages re-keys a group (a re-invite, an iCloud re-sync, a service move)
    by writing a NEW chat row: same name, same members, new chat_identifier
    and new group_id. Messages.app shows one conversation; a client that
    lists chat rows shows two ("2x Sportsball!"). Apple's own pinning plist
    agrees they are one — the pin's `o` alias points at the other row's
    original_group_id.

    Cluster key is (display_name, sorted member handles): both must match, so
    two different conversations with the same people never collapse. The
    canonical row is the one with the newest message (ties: highest ROWID),
    because that is the row Messages is writing to now.
    """
    rows = con.execute(
        f"""
        SELECT c.ROWID AS rid, c.chat_identifier AS cid,
               COALESCE(c.display_name, '') AS nm,
               (SELECT GROUP_CONCAT(h.id, ',')
                  FROM (SELECT h.id FROM chat_handle_join j JOIN handle h ON h.ROWID = j.handle_id
                         WHERE j.chat_id = c.ROWID ORDER BY h.id) h) AS parts,
               (SELECT MAX(m.date) FROM chat_message_join j JOIN {MESSAGE_SRC} m ON m.ROWID = j.message_id
                 WHERE j.chat_id = c.ROWID) AS last_date
        FROM chat c WHERE c.style = 43"""
    ).fetchall()
    best: dict = {}
    members: dict = {}
    for r in rows:
        key = (r["nm"], r["parts"] or "")
        if not key[1]:
            continue                     # no members resolved: never cluster
        members.setdefault(key, []).append(r["cid"])
        cur = best.get(key)
        rank = (r["last_date"] or -1, r["rid"])
        if cur is None or rank > cur[0]:
            best[key] = (rank, r["cid"])
    out: dict = {}
    for key, ids in members.items():
        if len(ids) < 2:
            continue
        canonical = best[key][1]
        for cid in ids:
            out[cid] = canonical
    return out


def _group_photo_chat_ids(con, chat_identifier: str) -> tuple[str, ...]:
    clusters = _group_cluster_map(con)
    canon = clusters.get(chat_identifier, chat_identifier)
    return tuple(sorted({c for c, k in clusters.items() if k == canon} | {chat_identifier, canon}))


def _group_photo_path(con, chat_identifier: str) -> str:
    """Newest group photo for a group chat, or "".

    Messages stores a group's photo as an attachment whose filename ends in
    `GroupPhotoImage` — there is no column on the chat row. Three traps, all
    hit on a real Mac:

    * The carrier message's `group_action_type` is NOT a constant. Photos set
      up to 2025-04-16 carry 3, ones from 2025-04-18 on carry 1 (an OS-version
      change, not a semantic one — no group here has any group-action event
      AFTER its photo, so neither value means "removed"). Matching on the
      filename instead of the action type is what makes both work.
    * The carrier is an announcement (`item_type = 3`), not a normal message.
      `MESSAGE_SRC` hides those rows so they never become empty unread bubbles, and
      a JOIN through it therefore finds no photo even when Messages shows one.
    * The photo can live on a SIBLING chat row. A re-keyed group has several
      rows with different chat_identifiers AND different group_ids; Fred's
      "Sportsball!" keeps its photo on the row Messages retired in Feb 2026.
      So the search spans the whole cluster, not the row it was asked about.

    `chat.properties.groupPhotoGuid` is a second index: it names the
    attachment even when `filename` is NULL on the GroupPhotoImage row.
    """
    ids = _group_photo_chat_ids(con, chat_identifier)
    placeholders = ",".join("?" for _ in ids)
    row = con.execute(
        f"""SELECT a.filename
            FROM chat c
            JOIN chat_message_join cmj ON cmj.chat_id = c.ROWID
            JOIN message m ON m.ROWID = cmj.message_id
            JOIN message_attachment_join maj ON maj.message_id = m.ROWID
            JOIN attachment a ON a.ROWID = maj.attachment_id
            WHERE (a.filename LIKE '%GroupPhotoImage'
                   OR a.transfer_name LIKE '%GroupPhotoImage')
              AND a.filename IS NOT NULL
              AND c.chat_identifier IN ({placeholders})
            ORDER BY m.date DESC LIMIT 1""",
        ids,
    ).fetchone()
    if row and row["filename"]:
        return os.path.expanduser(row["filename"])
    for r in con.execute(
        f"SELECT properties FROM chat WHERE chat_identifier IN ({placeholders}) AND properties IS NOT NULL",
        ids,
    ):
        try:
            blob = plistlib.loads(r["properties"])
        except (plistlib.InvalidFileException, ValueError, TypeError, OSError):
            continue
        guid = blob.get("groupPhotoGuid") if isinstance(blob, dict) else None
        if not isinstance(guid, str) or not guid:
            continue
        hit = con.execute(
            "SELECT filename FROM attachment WHERE filename IS NOT NULL AND (guid = ? OR original_guid = ?) LIMIT 1",
            (guid, guid),
        ).fetchone()
        if hit and hit["filename"]:
            return os.path.expanduser(hit["filename"])
    return ""


GROUP_PHOTO_MAX_DIM = 512  # avatars are drawn ~40–80 px; Linux also caps at 2 MB


def _stream_group_photo(con, chat_identifier: str) -> None:
    """`imsg avatar --chat <id>`: the group's own photo as JPEG bytes.
    Same hardening as `attachment`: id shape checked, path confined to the
    Messages store (commonpath), regular file, size ceiling. Always resampled
    through sips to JPEG at GROUP_PHOTO_MAX_DIM so a multi-megabyte PNG still
    fits the Linux avatar cache. Exit 1 when the group has none."""
    import stat as stat_mod
    import subprocess
    import tempfile
    if not re.fullmatch(r"[0-9a-fA-F]{32}|chat[0-9]{1,20}", chat_identifier):
        sys.exit("error: bad group id")
    raw = _group_photo_path(con, chat_identifier)
    if not raw:
        sys.exit(1)
    path = os.path.realpath(raw)
    root = os.path.realpath(ATTACHMENTS_ROOT)
    if os.path.commonpath([path, root]) != root:
        sys.exit("error: group photo path escapes the Messages store")
    try:
        st = os.lstat(path)
    except OSError:
        sys.exit(1)
    if not stat_mod.S_ISREG(st.st_mode) or st.st_size > ATTACH_MAX_BYTES:
        sys.exit(1)
    fd_t, tmp = tempfile.mkstemp(suffix=".jpg")
    os.close(fd_t)
    try:
        try:
            r = subprocess.run(
                ["sips", "-Z", str(GROUP_PHOTO_MAX_DIM), "-s", "format", "jpeg", path, "--out", tmp],
                capture_output=True, timeout=60,
            )
        except subprocess.TimeoutExpired:
            sys.exit("error: sips conversion timed out")
        if r.returncode != 0:
            sys.exit(1)
        with open(tmp, "rb") as f:
            data = f.read(ATTACH_MAX_BYTES + 1)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass
    if not data or len(data) > ATTACH_MAX_BYTES:
        sys.exit(1)
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()


# JPEG, PNG, GIF. Qt renders all three, and all three turn up in AddressBook.
_IMAGE_MAGIC = (b"\xff\xd8", b"\x89PNG", b"GIF8")
_AVATAR_MAX = 2 * 1024 * 1024


def _unwrap_image(data: bytes) -> bytes:
    """Image bytes from an AddressBook blob, or b"" if it is not an image.

    Core Data tags an inline binary attribute with ONE leading byte, and on
    every Mac we have looked at that byte is 0x01 — `01FFD8FF…`, `0189504E…`,
    `01474946…`. The old check demanded that the blob START with the magic, so
    every inline photo was thrown away and only external-storage records (the
    0x02 form, handled below) ever produced a picture. Reported by @dreinecke
    in #16, where NONE resolved; on the maintainer's Mac 333 of 346 thumbnails
    were being discarded, which is why it looked like it worked.
    """
    if data[:1] == b"\x01" and data[1:5].startswith(_IMAGE_MAGIC):
        data = data[1:]
    return data if data.startswith(_IMAGE_MAGIC) else b""


def _avatar_bytes(db_path: str, pk: int) -> bytes:
    """Photo bytes for one AddressBook record, or b"". Tries the thumbnail,
    then the full image. Either column may hold the bytes inline (optionally
    behind a 0x01 Core Data tag byte) OR an external-storage reference
    (\x02<UUID>\x00) naming a file under
    <Source>/.AddressBook-v22_SUPPORT/_EXTERNAL_DATA/."""
    try:
        con2 = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        row = con2.execute(
            "SELECT ZTHUMBNAILIMAGEDATA, ZIMAGEDATA FROM ZABCDRECORD WHERE Z_PK = ?", (pk,)
        ).fetchone()
        con2.close()
    except sqlite3.DatabaseError:
        return b""
    ext_dir = os.path.realpath(os.path.join(os.path.dirname(db_path), ".AddressBook-v22_SUPPORT", "_EXTERNAL_DATA"))
    for col in (row or ()):
        data = bytes(col) if col is not None else b""
        if not data:
            continue
        unwrapped = _unwrap_image(data)
        if unwrapped:
            data = unwrapped
        else:
            mref = re.search(r"[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}",
                             data.decode("latin-1"))
            if not mref:
                continue
            fp = os.path.realpath(os.path.join(ext_dir, mref.group(0)))
            if os.path.commonpath([fp, ext_dir]) != ext_dir:
                continue
            try:
                with open(fp, "rb") as f:
                    data = _unwrap_image(f.read(_AVATAR_MAX + 1))
            except OSError:
                continue
        if data and len(data) <= _AVATAR_MAX:
            return data
    return b""


def cmd_avatar(con, args):
    """Stream a contact's photo (JPEG/PNG bytes) for one handle to stdout.
    The same person usually exists in SEVERAL sources (iCloud, Exchange, On
    My Mac) — those are candidates, not ambiguity; the first with a photo
    wins. Two DIFFERENT records within one source sharing the key is
    ambiguous → no photo (mirrors name_for). Exit 1 when nothing found."""
    if getattr(args, "chat", ""):
        _stream_group_photo(con, args.chat.strip())
        return
    handle = (args.handle or "").strip()
    if not handle or len(handle) > 320:
        sys.exit("error: bad handle")
    for path, pk in _avatar_candidates(handle):
        data = _avatar_bytes(path, pk)
        if data:
            sys.stdout.buffer.write(data)
            sys.stdout.buffer.flush()
            return
    sys.exit(1)


def _avatar_candidates(handle: str) -> list[tuple[str, int]]:
    """(source db, record pk) per source that names this handle unambiguously,
    nearest source first. The exact key decides when it hits; the region-aware
    match only runs in a source with no exact hit — the rule name_for applies."""
    want_email = "@" in handle
    key = handle.lower() if want_email else _normalize_phone(handle)
    if not key:
        return []
    parsed = None if want_email else _parse_phone(handle)
    exact_cands: list[tuple[str, int]] = []
    near_cands: list[tuple[str, int]] = []
    for path in _ab_sources():
        try:
            con2 = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
            q = ("SELECT ZOWNER AS pk, ZADDRESS AS v FROM ZABCDEMAILADDRESS" if want_email
                 else "SELECT ZOWNER AS pk, ZFULLNUMBER AS v FROM ZABCDPHONENUMBER")
            exact: set[int] = set()
            near: set[int] = set()
            for pk, v in con2.execute(q):
                if pk is None:
                    continue
                if want_email:
                    if (v or "").strip().lower() == key:
                        exact.add(pk)
                elif _normalize_phone(v or "") == key:
                    exact.add(pk)
                elif parsed and (card := _parse_phone(v or "")) and _same_number(parsed, card):
                    near.add(pk)
            con2.close()
        except sqlite3.DatabaseError:
            continue
        # len > 1 inside ONE source: ambiguous there — skip that source only
        if len(exact) == 1:
            exact_cands.append((path, exact.pop()))
        elif not exact and len(near) == 1:
            near_cands.append((path, near.pop()))
    # The exact key decides whenever ANY source has it — the rule name_for
    # applies globally. Per-source `exact or near` let a nearer source's
    # suffix card put its photo on a conversation named after another source's
    # exact card (Astra #3). Suffix matches only when nothing is exact.
    return exact_cands if exact_cands else near_cands


def cmd_attachment(con, args):
    """Stream one attachment's bytes to stdout, for a remote client to cache.

    Hardening (the id comes from an untrusted client over ssh):
    - decimal-only id;
    - the attachment must join to a VISIBLE message (the Recently Deleted
      filter applies — a deleted conversation's media must not be fetchable);
    - the resolved file must live under ~/Library/Messages/Attachments
      (commonpath, not string prefix), be a regular file opened O_NOFOLLOW,
      and the DESCRIPTOR is streamed after fstat — no reopen-by-path window;
    - hard 100 MB ceiling, checked on the fstat'd size and again while
      streaming in case the file grows.
    --jpeg converts image/* (HEIC in practice) through sips first so the
    Linux side never needs an HEIC decoder. --max-dim N additionally resamples
    to N pixels on the long edge: an inline preview is drawn at ~800 px, and a
    full-resolution iPhone HEIC becomes a JPEG roughly HALF AGAIN AS BIG as the
    source (5.07 MB HEIC → 7.80 MB JPEG, measured), which is how photos ended
    up too large to auto-load. Clicking one still fetches it whole.
    """
    if not re.fullmatch(r"[0-9]{1,18}", args.id):
        sys.exit("error: attachment id must be decimal digits")
    row = con.execute(
        f"""SELECT a.filename, a.mime_type
            FROM attachment a
            JOIN message_attachment_join maj ON maj.attachment_id = a.ROWID
            JOIN {MESSAGE_SRC} m ON m.ROWID = maj.message_id
            WHERE a.ROWID = ? AND a.transfer_name IS NOT NULL
            LIMIT 1""",
        (int(args.id),),
    ).fetchone()
    if not row or not row["filename"]:
        sys.exit("error: no such visible attachment")

    raw = os.path.expanduser(row["filename"])
    outbox = os.path.realpath(OUTBOX_ROOT)
    if os.path.commonpath([os.path.realpath(raw), outbox]) == outbox and not os.path.exists(raw):
        raw = os.path.join(SENT_ROOT, os.path.relpath(os.path.realpath(raw), outbox))
    path = os.path.realpath(raw)
    roots = [os.path.realpath(ATTACHMENTS_ROOT), os.path.realpath(SENT_ROOT)]
    if not any(os.path.commonpath([path, r]) == r for r in roots):
        sys.exit("error: attachment path escapes the Messages store")

    # Ceiling applies to the SOURCE before any conversion — sips must not be
    # fed an arbitrarily large input just because its output would shrink.
    try:
        if os.lstat(path).st_size > ATTACH_MAX_BYTES:
            sys.exit(f"error: attachment exceeds {ATTACH_MAX_BYTES} bytes")
    except OSError:
        sys.exit("error: attachment file missing on disk")

    src = path
    tmp = None
    if args.jpeg and (row["mime_type"] or "").startswith("image/"):
        import subprocess
        import tempfile

        fd_t, tmp = tempfile.mkstemp(suffix=".jpg")
        os.close(fd_t)
        cmd = ["sips", "-s", "format", "jpeg"]
        if getattr(args, "max_dim", 0):
            # -Z is "resample, longest edge, preserve aspect"; it never upscales.
            cmd += ["-Z", str(int(args.max_dim)), "-s", "formatOptions", "80"]
        cmd += [path, "--out", tmp]
        try:
            r = subprocess.run(cmd, capture_output=True, timeout=60)
        except subprocess.TimeoutExpired:
            os.unlink(tmp)   # never leave a converted copy in $TMPDIR
            sys.exit("error: sips conversion timed out")
        if r.returncode != 0:
            os.unlink(tmp)
            sys.exit(f"error: sips conversion failed: {r.stderr.decode()[:200]}")
        src = tmp

    try:
        fd = os.open(src, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        try:
            st = os.fstat(fd)
            import stat as stat_mod

            if not stat_mod.S_ISREG(st.st_mode):
                sys.exit("error: not a regular file")
            # Close the reopen-by-path window: the DESCRIPTOR we stream must
            # be the same inode the validated path resolves to right now.
            # (Residual: sips above reopens by path; the store is Apple-owned
            # 0700, so parent-swap there requires owning the account anyway.)
            st_now = os.stat(src)
            if (st.st_dev, st.st_ino) != (st_now.st_dev, st_now.st_ino):
                sys.exit("error: attachment changed identity mid-read")
            if st.st_size > ATTACH_MAX_BYTES:
                sys.exit(f"error: attachment exceeds {ATTACH_MAX_BYTES} bytes")
            sent = 0
            while True:
                chunk = os.read(fd, 1 << 20)
                if not chunk:
                    break
                sent += len(chunk)
                if sent > ATTACH_MAX_BYTES:
                    sys.exit("error: file grew past the ceiling mid-stream")
                sys.stdout.buffer.write(chunk)
            sys.stdout.buffer.flush()
        finally:
            os.close(fd)
    finally:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def cmd_watch(con, args):
    """Block forever, emitting one line whenever chat.db changes — a push
    channel for remote clients (Blip) that otherwise poll.

    The line is just a unix timestamp: an INVALIDATION, never content —
    anything sniffing the stream learns only "a message happened". Detection
    is mtime on chat.db and its WAL (every Messages write touches the WAL;
    checkpoints touch the db), sampled every 0.4 s — a local stat is
    microseconds, so this is effectively free and needs no fswatch install.
    Exits on SIGPIPE/BrokenPipeError when the consumer (the ssh session)
    goes away."""
    import time

    wal = DB_PATH + "-wal"

    def sig():
        try:
            s = os.stat(DB_PATH).st_mtime_ns
        except OSError:
            return None
        try:
            w = os.stat(wal).st_mtime_ns
        except OSError:
            w = 0
        return (s, w)

    last = sig()
    print("ready", flush=True)
    ticks = 0
    try:
        while True:
            time.sleep(0.4)
            cur = sig()
            if cur != last:
                last = cur
                print(int(time.time()), flush=True)
            # Heartbeat every ~30s: a half-open ssh channel emits nothing
            # forever, and a silent stream is indistinguishable from a quiet
            # evening — the client needs a liveness signal to time out on.
            ticks += 1
            if ticks >= 75:
                ticks = 0
                print("hb", flush=True)
    except BrokenPipeError:
        pass


def cmd_analyze(con, args):
    """Relationship-arc analysis for one handle: lifetime totals, by-month,
    hour-of-day, initiation balance, late-night ratio, message length.
    Surface the data; you (the human or the agent) write the narrative."""
    like = f"%{args.handle}%"
    APPLE_NS_TO_UNIX = "date/1000000000+978307200"

    totals = con.execute(f"""
        SELECT COUNT(*) AS total,
               SUM(CASE WHEN m.is_from_me=1 THEN 1 ELSE 0 END) AS sent_by_me,
               SUM(CASE WHEN m.is_from_me=0 THEN 1 ELSE 0 END) AS sent_by_them,
               date(MIN(m.date)/1000000000+978307200,'unixepoch','localtime') AS earliest,
               date(MAX(m.date)/1000000000+978307200,'unixepoch','localtime') AS latest
        FROM message m JOIN handle h ON h.ROWID=m.handle_id
        WHERE h.id LIKE ?""", (like,)).fetchone()
    if not totals or totals["total"] == 0:
        sys.exit(f"no messages found for handle matching {args.handle!r}")

    monthly = con.execute(f"""
        SELECT strftime('%Y-%m', {APPLE_NS_TO_UNIX}, 'unixepoch','localtime') AS mo,
               SUM(CASE WHEN m.is_from_me=1 THEN 1 ELSE 0 END) AS me,
               SUM(CASE WHEN m.is_from_me=0 THEN 1 ELSE 0 END) AS them,
               COUNT(*) AS total
        FROM message m JOIN handle h ON h.ROWID=m.handle_id
        WHERE h.id LIKE ?
        GROUP BY mo ORDER BY mo""", (like,)).fetchall()

    hourly = con.execute(f"""
        SELECT strftime('%H', {APPLE_NS_TO_UNIX}, 'unixepoch','localtime') AS hr,
               SUM(CASE WHEN m.is_from_me=1 THEN 1 ELSE 0 END) AS me,
               SUM(CASE WHEN m.is_from_me=0 THEN 1 ELSE 0 END) AS them
        FROM message m JOIN handle h ON h.ROWID=m.handle_id
        WHERE h.id LIKE ?
        GROUP BY hr ORDER BY hr""", (like,)).fetchall()

    init = con.execute(f"""
        WITH daily AS (
          SELECT date({APPLE_NS_TO_UNIX},'unixepoch','localtime') AS day,
                 m.is_from_me, m.date
          FROM message m JOIN handle h ON h.ROWID=m.handle_id
          WHERE h.id LIKE ?),
        first_per_day AS (
          SELECT day, is_from_me,
                 ROW_NUMBER() OVER (PARTITION BY day ORDER BY date ASC) rn
          FROM daily)
        SELECT SUM(CASE WHEN is_from_me=1 THEN 1 ELSE 0 END) AS me_first,
               SUM(CASE WHEN is_from_me=0 THEN 1 ELSE 0 END) AS them_first,
               COUNT(*) AS active_days
        FROM first_per_day WHERE rn=1""", (like,)).fetchone()

    late = con.execute(f"""
        SELECT COUNT(*) AS n
        FROM message m JOIN handle h ON h.ROWID=m.handle_id
        WHERE h.id LIKE ?
          AND CAST(strftime('%H',{APPLE_NS_TO_UNIX},'unixepoch','localtime') AS INT)
              IN (22, 23, 0, 1, 2, 3)""", (like,)).fetchone()

    avg_len = con.execute("""
        SELECT m.is_from_me,
               AVG(length(COALESCE(m.text,'')) + length(COALESCE(m.attributedBody,''))) AS avg_len
        FROM message m JOIN handle h ON h.ROWID=m.handle_id
        WHERE h.id LIKE ?
        GROUP BY m.is_from_me""", (like,)).fetchall()
    me_len = next((r["avg_len"] for r in avg_len if r["is_from_me"] == 1), 0)
    them_len = next((r["avg_len"] for r in avg_len if r["is_from_me"] == 0), 0)

    contact_name = name_for(args.handle) or "(no contact match)"

    if args.json:
        out = {
            "handle": args.handle,
            "contact_name": contact_name,
            "lifetime": dict(totals),
            "monthly": [dict(r) for r in monthly],
            "hourly":  [dict(r) for r in hourly],
            "initiation": dict(init) if init else {},
            "late_night_msgs_22_to_03": late["n"] if late else 0,
            "late_night_pct": round((late["n"] / totals["total"] * 100) if totals["total"] else 0, 1),
            "avg_msg_len_me":   round(me_len or 0, 1),
            "avg_msg_len_them": round(them_len or 0, 1),
        }
        print(json.dumps(out, indent=2))
        return

    print(f"\n  Handle: {args.handle}   Contact: {contact_name}")
    print(f"  Lifetime: {totals['total']} msgs   you sent {totals['sent_by_me']}   they sent {totals['sent_by_them']}")
    print(f"  Date range: {totals['earliest']}  to  {totals['latest']}")
    if init and init["active_days"]:
        pct_me   = round(100 * init["me_first"]   / init["active_days"])
        pct_them = round(100 * init["them_first"] / init["active_days"])
        print(f"  Initiation (first msg of day): you {init['me_first']} ({pct_me}%)   them {init['them_first']} ({pct_them}%)   over {init['active_days']} active days")
    if late and totals["total"]:
        pct = round(100 * late["n"] / totals["total"], 1)
        print(f"  Late-night (22:00 to 03:00): {late['n']} msgs ({pct}% of all)")
    print(f"  Avg msg length: you {round(me_len or 0):>4} chars   them {round(them_len or 0):>4} chars")

    print("\n  Monthly cadence:")
    print(f"  {'month':<8}  {'you':>5}  {'them':>5}  {'total':>5}")
    for r in monthly:
        print(f"  {r['mo']:<8}  {r['me']:>5}  {r['them']:>5}  {r['total']:>5}")

    print("\n  Hour-of-day distribution (when you talk):")
    max_n = max((r["me"] + r["them"]) for r in hourly) or 1
    for r in hourly:
        n = r["me"] + r["them"]
        bar = "█" * int(40 * n / max_n)
        print(f"  {r['hr']}h  {bar:<40}  {n:>4}  (you {r['me']:>3} / them {r['them']:>3})")
    print()


def main() -> None:
    p = argparse.ArgumentParser(prog="imsg", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    # Top-level convenience flags (also added to each subparser via parents=
    # so they work POST-subcommand, e.g. `imsg from "+1..." 6 --chrono`)
    # These live on BOTH the parent (so they parse before the subcommand) and on
    # each subparser via parents=[common] (so they parse after it). The subparser
    # copies MUST default to SUPPRESS: a plain store_true defaults to False, and
    # the subparser writes that False into the namespace AFTER the parent already
    # set True for a pre-subcommand flag -- silently clobbering it, so
    # `imsg --json recent 5` was ignored. With SUPPRESS the subparser only sets
    # these when the flag actually appears after the subcommand; otherwise the
    # parent's value survives. The parent copies keep a real False default so the
    # attributes always exist.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="emit JSON")
    common.add_argument("--chrono", action="store_true", default=argparse.SUPPRESS,
                        help="print oldest to newest instead of newest to oldest")
    common.add_argument("--no-names", action="store_true", default=argparse.SUPPRESS,
                        help="do not resolve handles via Contacts")
    common.add_argument("--rich", action="store_true", default=argparse.SUPPRESS,
                        help="JSON only: fold tapbacks onto their targets and add "
                             "read_at/edited/retracted/reply_to/attachments/effect/audio")
    # also accept on the parent for `imsg --json recent 5` style
    p.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--chrono", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--no-names", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--rich", action="store_true", help=argparse.SUPPRESS)

    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("recent",   parents=[common]); s.add_argument("n", nargs="?", type=int, default=20); s.set_defaults(func=cmd_recent)
    s = sub.add_parser("from",     parents=[common]); s.add_argument("handle"); s.add_argument("n", nargs="?", type=int, default=50); s.set_defaults(func=cmd_from)
    s = sub.add_parser("thread",   parents=[common]); s.add_argument("handle", nargs="?", default=""); s.add_argument("n", nargs="?", type=int, default=50); s.add_argument("--chat", default="", help="exact chat_identifier (groups: 32-hex / chat<digits>)"); s.set_defaults(func=cmd_thread)
    s = sub.add_parser("search",   parents=[common]); s.add_argument("query"); s.add_argument("n", nargs="?", type=int, default=50); s.set_defaults(func=cmd_search)
    s = sub.add_parser("contacts", parents=[common]); s.add_argument("n", nargs="?", type=int, default=30); s.set_defaults(func=cmd_contacts)
    s = sub.add_parser("chats",    parents=[common]); s.add_argument("n", nargs="?", type=int, default=30); s.set_defaults(func=cmd_chats)
    s = sub.add_parser("groups",   parents=[common]); s.add_argument("n", nargs="?", type=int, default=2000); s.set_defaults(func=cmd_groups)
    s = sub.add_parser("analyze",  parents=[common],
                       help="relationship arc analysis for one handle")
    s.add_argument("handle")
    s.set_defaults(func=cmd_analyze)
    s = sub.add_parser("attachment", parents=[common],
                       help="stream one attachment's bytes to stdout (id from --rich)")
    s.add_argument("id")
    s.add_argument("--jpeg", action="store_true",
                   help="convert image/* (HEIC) to JPEG via sips before streaming")
    s.add_argument("--max-dim", type=int, default=0, dest="max_dim",
                   help="with --jpeg, resample to N px on the long edge (inline previews)")
    s.set_defaults(func=cmd_attachment)
    s = sub.add_parser("avatar", parents=[common], help="stream a contact photo (JPEG) for a handle, or a group's own photo with --chat")
    s.add_argument("handle", nargs="?", default="")
    s.add_argument("--chat", default="", help="group chat_identifier (32-hex / chat<digits>): stream its GroupPhotoImage")
    s.set_defaults(func=cmd_avatar)
    s = sub.add_parser("watch", parents=[common],
                       help="emit a line whenever chat.db changes (push channel)")
    s.set_defaults(func=cmd_watch)

    args = p.parse_args()
    with open_db() as con:
        args.func(con, args)


if __name__ == "__main__":
    main()
