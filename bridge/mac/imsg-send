#!/usr/bin/env python3
"""
imsg-send: send an iMessage / SMS / RCS via Messages.app (AppleScript bridge).

█ HARD RULE
█ This tool is consent-gated. It defaults to DRY-RUN. You MUST pass --yes for
█ each individual send. Auto modes, batch loops, and "approved earlier" do NOT
█ override the per-send authorization. See CONSENT.md in the repo root.

Usage:
  imsg-send --to <handle> [--service iMessage|SMS|RCS] [--yes] <text>...
  imsg-send --chat-id <chat-guid> [--yes] <text>...
  imsg-send --self [--yes] <text>...                 # send to your own iMessage
  imsg-send --list-services
  imsg-send --list-self                              # show auto-detected self handles

Examples:
  imsg-send --to +15551234567 "On my way"            # dry run, prints AppleScript
  imsg-send --to +15551234567 --yes "On my way"      # actually sends iMessage
  imsg-send --to alice@icloud.com --yes "hi"         # send to email handle
  imsg-send --self --yes "test from claude"          # send to yourself

Safety:
  * No --yes => dry run, prints the AppleScript that would have run
  * Refuses empty messages and messages > 4000 chars (Messages will fragment longer)
  * Verifies a prior chat exists before SMS/RCS sends (those need iPhone Continuity)
  * Auto-scrubs em/en dashes from outbound text (--keep-dashes overrides)
  * Loud per-send authorization banner before transmit

How it works:
  Calls osascript with `tell application "Messages" to send <text> to participant
  <handle> of service <id>`. Discovers the right service id by enumerating Messages
  services and matching service type. Self-handles auto-detected from chat.db.
"""

from __future__ import annotations

import argparse
import os
import re
import sqlite3
import subprocess
import sys

CHAT_DB = os.path.expanduser("~/Library/Messages/chat.db")
MAX_LEN = 4000

# Per the no-dashes editorial rule (see CONSENT.md). Override with --keep-dashes.
DASH_CHARS = ("\u2014", "\u2013", "\u2015")  # em, en, horizontal-bar


def scrub_dashes(text: str) -> tuple[str, int]:
    """Replace em/en/horizontal-bar dashes (and `--`) with `, `, eating
    surrounding whitespace so the result reads cleanly."""
    n = sum(text.count(ch) for ch in DASH_CHARS) + len(re.findall(r"\s*--\s*", text))
    out = re.sub(r"\s*[\u2014\u2013\u2015]\s*", ", ", text)
    out = re.sub(r"\s*--\s*", ", ", out)
    out = re.sub(r",\s*,", ",", out)
    return out, n


def detect_self_handles() -> list[str]:
    """Read chat.db to find the current user's own iMessage / SMS handles
    (account_login + destination_caller_id columns on outgoing messages)."""
    if not os.path.exists(CHAT_DB):
        return []
    try:
        con = sqlite3.connect(f"file:{CHAT_DB}?mode=ro", uri=True)
    except sqlite3.DatabaseError:
        return []
    handles: list[str] = []
    seen: set[str] = set()
    for col in ("destination_caller_id", "account"):
        try:
            for (val,) in con.execute(
                f"SELECT DISTINCT {col} FROM message "
                "WHERE is_from_me=1 AND " f"{col} IS NOT NULL AND " f"{col} != ''"
            ):
                # 'account' rows look like "E:address" or "P:phone"; strip the prefix
                v = val.split(":", 1)[1] if ":" in val and val[1:2] == ":" else val
                v = v.strip()
                # RCS service rows prefix phone numbers with 'tel:'; strip it.
                if v.startswith("tel:"):
                    v = v[4:]
                if v and v not in seen:
                    seen.add(v)
                    handles.append(v)
        except sqlite3.DatabaseError:
            continue
    con.close()
    return handles


# An unanswered Automation prompt becomes a denial after about two minutes.
OSASCRIPT_TIMEOUT = 150
AUTOMATION_TIMEOUT = (
    "Messages did not answer. On the Mac, allow Automation for the process "
    "that runs Blip, then send again."
)


def run_osascript(args: list[str], script: str | None = None) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            args, input=script, capture_output=True, text=True, timeout=OSASCRIPT_TIMEOUT
        )
    except subprocess.TimeoutExpired:
        sys.exit(AUTOMATION_TIMEOUT)


def list_services() -> list[dict]:
    """Enumerate Messages services. Some macOS versions reject `name of`,
    so we ask per-service and skip ones that error."""
    src = """
    tell application "Messages"
      set out to ""
      repeat with s in services
        try
          set out to out & (id of s) & "|" & (service type of s as text) & linefeed
        end try
      end repeat
      return out
    end tell
    """
    proc = run_osascript(["osascript", "-e", src])
    if proc.returncode != 0:
        sys.exit(f"osascript error: {proc.stderr.strip()}")
    services = []
    for line in proc.stdout.splitlines():
        if "|" in line:
            sid, stype = line.split("|", 1)
            services.append({"id": sid.strip(), "type": stype.strip()})
    return services


def find_service_id(stype: str) -> str:
    services = list_services()
    matches = [s for s in services if s["type"].lower() == stype.lower()]
    if not matches:
        sys.exit(
            f"No Messages service of type {stype!r} found. "
            f"Available: {[s['type'] for s in services]}"
        )
    return matches[0]["id"]


# ---------- file attachments (Sequoia Pictures-folder staging) ----------
#
# `send POSIX file` silently fails on Sequoia (message shows "Not Delivered",
# chat.db error=25) from ~/Documents, ~/Desktop, /tmp — anywhere EXCEPT the
# Pictures folder (macscripter.net/t/sequoia-messages-send-file/76468).
# A dot-subfolder of Pictures works too (verified 2026-08-31: state=5, sent=1).
# Messages copies the file into ~/Library/Messages/Attachments before upload,
# so the staged copy can be deleted as soon as the send returns.
#
# Files arrive on STDIN, never as a Mac filesystem path: accepting arbitrary
# paths would let any remote caller exfiltrate any readable Mac file.

OUTBOX = os.path.expanduser("~/Pictures/.blip-outbox")
MAX_FILE_BYTES = 100 * 1024 * 1024  # hard server-side ceiling, no override
OUTBOX_GC_SECONDS = 3600
# Files Blip sent are KEPT here (same <sendid>/<name> subpath as the outbox):
# for a remote recipient Messages often leaves the attachment row pointing at
# the outbox path instead of copying into its own store, so deleting the
# staged file made every photo Blip sent un-showable in Blip forever.
# `imsg attachment` resolves a missing outbox path to this copy. LRU-capped.
SENT = os.path.expanduser("~/.blip/sent")
SENT_CAP_BYTES = 200 * 1024 * 1024
SAFE_NAME_RE = re.compile(r"[^A-Za-z0-9._ -]")


def as_q(s: str) -> str:
    """Escape a value for interpolation into a double-quoted AppleScript
    string. Backslash FIRST, then quote — quoting alone lets `\\"` terminate
    the string and inject script."""
    return s.replace("\\", "\\\\").replace('"', '\\"')


def _checked_outbox() -> str:
    """The outbox must be a real directory we own — a symlink here would turn
    gc_outbox into an arbitrary-delete primitive."""
    import stat as stat_mod

    os.makedirs(OUTBOX, mode=0o700, exist_ok=True)
    st = os.lstat(OUTBOX)
    if stat_mod.S_ISLNK(st.st_mode) or not stat_mod.S_ISDIR(st.st_mode):
        sys.exit("error: outbox is not a real directory")
    if st.st_uid != os.getuid():
        sys.exit("error: outbox is not owned by this user")
    return OUTBOX


def stage_stdin_file(name: str, expected: int = 0) -> str:
    """Read the attachment from stdin into a fresh per-send subdirectory of
    the Pictures outbox, KEEPING the caller's filename (it is what the
    recipient sees). Refuses > MAX_FILE_BYTES while streaming. A two-level
    subfolder of ~/Pictures still passes the Sequoia send quirk (verified
    2026-08-31: state=5, sent=1)."""
    import uuid

    raw = os.path.basename(name or "file")
    stem, ext = os.path.splitext(raw)
    ext = SAFE_NAME_RE.sub("", ext)[:12]          # keep the extension the recipient sees
    base = (SAFE_NAME_RE.sub("_", stem)[:120 - len(ext)].strip(". ") or "file") + ext
    outbox = _checked_outbox()
    gc_outbox()
    d = os.path.join(outbox, uuid.uuid4().hex[:12])
    os.mkdir(d, 0o700)
    path = os.path.join(d, base)
    total = 0
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "wb") as f:
            while True:
                chunk = sys.stdin.buffer.read(1 << 20)
                if not chunk:
                    break
                total += len(chunk)
                if total > MAX_FILE_BYTES:
                    raise SystemExit(f"error: attachment exceeds {MAX_FILE_BYTES} bytes")
                f.write(chunk)
    except BaseException:
        unstage(path)
        raise
    if total == 0:
        unstage(path)
        sys.exit("error: empty attachment on stdin")
    if expected and total != expected:
        # a cut ssh stream must never become a truncated photo in someone's Messages
        unstage(path)
        sys.exit(f"error: short file on stdin ({total} of {expected} bytes) — not sent")
    return path


def _max_attachment_rowid() -> int:
    try:
        con = sqlite3.connect(f"file:{CHAT_DB}?mode=ro", uri=True)
        row = con.execute("SELECT COALESCE(MAX(ROWID), 0) FROM attachment").fetchone()
        con.close()
        return int(row[0] or 0)
    except (sqlite3.DatabaseError, OSError):
        return 0


def wait_for_copy(staged: str, baseline: int = 0, timeout: float = 20.0, chat_ident: str | None = None) -> tuple[bool, int]:
    """After `send POSIX file`, Messages copies the staged file into its own
    Attachments store — but for a REMOTE recipient that copy (and the upload
    that reads it) can lag several seconds. Deleting the staged file the
    moment osascript returns worked for self-sends and silently broke real
    ones (error 25, "Not Delivered" — found live 2026-08-31, exactly the
    race the design review warned about).

    Polls chat.db until an attachment row for our basename points at an
    EXISTING file that is not the staged path. Returns (copy_exists,
    message_error). On timeout the staged file must be LEFT for the hourly
    GC rather than yanked out from under an in-flight upload."""
    import time

    base = os.path.basename(staged)
    staged_real = os.path.realpath(staged)
    deadline = time.time() + timeout
    err = 0
    while time.time() < deadline:
        try:
            con = sqlite3.connect(f"file:{CHAT_DB}?mode=ro", uri=True)
            row = con.execute(
                # Correlated with THIS send's conversation: two overlapping sends
                # of image.png used to read each other's rows, and one deleted
                # the other's staged file on a stray error=25 (Astra C#3).
                """SELECT a.filename, m.error FROM attachment a
                   JOIN message_attachment_join maj ON maj.attachment_id = a.ROWID
                   JOIN message m ON m.ROWID = maj.message_id
                   JOIN chat_message_join cmj ON cmj.message_id = m.ROWID
                   JOIN chat c ON c.ROWID = cmj.chat_id
                   WHERE a.transfer_name = ? AND m.is_from_me = 1 AND a.ROWID > ?
                     AND (? IS NULL OR c.chat_identifier = ?)
                   ORDER BY a.ROWID DESC LIMIT 1""",
                (base, baseline, chat_ident, chat_ident),
            ).fetchone()
            con.close()
            if row:
                err = int(row[1] or 0)
                if err:
                    return (False, err)
                p = os.path.expanduser(row[0] or "")
                if p and os.path.exists(p) and os.path.realpath(p) != staged_real:
                    return (True, 0)
        except (sqlite3.DatabaseError, OSError, ValueError):
            pass
        time.sleep(0.5)
    return (False, err)


def keep_sent(path: str) -> None:
    """Move a staged per-send directory into ~/.blip/sent (never follows
    symlinks; falls back to unstage on any error) and LRU-sweep the store."""
    import shutil
    import stat as stat_mod
    import time

    d = os.path.dirname(path)
    try:
        os.makedirs(SENT, mode=0o700, exist_ok=True)
        st = os.lstat(SENT)
        if stat_mod.S_ISLNK(st.st_mode) or not stat_mod.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
            raise OSError("sent store is not a real directory we own")
        if os.path.lexists(os.path.join(SENT, os.path.basename(d))):
            raise OSError("collision")
        shutil.move(d, os.path.join(SENT, os.path.basename(d)))
    except (OSError, shutil.Error):
        unstage(path)
        return
    # LRU: oldest per-send dirs go first once the store exceeds the cap.
    try:
        entries = []
        for e in os.scandir(SENT):
            if not e.is_dir(follow_symlinks=False):
                continue
            size = sum(f.stat(follow_symlinks=False).st_size for f in os.scandir(e.path) if f.is_file(follow_symlinks=False))
            entries.append((e.stat(follow_symlinks=False).st_mtime, size, e.path))
        total = sum(s for _, s, _ in entries)
        for _, size, p in sorted(entries):
            if total <= SENT_CAP_BYTES:
                break
            shutil.rmtree(p, ignore_errors=True)
            total -= size
    except OSError:
        pass


def unstage(path: str) -> None:
    """Remove a staged file and its per-send directory."""
    try:
        os.unlink(path)
    except OSError:
        pass
    try:
        os.rmdir(os.path.dirname(path))
    except OSError:
        pass


def gc_outbox() -> None:
    """Remove staged leftovers older than an hour (crashed prior runs):
    per-send subdirectories and legacy flat files. Never follows symlinks."""
    import time

    now = time.time()
    try:
        for entry in os.scandir(OUTBOX):
            try:
                if now - entry.stat(follow_symlinks=False).st_mtime <= OUTBOX_GC_SECONDS:
                    continue
                if entry.is_file(follow_symlinks=False):
                    os.unlink(entry.path)
                elif entry.is_dir(follow_symlinks=False):
                    # a send whose copy was never observed: keep it servable
                    # (~/.blip/sent) instead of deleting the only copy
                    files = [f for f in os.scandir(entry.path) if f.is_file(follow_symlinks=False)]
                    if files:
                        keep_sent(files[0].path)
                    else:
                        os.rmdir(entry.path)
            except OSError:
                continue
    except OSError:
        pass


def applescript_send_file_participant(handle: str, service_id: str, path: str) -> str:
    return (
        f'tell application "Messages"\n'
        f'  set svc to service id "{as_q(service_id)}"\n'
        f'  set p to participant "{as_q(handle)}" of svc\n'
        f'  send POSIX file "{as_q(path)}" to p\n'
        f'end tell\n'
    )


def applescript_send_file_chat(chat_guid: str, path: str) -> str:
    return (
        f'tell application "Messages"\n'
        f'  send POSIX file "{as_q(path)}" to chat id "{as_q(chat_guid)}"\n'
        f'end tell\n'
    )


def applescript_send_participant(handle: str, service_id: str, text: str) -> str:
    return (
        f'tell application "Messages"\n'
        f'  set svc to service id "{as_q(service_id)}"\n'
        f'  set p to participant "{as_q(handle)}" of svc\n'
        f'  send "{as_q(text)}" to p\n'
        f'end tell\n'
    )


def applescript_send_chat(chat_guid: str, text: str) -> str:
    return (
        f'tell application "Messages"\n'
        f'  send "{as_q(text)}" to chat id "{as_q(chat_guid)}"\n'
        f'end tell\n'
    )


def has_existing_chat(handle: str, service_name: str) -> bool:
    if not os.path.exists(CHAT_DB):
        return False
    try:
        con = sqlite3.connect(f"file:{CHAT_DB}?mode=ro", uri=True)
        row = con.execute(
            "SELECT 1 FROM chat WHERE chat_identifier=? AND service_name=? LIMIT 1",
            (handle, service_name),
        ).fetchone()
        return row is not None
    except sqlite3.DatabaseError:
        return False


def run_applescript(script: str) -> tuple[int, str, str]:
    # Script on STDIN, not `-e`: the body would otherwise sit in osascript's
    # argv for every `ps` on the Mac (audit #4).
    proc = run_osascript(["osascript", "-"], script)
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def consent_banner(recipient: str, text: str) -> None:
    """Loud reminder printed immediately before any actual send — on a TTY.
    Non-interactive callers (Blip over ssh) would otherwise log every
    recipient of every send into the client's journald."""
    if not sys.stderr.isatty():
        return
    print("=" * 72, file=sys.stderr)
    print("  CONSENT-GATED SEND  (this is a real outbound message)", file=sys.stderr)
    print("=" * 72, file=sys.stderr)
    print(f"  to  : {recipient}", file=sys.stderr)
    # Body text is deliberately NOT echoed: stderr ends up in the caller's
    # logs (journald on the Linux side). Length is enough for a sanity check.
    print(f"  body: {len(text)} chars", file=sys.stderr)
    print("=" * 72, file=sys.stderr)


def main() -> None:
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    p.add_argument("--to", help="Recipient handle (phone or email)")
    p.add_argument("--chat-id", help="Existing chat GUID (alternative to --to)")
    p.add_argument("--self", action="store_true",
                   help="Shortcut: send to your own iMessage address (auto-detected)")
    p.add_argument("--service", default="iMessage",
                   choices=["iMessage", "SMS", "RCS"],
                   help="Messages service to use (default iMessage)")
    p.add_argument("--yes", action="store_true",
                   help="Actually send. Without this, prints dry-run AppleScript.")
    p.add_argument("--keep-dashes", action="store_true",
                   help="Skip the auto-scrub of em/en dashes (default scrubs them).")
    p.add_argument("--list-services", action="store_true",
                   help="List Messages services and exit")
    p.add_argument("--list-self", action="store_true",
                   help="Print auto-detected self-handles (own iMessage/SMS addresses)")
    p.add_argument("--file-stdin", action="store_true",
                   help="Read ONE attachment from stdin and send it. Stages via "
                        "~/Pictures/.blip-outbox (Sequoia AppleScript quirk). "
                        "Any text becomes a SECOND message, reported per-part.")
    p.add_argument("--file-bytes", type=int, default=0, metavar="N",
                   help="With --file-stdin: exact byte count expected; a short stream is refused")
    p.add_argument("--name", default="file",
                   help="Filename for --file-stdin (shown to the recipient)")
    p.add_argument("--text-stdin", action="store_true",
                   help="Read the message body from stdin (keeps it out of argv)")
    p.add_argument("--text-stdin-bytes", type=int, default=0, metavar="N",
                   help="With --file-stdin: the first N bytes of stdin are the UTF-8 "
                        "caption, the rest is the file")
    p.add_argument("text", nargs="*", help="Message body (joined with spaces)")
    args = p.parse_args()

    if args.list_services:
        for s in list_services():
            print(f"  {s['type']:<10}  id={s['id']}")
        return
    if args.list_self:
        for h in detect_self_handles():
            print(h)
        return

    text = " ".join(args.text).strip()
    if args.text_stdin:
        if args.file_stdin:
            sys.exit("error: --text-stdin cannot combine with --file-stdin; use --text-stdin-bytes N")
        text = sys.stdin.buffer.read(MAX_LEN * 4 + 1).decode("utf-8", "replace").strip()
    elif args.text_stdin_bytes > 0:
        if not args.file_stdin:
            sys.exit("error: --text-stdin-bytes needs --file-stdin")
        if args.text_stdin_bytes > MAX_LEN * 4:
            sys.exit("error: caption too long")
        head = sys.stdin.buffer.read(args.text_stdin_bytes)
        if len(head) != args.text_stdin_bytes:
            sys.exit("error: short caption on stdin")
        text = head.decode("utf-8", "replace").strip()
    if not text and not args.file_stdin:
        sys.exit("error: empty message text")
    if len(text) > MAX_LEN:
        sys.exit(f"error: message too long ({len(text)} > {MAX_LEN} chars)")

    if not args.keep_dashes:
        cleaned, n = scrub_dashes(text)
        if n:
            print(
                f"note: scrubbed {n} dash char(s) per no-dashes rule. "
                "Pass --keep-dashes to override.",
                file=sys.stderr,
            )
            text = cleaned

    # Resolve the recipient once; text and file sends share it.
    handle = service_id = None
    if args.chat_id:
        recipient = f"chat {args.chat_id}"
    else:
        if args.self:
            self_handles = detect_self_handles()
            if not self_handles:
                sys.exit(
                    "error: --self requested but no own iMessage handles detected "
                    "in chat.db. Use --to <your-own-address> instead."
                )
            handle = self_handles[0]
        elif args.to:
            handle = args.to
        else:
            sys.exit("error: pass one of --to <handle>, --chat-id <guid>, or --self")

        if args.service != "iMessage" and not has_existing_chat(handle, args.service):
            print(
                f"warning: no prior {args.service} chat with {handle}; "
                "send may silently fail without a connected iPhone (Continuity)",
                file=sys.stderr,
            )

        service_id = find_service_id(args.service)
        recipient = f"{handle} via {args.service}"

    def build(kind: str, payload: str) -> str:
        if kind == "file":
            return (applescript_send_file_chat(args.chat_id, payload) if args.chat_id
                    else applescript_send_file_participant(handle, service_id, payload))
        return (applescript_send_chat(args.chat_id, payload) if args.chat_id
                else applescript_send_participant(handle, service_id, payload))

    if not args.yes:
        print("DRY RUN (pass --yes to actually send)")
        print(f"recipient: {recipient}")
        if args.file_stdin:
            print(f"file     : <stdin> as {args.name!r} (not read in dry run)")
        if text:
            print(f"text     : {text!r}")
            print("AppleScript:")
            print("  " + build("text", text).replace("\n", "\n  "))
        return

    # File first, then text — two AppleScript sends, reported per-part so a
    # retry never re-sends the half that already worked.
    parts_failed = []
    if args.file_stdin:
        staged = stage_stdin_file(args.name, args.file_bytes)
        consent_banner(recipient, f"[file: {os.path.basename(staged)}]")
        baseline = _max_attachment_rowid()
        rc, out, err = run_applescript(build("file", staged))
        if rc != 0:
            unstage(staged)
            parts_failed.append(f"file ({err})")
        else:
            # osascript returning 0 proves NOTHING for files — failures
            # surface later in chat.db. Wait for Messages' own copy before
            # touching the staged file, and surface a delivery error loudly.
            chat_ident = (args.chat_id.split(";+;")[-1] if args.chat_id else args.to) or None
            copied, msg_err = wait_for_copy(staged, baseline, chat_ident=chat_ident)
            if msg_err:
                unstage(staged)
                parts_failed.append(f"file (Messages error {msg_err} — not delivered)")
            elif copied:
                keep_sent(staged)
                print("file: sent.")
            else:
                # Copy not observed yet: leave staging for the hourly GC —
                # never yank a file an upload might still be reading.
                print("file: sent (staged copy retained for GC).")
    if text:
        consent_banner(recipient, text)
        rc, out, err = run_applescript(build("text", text))
        if rc != 0:
            parts_failed.append(f"text ({err})")
        else:
            if out:
                print(out)
            print("text: sent." if args.file_stdin else "sent.")
    if parts_failed:
        sys.exit("send failed: " + "; ".join(parts_failed))


if __name__ == "__main__":
    main()
