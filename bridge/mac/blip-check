#!/usr/bin/env python3
"""
blip-check: core Mac permissions, plus opt-in checks for optional actions.

  python3 ~/.blip/bin/blip-check             # human lines, exit 0 when all pass
  python3 ~/.blip/bin/blip-check --json      # {"chatdb", "automation", "contacts", "markread": bool, ...}
  python3 ~/.blip/bin/blip-check --markread  # ALSO test the optional read-push grant
  python3 ~/.blip/bin/blip-check --mutations # ALSO check deletion prerequisites

--markread is opt-in because that probe is consent-triggering in its own right:
it talks to System Events, which pops a second Automation prompt, and on
macOS 26 a grant the user never asked for could not be switched back off in
System Settings (#36). Only read-push needs it.

Run it OVER SSH — that is the context that matters (sshd's grants, not the
Terminal's). The Automation check deliberately talks to Messages.app, which
makes macOS pop its one-time "sshd-keygen-wrapper wants to control Messages"
prompt on the Mac's screen if the grant is missing — click Allow once.
"""
from __future__ import annotations

import glob
import json
import os
import plistlib
import sqlite3
import subprocess
import sys

CHAT_DB = os.path.expanduser("~/Library/Messages/chat.db")
AB_DIR = os.path.expanduser("~/Library/Application Support/AddressBook")
AB_GLOB = os.path.join(AB_DIR, "Sources", "*", "AddressBook-v22.abcddb")

FIX = {
    "chatdb": "System Settings → Privacy & Security → Full Disk Access → add "
              "/usr/libexec/sshd-keygen-wrapper (⌘⇧G in the picker), then reconnect ssh.",
    "automation": "Click Allow on the Mac's screen when Messages asks (within ~2 minutes), or: "
                  "System Settings → Privacy & Security → Automation → sshd-keygen-wrapper → Messages. "
                  "If that switch will not stay on, a timed-out prompt was recorded as a denial: run "
                  "`tccutil reset AppleEvents` on the Mac, re-run, and click Allow in time.",
    "contacts": "Same Full Disk Access grant as chat.db (names/avatars come from the AddressBook DB).",
    "markread": "System Settings → Privacy & Security → Accessibility → add "
                "/usr/libexec/sshd-keygen-wrapper. Read-push and message deletion need this grant.",
    "message_delete": "Enable Accessibility for /usr/libexec/sshd-keygen-wrapper "
                      "(⌘⇧G in the file picker), install Xcode Command Line Tools, "
                      "and keep Messages open in an unlocked Mac desktop. See docs/DELETE-MESSAGE.md.",
}


def check_chatdb() -> tuple[bool, str]:
    try:
        con = sqlite3.connect(f"file:{CHAT_DB}?mode=ro", uri=True)
        n = con.execute("SELECT COUNT(*) FROM message").fetchone()[0]
        con.close()
        return True, f"{n} messages readable"
    except sqlite3.DatabaseError as e:
        return False, str(e)


# macOS gives the Allow prompt about two minutes. If nobody clicks, TCC records a
# DENIAL (auth_reason 9, "Prompt Timeout") — and on macOS 26 the System Settings
# switch for that record may refuse to flip back on (#36). So this probe waits
# longer than the prompt does, and says so first: the person running blip-setup
# is at the LINUX box, and the prompt appears on the Mac's screen.
PROMPT_WAIT = 150


def check_automation() -> tuple[bool, str]:
    # Touching Messages via AppleScript is what needs the grant — and what
    # triggers the prompt when it is missing. Listing services is harmless.
    print("  … asking Messages (if an Allow prompt appears on the Mac's screen, click it — "
          "it expires in about two minutes)", file=sys.stderr, flush=True)
    try:
        r = subprocess.run(
            ["osascript", "-e", 'tell application "Messages" to get count of services'],
            capture_output=True, text=True, timeout=PROMPT_WAIT,
        )
    except subprocess.TimeoutExpired:
        return False, ("no answer from Messages in %ds — the Allow prompt on the Mac's screen was not "
                       "clicked in time. macOS records that as a denial; see the fix." % PROMPT_WAIT)
    if r.returncode == 0:
        return True, f"Messages responds ({r.stdout.strip()} services)"
    err = r.stderr.strip()
    if "-1743" in err or "not permitted" in err.lower() or "not authorized" in err.lower():
        return False, "Automation → Messages not granted"
    return False, err[:200]


ACCOUNTS_DB = os.path.expanduser("~/Library/Accounts/Accounts4.sqlite")


def _archived_bool(blob) -> bool:
    """True when an NSKeyedArchiver plist archives the single value YES."""
    try:
        p = plistlib.loads(blob)
        root = p["$top"]["root"]
        v = p["$objects"][root.data] if isinstance(root, plistlib.UID) else root
        return v is True
    except Exception:
        return False


def _child_delegate_sources() -> set[str]:
    """Account ids of Family Sharing child-delegate Contacts stores (Screen
    Time -> Manage Contacts). Same rule as imsg/contacts: those .abcddb files
    are a child's address book, not the user's, and are skipped for names and
    photos. Unreadable Accounts db -> empty set."""
    out: set[str] = set()
    try:
        con = sqlite3.connect(f"file:{ACCOUNTS_DB}?mode=ro", uri=True)
        rows = con.execute(
            "SELECT a.ZIDENTIFIER, p.ZVALUE FROM ZACCOUNTPROPERTY p "
            "JOIN ZACCOUNT a ON a.Z_PK = p.ZOWNER WHERE p.ZKEY = 'isChildDelegate'"
        ).fetchall()
        con.close()
    except sqlite3.DatabaseError:
        return out
    for ident, blob in rows:
        if ident and _archived_bool(blob):
            out.add(str(ident))
    return out


def _addressbook_dbs() -> list[str]:
    """One .abcddb per Contacts source/account, plus the root db, like the
    `contacts` tool. Order is stable so the check is deterministic."""
    skip = _child_delegate_sources()
    paths = [p for p in sorted(glob.glob(AB_GLOB))
             if os.path.basename(os.path.dirname(p)) not in skip]
    root = os.path.join(AB_DIR, "AddressBook-v22.abcddb")
    if os.path.exists(root):
        paths.append(root)
    return paths


def check_contacts() -> tuple[bool, str]:
    # Disabled or stale CardDAV sources leave .abcddb files that never open
    # ("unable to open database file") no matter what TCC grants exist — the
    # `contacts` tool warns and skips them. So this must probe every source and
    # fail only when NOTHING opens, which is the real "Full Disk Access missing"
    # signal. Testing a single source (previously glob()[0], unordered) reported
    # a false ❌ whenever a dead source sorted first.
    paths = _addressbook_dbs()
    if not paths:
        return False, "no AddressBook sources found"
    readable = total = 0
    last_err = ""
    for p in paths:
        try:
            con = sqlite3.connect(f"file:{p}?mode=ro", uri=True)
            total += con.execute("SELECT COUNT(*) FROM ZABCDRECORD").fetchone()[0]
            con.close()
            readable += 1
        except sqlite3.DatabaseError as e:
            last_err = str(e)
    if readable:
        skipped = len(paths) - readable
        tail = f", {skipped} stale source(s) skipped" if skipped else ""
        kids = len(_child_delegate_sources())
        if kids:
            tail += f", {kids} Family Sharing child list(s) ignored"
        return True, f"{total} contacts readable ({readable}/{len(paths)} sources{tail})"
    return False, last_err or "no AddressBook source could be opened"


def check_markread() -> tuple[bool, str]:
    """Can we drive Messages' menu bar? That is how a read is pushed back
    (imsg-read). Optional: reading and sending work without it."""
    # This is the first System Events call this Mac may ever see from sshd: it
    # can pop an Automation prompt of its own, so it gets the same patience as
    # the Messages probe (Astra C#8).
    print("  … asking System Events (an Allow prompt for System Events may appear on the Mac's screen — click it)",
          file=sys.stderr, flush=True)
    try:
        r = subprocess.run(
            ["osascript", "-e",
             'tell application "System Events" to tell process "Messages" to '
             'name of menu bar item "Conversation" of menu bar 1'],
            capture_output=True, timeout=PROMPT_WAIT,
        )
    except subprocess.TimeoutExpired:
        return False, "System Events timed out"
    if r.returncode == 0:
        return True, "can mark conversations read on this Mac"
    err = (r.stderr or b"").decode("utf-8", "replace").strip()
    if "not allowed assistive" in err or "1002" in err:
        return False, "Accessibility not granted (needed for optional read-push and message deletion)"
    if "Messages" in err and "-1728" in err:
        return True, "Messages is not running; grant looks present"
    return False, err.splitlines()[0] if err else "System Events could not reach Messages"


def check_mutations() -> dict:
    """Read permission status only: no UI actions, contact reads, or prompts."""
    script = ('ObjC.import("ApplicationServices"); '
              'JSON.stringify({accessibility:!!$.AXIsProcessTrusted()})')
    try:
        result = subprocess.run(["/usr/bin/osascript", "-l", "JavaScript", "-e", script],
                                capture_output=True, text=True, timeout=10)
        status = json.loads(result.stdout) if result.returncode == 0 else {}
        developer = subprocess.run(["/usr/bin/xcode-select", "-p"], capture_output=True, timeout=10)
        ready = status.get("accessibility") is True and developer.returncode == 0
        return {"message_delete": (ready, "Accessibility and developer tools ready" if ready else "Accessibility or developer tools missing")}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {"message_delete": (False, "could not read permission status")}


def main() -> None:
    results = {"chatdb": check_chatdb(), "automation": check_automation(), "contacts": check_contacts()}
    # Optional: its absence costs only mark-as-read, so it must not fail the run.
    # Opt-IN as well as optional, because the probe itself asks macOS for a
    # permission: it pops a System Events Automation prompt, and on macOS 26 a
    # grant nobody wanted could not be switched back off in System Settings
    # afterwards (#36, 26.6.2). Asking for consent the user did not request is
    # the exact failure this file exists to warn about, so it must not do it
    # uninvited. This System Events probe is for read-push; deletion has the
    # separate status-only --mutations check.
    want_markread = "--markread" in sys.argv
    optional = {"markread": check_markread() if want_markread else
                (False, "read-push not checked; re-run with --markread to test it; use --mutations for deletion prerequisites")}
    want_mutations = "--mutations" in sys.argv
    if want_mutations:
        optional.update(check_mutations())

    def fix_for(key: str, ok: bool) -> str:
        """No fix line for a probe that never ran: nothing is wrong with it."""
        if ok or (key == "markread" and not want_markread):
            return ""
        return FIX[key]

    if "--json" in sys.argv:
        print(json.dumps({k: {"ok": v[0], "detail": v[1], "fix": fix_for(k, v[0])}
                          for k, v in {**results, **optional}.items()}))
    else:
        for k, (ok, detail) in results.items():
            print(f"  {'✅' if ok else '❌'}  {k:<10} {detail}")
            if not ok:
                print(f"      fix: {FIX[k]}")
        for k, (ok, detail) in optional.items():
            print(f"  {'✅' if ok else '➖'}  {k:<10} {detail}")
            if fix_for(k, ok):
                print(f"      fix: {FIX[k]}")
    ready = all(v[0] for v in results.values())
    if want_mutations:
        ready = ready and optional["message_delete"][0]
    sys.exit(0 if ready else 1)


if __name__ == "__main__":
    main()
