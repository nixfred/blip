class NativeAX:
    """Public Accessibility/CoreFoundation APIs, with no extra dependency.

    System Events does not expose detached CharacterPalette popovers. Native
    AX also avoids its per-attribute Apple-event latency. Every owned CF value
    is released together after the bounded operation; borrowed children remain
    alive while their containing arrays are retained.
    """
    def __init__(self, deadline):
        import ctypes as C
        self.C, self.deadline, self.refs, self.keys = C, deadline, [], {}
        P, L = C.c_void_p, C.c_long
        self.cf = C.CDLL("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
        self.ax = C.CDLL("/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices")
        def bind(lib, name, result, args):
            fn = getattr(lib, name)
            fn.restype, fn.argtypes = result, args
            return fn
        self.string = bind(self.cf, "CFStringCreateWithCString", P, [P, C.c_char_p, C.c_uint])
        self.getstring = bind(self.cf, "CFStringGetCString", C.c_bool, [P, C.c_char_p, L, C.c_uint])
        self.count = bind(self.cf, "CFArrayGetCount", L, [P])
        self.at = bind(self.cf, "CFArrayGetValueAtIndex", P, [P, L])
        self.typeid = bind(self.cf, "CFGetTypeID", C.c_ulong, [P])
        self.types = {name: bind(self.cf, "CF" + name + "GetTypeID", C.c_ulong, [])()
                      for name in ("String", "Array", "Boolean", "Number", "Dictionary")}
        self.boolean = bind(self.cf, "CFBooleanGetValue", C.c_bool, [P])
        self.number = bind(self.cf, "CFNumberGetValue", C.c_bool, [P, C.c_int, P])
        self.dictget = bind(self.cf, "CFDictionaryGetValue", P, [P, P])
        self.release = bind(self.cf, "CFRelease", None, [P])
        self.equal = bind(self.cf, "CFEqual", C.c_bool, [P, P])
        self.copyattr = bind(self.ax, "AXUIElementCopyAttributeValue", C.c_int, [P, P, C.POINTER(P)])
        self.copyactions = bind(self.ax, "AXUIElementCopyActionNames", C.c_int, [P, C.POINTER(P)])
        self.setattr = bind(self.ax, "AXUIElementSetAttributeValue", C.c_int, [P, P, P])
        self.perform = bind(self.ax, "AXUIElementPerformAction", C.c_int, [P, P])
        self.hit = bind(self.ax, "AXUIElementCopyElementAtPosition", C.c_int,
                        [P, C.c_float, C.c_float, C.POINTER(P)])
        self.windows = bind(self.ax, "CGWindowListCopyWindowInfo", P, [C.c_uint, C.c_uint])
        class Point(C.Structure):
            _fields_ = [("x", C.c_double), ("y", C.c_double)]
        self.Point = Point
        self.axvalue = bind(self.ax, "AXValueGetValue", C.c_bool, [P, C.c_int, P])
        self.event = bind(self.ax, "CGEventCreate", P, [P])
        self.location = bind(self.ax, "CGEventGetLocation", Point, [P])
        self.mouse_event = bind(self.ax, "CGEventCreateMouseEvent", P, [P, C.c_uint, Point, C.c_uint])
        self.preflight_post = bind(self.ax, "CGPreflightPostEventAccess", C.c_bool, [])
        self.post_event = bind(self.ax, "CGEventPost", None, [C.c_uint, P])
        self.button_state = bind(self.ax, "CGEventSourceButtonState", C.c_bool, [C.c_int, C.c_uint])
        self.flags_state = bind(self.ax, "CGEventSourceFlagsState", C.c_ulonglong, [C.c_int])
        create = bind(self.ax, "AXUIElementCreateApplication", P, [C.c_int])
        set_timeout = bind(self.ax, "AXUIElementSetMessagingTimeout", C.c_int, [P, C.c_float])
        pids = subprocess.check_output(["/usr/bin/pgrep", "-x", "Messages"], timeout=2).splitlines()
        if len(pids) != 1:
            raise RuntimeError("Messages process is not unique")
        self.pid = int(pids[0])
        self.app = self.own(create(self.pid))
        self.system = self.own(bind(self.ax, "AXUIElementCreateSystemWide", P, [])())
        set_timeout(self.app, 0.5)

    def check(self):
        if time.monotonic() >= self.deadline:
            raise TimeoutError("emoji selection deadline reached")

    def own(self, value):
        if value:
            self.refs.append(value)
        return value

    def key(self, name):
        if name not in self.keys:
            self.keys[name] = self.own(self.string(None, name.encode(), 0x08000100))
        return self.keys[name]

    def decode(self, ref):
        if not ref:
            return None
        kind = self.typeid(ref)
        if kind == self.types["String"]:
            buf = self.C.create_string_buffer(8192)
            return buf.value.decode("utf-8") if self.getstring(ref, buf, len(buf), 0x08000100) else None
        if kind == self.types["Array"]:
            size = self.count(ref)
            if size > 4096:
                raise RuntimeError("Accessibility array exceeded its bound")
            return [self.at(ref, i) for i in range(size)]
        if kind == self.types["Boolean"]:
            return bool(self.boolean(ref))
        if kind == self.types["Number"]:
            number = self.C.c_double()
            return number.value if self.number(ref, 13, self.C.byref(number)) else None
        return ref

    def attr(self, el, name):
        self.check()
        out = self.C.c_void_p()
        if not el or self.copyattr(el, self.key(name), self.C.byref(out)):
            return None
        return self.decode(self.own(out.value))

    def children(self, el):
        return self.attr(el, "AXChildren") or []

    def walk(self, el, limit=1800):
        queue, seen = [(el, None)], 0
        while queue:
            self.check()
            if seen >= limit:
                raise RuntimeError("Accessibility tree exceeded its bound")
            item, parent = queue.pop(0)
            seen += 1
            yield item, parent
            queue.extend((child, item) for child in self.children(item))

    def actions(self, el):
        self.check()
        out = self.C.c_void_p()
        if self.copyactions(el, self.C.byref(out)):
            return []
        return [self.decode(x) for x in self.decode(self.own(out.value)) or []]

    def press(self, el):
        self.check()
        return self.perform(el, self.key("AXPress")) == 0

    def frame(self, el):
        point, size = self.Point(), self.Point()
        p, s = self.attr(el, "AXPosition"), self.attr(el, "AXSize")
        if not p or not s or not self.axvalue(p, 1, self.C.byref(point)) or not self.axvalue(s, 2, self.C.byref(size)):
            return None
        return point.x, point.y, size.x, size.y

    def click_glyph(self, el, validate):
        """One bounded click on an exact AX glyph, never a guessed grid cell.

        CharacterPalette acknowledges AXPress on its AXUnknown glyph wrappers
        without choosing them on macOS 27.2. Hit-test the current center back
        to that same wrapper or its one static-text child; revalidate context,
        identity and bounds immediately before the single down/up gesture.
        """
        self.check()
        if not self.preflight_post():
            return {"ok": False, "error": "event-access-denied"}
        before = self.frame(el)
        if not before or not all(abs(v) < 100000 for v in before) or not (4 <= before[2] <= 128 and 4 <= before[3] <= 128):
            return {"ok": False, "error": "moved"}
        point = self.Point(before[0] + before[2] / 2, before[1] + before[3] / 2)
        hit = self.C.c_void_p()
        if self.hit(self.system, point.x, point.y, self.C.byref(hit)):
            return {"ok": False, "error": "moved"}
        hit = self.own(hit.value)
        children = self.children(el)
        if not (self.equal(hit, el) or (len(children) == 1 and self.equal(hit, children[0]))):
            return {"ok": False, "error": "moved"}
        # Do not mix a synthetic click with a person's drag or held modifier.
        if any(self.button_state(0, n) for n in range(5)) or self.flags_state(0) & 0x9e0000:
            return {"ok": False, "error": "moved"}
        original_event = self.own(self.event(None))
        if not original_event:
            return {"ok": False, "error": "moved"}
        original = self.location(original_event)
        down = self.own(self.mouse_event(None, 1, point, 0))
        up = self.own(self.mouse_event(None, 2, point, 0))
        if not down or not up or not validate() or self.frame(el) != before:
            return {"ok": False, "error": "moved"}
        hit_now = self.C.c_void_p()
        if self.hit(self.system, point.x, point.y, self.C.byref(hit_now)):
            return {"ok": False, "error": "moved"}
        hit_now = self.own(hit_now.value)
        if not (self.equal(hit_now, el) or (len(children) == 1 and self.equal(hit_now, children[0]))):
            return {"ok": False, "error": "moved"}
        self.check()
        # No fallback or second click follows these events, even if no receipt
        # arrives. A user moving immediately afterward retains their pointer.
        try:
            try:
                self.post_event(0, down)
            finally:
                self.post_event(0, up)
            current_event = self.own(self.event(None))
            if current_event:
                current = self.location(current_event)
                if abs(current.x - point.x) < 1 and abs(current.y - point.y) < 1:
                    restore = self.own(self.mouse_event(None, 5, original, 0))
                    if restore:
                        self.post_event(0, restore)
        except Exception:
            return {"ok": False, "error": "perform-failed"}
        return {"ok": True}

    def search(self, el, text):
        self.check()
        return self.setattr(el, self.key("AXValue"), self.key(text)) == 0

    def foreground(self):
        return self.attr(self.app, "AXFrontmost") is True

    def origin(self, picker, container):
        window = self.attr(self.app, "AXMainWindow")
        parent = self.attr(container, "AXParent")
        picker_parent = self.attr(picker, "AXParent")
        if not window or not parent or not picker_parent or not self.equal(picker_parent, container):
            return None
        title = self.attr(window, "AXTitle")
        return (window, title, parent) if isinstance(title, str) else None

    def same_origin(self, origin, picker, container):
        current = self.origin(picker, container)
        return bool(origin and current and self.equal(origin[0], current[0])
                    and origin[1] == current[1] and self.equal(origin[2], current[2]))

    def pickers(self):
        # The presentation container is a direct child of iOSContentGroup.
        # Do not traverse conversation/history cells to find its sibling UI.
        found = []
        for window in self.attr(self.app, "AXWindows") or []:
            for group in self.children(window):
                if self.attr(group, "AXSubrole") != "iOSContentGroup":
                    continue
                for presentation in self.children(group):
                    for el in self.children(presentation):
                        if self.attr(el, "AXIdentifier") == "TapbackPickerCollectionView":
                            found.append((el, presentation))
        return found

    def popovers(self):
        """Discover, never click, a detached Messages-owned picker window.

        The point is only an AX hit-test. It must resolve to a search field
        whose parent is AXPopover. Subsequent selection uses exact identities.
        Window bounds alone can never authorize any input or press.
        """
        found = []
        self.check()
        windows = self.decode(self.own(self.windows(16, 0))) or []
        def field(obj, name):
            return self.decode(self.dictget(obj, self.key(name)))
        for window in windows:
            self.check()
            if field(window, "kCGWindowOwnerPID") != self.pid or not field(window, "kCGWindowIsOnscreen"):
                continue
            if (field(window, "kCGWindowAlpha") or 0) <= 0:
                continue
            bounds = self.dictget(window, self.key("kCGWindowBounds"))
            if not bounds:
                continue
            x, y, width, height = [field(bounds, k) for k in ("X", "Y", "Width", "Height")]
            if any(v is None for v in (x, y, width, height)) or not (300 <= width <= 420 and 350 <= height <= 560):
                continue
            out = self.C.c_void_p()
            if self.hit(self.app, x + width / 2, y + 38, self.C.byref(out)):
                continue
            el = self.own(out.value)
            if self.attr(el, "AXSubrole") != "AXSearchField":
                continue
            parent = self.attr(el, "AXParent")
            if self.attr(parent, "AXRole") == "AXPopover" and not any(self.equal(parent, p) for p in found):
                found.append(parent)
        return found

    def close(self):
        for ref in reversed(self.refs):
            self.release(ref)
        self.refs.clear()


def native_emoji_picker(q, ax=None, pause=time.sleep):
    """One exact custom reaction in the picker already opened by picker_route.

    Only identifiers/roles are traversed in the transcript. Message-label
    reads are restricted to siblings in the verified picker presentation.
    No CharacterPalette process search, global keyboard input, or grid index.
    """
    owned = ax is None
    ax = ax or NativeAX(time.monotonic() + 30)
    pressed = False
    try:
        matches = ax.pickers()
        for _ in range(15):
            matches = ax.pickers()
            if matches:
                break
            pause(0.3)
        if len(matches) != 1:
            return {"ok": False, "error": "no-picker" if not matches else "ambiguous-emoji"}
        # A press during the picker's opening transition is acknowledged and
        # then ignored (27.2), for classic buttons and glyphs alike.
        pause(0.8)
        matches = ax.pickers()
        if len(matches) != 1:
            return {"ok": False, "error": "no-picker" if not matches else "ambiguous-emoji"}
        picker, container = matches[0]
        origin = ax.origin(picker, container)

        def context():
            if (not ax.foreground() or not ax.same_origin(origin, picker, container)
                    or ax.attr(picker, "AXIdentifier") != "TapbackPickerCollectionView"):
                return False
            labels = []
            for sibling in ax.children(container):
                if ax.attr(sibling, "AXRole") != "AXGroup" or ax.attr(sibling, "AXIdentifier") == "TapbackPickerCollectionView":
                    continue
                label = ax.attr(sibling, "AXDescription") or ""
                if label.startswith("Message, "):
                    labels.append(norm(label[9:]))
            return bool(labels) and all(label == q["text"] or
                (label.startswith(q["text"] + ", ") and REACTED.fullmatch(label[len(q["text"]) + 2:]))
                for label in labels)

        if not q.get("emoji"):
            hits = [el for el, _ in ax.walk(picker) if ax.attr(el, "AXRole") == "AXButton"
                    and ax.attr(el, "AXDescription") == q["action"] and ax.attr(el, "AXEnabled") is True]
            if len(hits) != 1:
                return {"ok": False, "error": "not-offered", "offered": []}
            if not context():
                return {"ok": False, "error": "picker-elsewhere"}
            pressed = True
            # A slow AX acknowledgement proves nothing either way: chat.db decides.
            return {"ok": True} if ax.press(hits[0]) else {"ok": False, "error": "perform-failed"}

        def exact(el):
            if ax.attr(el, "AXRole") == "AXUnknown":
                # CharacterPalette 27.2 exposes each glyph as AXUnknown with
                # AXPress, an exact glyph description and one static-text
                # child containing the same sequence. A named image/sticker
                # or a search field cannot satisfy this identity contract.
                children = ax.children(el)
                return (ax.attr(el, "AXDescription") == q["emoji"] and len(children) == 1
                        and ax.attr(children[0], "AXRole") == "AXStaticText"
                        and ax.attr(children[0], "AXValue") == q["emoji"])
            return ax.attr(el, "AXIdentifier") == q["emoji"] or ax.attr(el, "AXValue") == q["emoji"]

        def enabled(el):
            state = ax.attr(el, "AXEnabled")
            if state is not None:
                return state is True
            # The system's AXUnknown glyph wrapper omits AXEnabled. Its
            # exact static-text child supplies the enabled state instead.
            children = ax.children(el)
            return (ax.attr(el, "AXRole") == "AXUnknown" and len(children) == 1
                    and ax.attr(children[0], "AXRole") == "AXStaticText"
                    and ax.attr(children[0], "AXEnabled") is True)

        def choose(root):
            nonlocal pressed
            hits = [el for el, _ in ax.walk(root) if ax.attr(el, "AXRole") in ("AXButton", "AXCell", "AXUnknown")
                    and exact(el) and enabled(el) and "AXPress" in ax.actions(el)]
            if len(hits) != 1:
                return {"ok": False, "error": "ambiguous-emoji" if hits else "emoji-not-offered"}
            if not context() or not exact(hits[0]) or not enabled(hits[0]):
                return {"ok": False, "error": "moved"}
            if ax.attr(hits[0], "AXRole") == "AXUnknown":
                result = ax.click_glyph(hits[0], lambda: context() and exact(hits[0]) and enabled(hits[0]))
                pressed = result.get("ok", False) or result.get("error") == "perform-failed"
                return result
            pressed = True
            return {"ok": True} if ax.press(hits[0]) else {"ok": False, "error": "perform-failed"}

        if not context():
            return {"ok": False, "error": "picker-elsewhere"}
        pause(0.2)
        if not context():
            return {"ok": False, "error": "moved"}
        direct = choose(picker)
        if direct.get("ok") or direct.get("error") != "emoji-not-offered" or q.get("remove"):
            return direct
        more = [el for el in ax.children(container) if ax.attr(el, "AXRole") == "AXButton"
                and ax.attr(el, "AXDescription") == "Add custom emoji reaction"
                and ax.attr(el, "AXEnabled") is True and "AXPress" in ax.actions(el)]
        if len(more) != 1 or not context():
            return {"ok": False, "error": "emoji-picker-unavailable"}
        if not ax.press(more[0]):
            return {"ok": False, "error": "emoji-picker-unavailable"}
        popovers = []
        for _ in range(8):
            pause(0.2)
            if not context():
                return {"ok": False, "error": "moved"}
            popovers = ax.popovers()
            if popovers:
                break
        if len(popovers) != 1:
            return {"ok": False, "error": "ambiguous-emoji" if popovers else "emoji-picker-unavailable"}
        popover = popovers[0]
        if not q.get("name"):
            return choose(popover)
        # Search before enumerating the catalogue; an unfiltered system
        # picker may contain thousands of cells. The field is a direct child.
        fields = [el for el in ax.children(popover) if ax.attr(el, "AXSubrole") == "AXSearchField"
                  and ax.attr(el, "AXEnabled") is True]
        if len(fields) != 1 or not context():
            return {"ok": False, "error": "emoji-picker-unavailable"}
        if not ax.search(fields[0], q["name"]):
            return {"ok": False, "error": "emoji-picker-unavailable"}
        pause(0.8)
        return choose(popover)
    except TimeoutError:
        return {"ok": False, "error": "timeout" if pressed else "emoji-picker-unavailable"}
    except Exception:
        return {"ok": False, "error": "perform-failed" if pressed else "emoji-picker-unavailable"}
    finally:
        if owned:
            ax.close()


def jxa(request: dict) -> dict:
    """Run the AX script with one request on stdin; its JSON answer, or an error."""
    try:
        r = subprocess.run(["/usr/bin/osascript", "-l", "JavaScript", "-e", JXA],
                           input=json.dumps(request, ensure_ascii=False).encode(),
                           capture_output=True, timeout=JXA_TIMEOUT)
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "timeout"}
    if r.returncode != 0:
        return {"ok": False, "error": "osascript", "detail": r.stderr.decode("utf-8", "replace").strip()[-200:]}
    try:
        answer = json.loads(r.stdout)
    except ValueError:
        return {"ok": False, "error": "osascript"}
    return answer if isinstance(answer, dict) else {"ok": False, "error": "osascript"}


def perform(target: dict, action: str, run=jxa, deadline=None) -> dict:
    """Find the bubble and perform `action` on it once. Pages the transcript
    down to the newest message if it is parked above it, then up while the
    target is not rendered, and only from the newest message. A pass that
    finds it brings it into view ("unsettled"); the press waits for a pass
    that finds it where the last one did. Paging and settling are the only
    things repeated, and they stop at `deadline` (time.monotonic())."""
    request = {"text": target["text"], "from_me": target["from_me"], "hhmm": target["hhmm"],
               "ordinal": target["ordinal"], "newest": target["newest"], "actions": ACTIONS + [action],
               "action": action, "frame": "", "mode": "perform", "picture": bool(target.get("picture"))}
    down = up = settles = 0
    looked_again = bottom_seen = False
    while True:
        r = run(request)
        late = deadline is not None and time.monotonic() >= deadline
        if r.get("error") == "unsettled" and settles < MAX_SETTLES and not late:
            settles += 1
            request = {**request, "frame": r.get("frame", "")}
            time.sleep(SETTLE_PAUSE)
            continue
        if r.get("error") != "not-rendered":
            return r
        if late:
            return dict(r, detail=f"still not found after {RUN_LIMIT:.0f} s")
        bottom_seen = bottom_seen or bool(r.get("atBottom"))
        if not bottom_seen and down < MAX_PAGES_DOWN:
            direction = "down"
            down += 1
        elif not looked_again:
            looked_again = True   # a conversation just opened can still be drawing
            time.sleep(0.8)
            continue
        elif bottom_seen and up < MAX_PAGES_UP:
            # Paging up only from the newest message: the first match met on
            # the way up is then the newest of its look-alikes.
            direction = "up"
            up += 1
        else:
            return r
        paged = run({**request, "mode": "page", "direction": direction})
        if not paged.get("ok"):
            return {"ok": False, "error": "not-rendered", "detail": paged.get("error")}
        if paged.get("atBottom"):
            bottom_seen = True   # nothing below: look again rather than page
            continue
        time.sleep(0.6)


# ------------------------------------------------------------------ consent

# OSStatus answers of AEDeterminePermissionToAutomateTarget.
AE_GRANTED, AE_DENIED, AE_WOULD_ASK, AE_NOT_RUNNING = 0, -1743, -1744, -600
# Apple's call has no timeout of its own. Over ssh on macOS 27.2 it NEVER
# returns for a target addressed by bundle id, the LaunchServices lookup that
# ssh sessions on 27.2 no longer get (measured 2026-11-11 on the gateway:
# blocked past 15 s by bundle id, answered 0 in 0.04 s by PID). Every tapback
# then hung inside the Messages UI lock, before Messages was touched, until the
# caller gave up. Addressed by PID and bounded, an answer that does not come
# is "cannot confirm", which refuses, exactly like any other unknown answer.
AE_PROBE_SECONDS = 5.0


def _bounded(fn, seconds: float):
    """fn() on a daemon thread; None if it has not answered within `seconds`
    or raised. The thread is left behind: the run refuses and exits."""
    box = []
    worker = threading.Thread(target=lambda: box.append(fn()), daemon=True)
    worker.start()
    worker.join(seconds)
    return box[0] if box else None


def _pid_of(name: str):
    """PID of the running process with exactly this name, or None (pgrep: no
    LaunchServices, which ssh sessions on 27.2 cannot use)."""
    try:
        out = subprocess.run(["/usr/bin/pgrep", "-x", name], capture_output=True, text=True, timeout=2).stdout.split()
        return int(out[0]) if out else None
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def _ask_until_ready(pid_of, ask, seconds: float, tries: int = 20, pause: float = 0.25, sleep=time.sleep):
    """Ask once there is a pid, again while macOS answers -600. A process that
    has just been launched has a pid at once but answers -600 until it has
    checked in (measured 2026-11-11 after a reboot: one call, one -600, a
    refusal). A call that does not answer in `seconds` ends it: None."""
    status = AE_NOT_RUNNING
    for _ in range(tries):   # launching takes about a second
        pid = pid_of()
        if pid:
            status = _bounded(lambda: ask(pid), seconds)
            if status != AE_NOT_RUNNING:
                return status
        sleep(pause)
    return status


def ae_permission(bundle: str = "com.apple.systemevents", process: str = "System Events",
                  pid_of=_pid_of, seconds: float = AE_PROBE_SECONDS):
    """Ask macOS whether this process may send Apple events to `bundle`,
    with askUserIfNeeded=false: it answers and NEVER prompts. Needed on
    macOS 27, which no longer keeps a per-user TCC.db where
    system_events_consent reads one (measured 27.0.1: the folder is gone,
    and the Automation grant is in neither TCC.db an ssh session can read,
    while imsg-read's System Events calls succeed). The target must be
    running or the answer is -600, so System Events is launched first,
    hidden, through LaunchServices -- a launch is not an Apple event and
    needs no consent; it is then addressed by PID (see AE_PROBE_SECONDS).
    None when the call cannot be made at all or does not answer in time."""
    try:
        import ctypes
        import struct

        cs = ctypes.CDLL("/System/Library/Frameworks/CoreServices.framework/CoreServices")

        class AEDesc(ctypes.Structure):
            _fields_ = [("descriptorType", ctypes.c_uint32), ("dataHandle", ctypes.c_void_p)]

        def four(code: str) -> int:
            return struct.unpack(">I", code.encode())[0]

        cs.AECreateDesc.argtypes = [ctypes.c_uint32, ctypes.c_void_p, ctypes.c_long, ctypes.POINTER(AEDesc)]
        cs.AECreateDesc.restype = ctypes.c_int16
        cs.AEDeterminePermissionToAutomateTarget.argtypes = [
            ctypes.POINTER(AEDesc), ctypes.c_uint32, ctypes.c_uint32, ctypes.c_bool]
        cs.AEDeterminePermissionToAutomateTarget.restype = ctypes.c_int32
        cs.AEDisposeDesc.argtypes = [ctypes.POINTER(AEDesc)]

        subprocess.run(["open", "-g", "-j", "-b", bundle], capture_output=True, timeout=10)

        def ask(pid):
            target = ctypes.c_int32(pid)
            desc = AEDesc()
            if cs.AECreateDesc(four("kpid"), ctypes.byref(target), ctypes.sizeof(target), ctypes.byref(desc)) != 0:
                return None
            try:
                return cs.AEDeterminePermissionToAutomateTarget(
                    ctypes.byref(desc), four("****"), four("****"), False)
            finally:
                cs.AEDisposeDesc(ctypes.byref(desc))

        return _ask_until_ready(lambda: pid_of(process), ask, seconds)
    except Exception:
        return None


def system_events_consent(path: str = USER_TCC, probe=ae_permission) -> str:
    """"" when this run cannot raise a consent prompt nobody will answer,
    else why not. Over ssh, the first System Events call from
    sshd-keygen-wrapper is an Automation prompt on the Mac's screen, while
    the person who asked sits at the Linux box. Unanswered, it is recorded as
    a denial that Settings may refuse to undo (#36). So over ssh this tool
    acts only once TCC.db records the grant (blip-check --markread asks for
    it: over ssh, so the grant is sshd's, not Terminal's, with someone at the
    Mac to click). The same client's Full Disk Access makes the user TCC.db
    readable; if it cannot be read, or reads differently, the answer is no.
    Run at the Mac itself there is someone to click, and nothing is checked."""
    if not os.environ.get("SSH_CONNECTION"):
        return ""
    if not os.path.exists(path):   # macOS 27: no per-user TCC.db; ask macOS instead
        status = probe()
        if status == AE_GRANTED:
            return ""
        if status == AE_WOULD_ASK:
            return ("System Events has not been allowed for ssh on this Mac yet, and its prompt would go "
                    "unanswered; run blip-check --markread over ssh while someone at the Mac clicks Allow")
        if status == AE_DENIED:
            return ("Automation for System Events is denied for sshd-keygen-wrapper; on the Mac run "
                    "`tccutil reset AppleEvents`, then run blip-check --markread over ssh while someone at the "
                    "Mac clicks Allow")
        return (f"cannot confirm the Automation grant for System Events (no TCC.db, and macOS answered "
                f"{status}), so nothing was done; run blip-check --markread over ssh while someone at the "
                "Mac clicks Allow")
    try:
        with contextlib.closing(sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=2)) as con:
            row = con.execute(
                """SELECT auth_value FROM access WHERE service = 'kTCCServiceAppleEvents'
                     AND client = ? AND indirect_object_identifier = 'com.apple.systemevents'""",
                (SSH_CLIENT,)).fetchone()
    except sqlite3.Error:
        return ("cannot confirm the Automation grant for System Events (TCC.db unreadable), so nothing was "
                "done; run blip-check --markread over ssh while someone at the Mac clicks Allow")
    if row is None:
        return ("System Events has not been allowed for ssh on this Mac yet, and its prompt would go "
                "unanswered; run blip-check --markread over ssh while someone at the Mac clicks Allow")
    if row[0] != 2:
        return ("Automation for System Events is denied for sshd-keygen-wrapper; on the Mac run "
                "`tccutil reset AppleEvents`, then run blip-check --markread over ssh while someone at the "
                "Mac clicks Allow")
    return ""


# --------------------------------------------------------------------- run

def react(con, target: dict, kind: int, remove: bool, self_handles: list, ui, run=jxa, emoji="", name="") -> dict:
    """Steps 3-4: one press, then chat.db (see the module docstring). `ui` is the
    imsg-read module (lock, selection, focus); tests pass a stand-in."""
    action = emoji if emoji else TAPBACKS_BY_KIND[kind]
    rows = my_rows(con, target["guids"], self_handles)
    expected = emoji_plan(rows, emoji, remove) if emoji else plan(current_kind(rows), kind, remove)
    if expected is None:
        return {"ok": True, "result": "unchanged"}
    if run is jxa and macos_major() >= 27:
        version = tuple(int(x) for x in platform.mac_ver()[0].split(".")[:2])
        if version < (27, 2):
            raise Stop("unsupported-version", EX_UNSUPPORTED, "picker reactions require macOS 27.2 or newer; nothing was sent")
        if emoji:
            ax = NativeAX(time.monotonic() + RUN_LIMIT)
            try:
                if not ax.preflight_post():
                    raise Stop("event-access-denied", EX_NOPERM, "event-posting permission is missing for the bridge process; nothing was sent")
            finally:
                ax.close()
    why = system_events_consent()   # before ensure_messages: it is already a System Events call
    if why:
        raise Stop("consent", EX_NOPERM, why)
    why = ui.ensure_messages()
    if why:
        raise Stop("unavailable", EX_UNAVAILABLE, why)
    why = ui.accessibility()
    if why:
        raise Stop("accessibility", EX_NOPERM, why)
    started = time.monotonic()
    deadline = started + RUN_LIMIT
    prev = ui.frontmost()
    try:
        why = ui.select_chat(target["chat"])
        if why:
            raise Stop("unavailable", EX_UNAVAILABLE, why)
        since = apple_now()
        # macOS 27 bubbles carry no tapbacks, only the way to their picker.
        r = (picker_route(target, action, run, emoji=emoji, name=name, remove=remove, deadline=deadline) if macos_major() >= 27
             else perform(target, action, run=run, deadline=deadline))
        if macos_major() >= 27 and r.get("error") == "not-offered" and PICKER_SIGN in r.get("offered", []):
            r = picker_route(target, action, run, emoji=emoji, name=name, remove=remove, deadline=deadline)
        if not r.get("ok") and r.get("error") not in MAYBE_PERFORMED:
            if macos_major() >= 27 and run is jxa and r.get("error") not in NOT_OPENED:
                close_picker()
            raise failure(r, action)   # nothing was pressed
        row = answer(con, target, self_handles, since)
        if row is None:
            if macos_major() >= 27 and run is jxa:
                close_picker()
            if not r.get("ok"):
                raise failure(r, action)
            raise Stop("no-row", EX_TEMPFAIL, f"'{action}' was performed but no tapback row reached chat.db")
        if row["type"] != expected:
            raise Stop("unexpected", EX_TEMPFAIL, f"chat.db shows tapback type {row['type']}, not {expected}",
                       type=row["type"])
        if emoji and row.get("emoji") != emoji:
            raise Stop("unexpected-emoji", EX_TEMPFAIL,
                       "chat.db did not confirm the exact requested emoji; check the reaction in Messages")
    finally:
        ui.restore_front(prev)
    return {"ok": True, "result": "removed" if expected >= 3000 else "added", "type": expected,
            "seconds": round(time.monotonic() - started, 1)}


def macos_major() -> int:
    try:
        return int(platform.mac_ver()[0].split(".")[0])
    except (ValueError, IndexError):
        return 0


def picker_route(target: dict, action: str, run, emoji="", name="", remove=False, deadline=None) -> dict:
    """macOS 27: open the picker from the target bubble, then choose in it. The
    bubble search finds, settles and re-reads the bubble before that one press."""
    if run is jxa:
        version = tuple(int(x) for x in platform.mac_ver()[0].split(".")[:2])
        if version < (27, 2):
            return {"ok": False, "error": "not-offered", "offered": []}
        clear_stale_picker()
    opened = perform(target, PICKER_SIGN, run=run, deadline=deadline)
    if not opened.get("ok"):
        # Nothing was chosen, even if the press landed: only the picker sends.
        return {"ok": False, "error": "no-picker"} if opened.get("error") in MAYBE_PERFORMED else opened
    request = {"mode": "picker", "text": target["text"], "action": action}
    if emoji:
        request.update(emoji=emoji, name=name, remove=remove)
    if run is jxa:
        return native_emoji_picker(request)
    return run(request)


def close_picker() -> None:
    """Escape out of a picker a run left open. Left there it blocks the next run,
    and the JXA scan's entireContents would then walk the whole emoji catalogue,
    pinning Messages' main thread for minutes (27.2). Only ever to Messages."""
    script = 'tell application "System Events"\nif frontmost of process "Messages" then\nkey code 53\ndelay 0.2\nkey code 53\nend if\nend tell'
    try:
        subprocess.run(["/usr/bin/osascript", "-e", script], capture_output=True, timeout=10)
    except subprocess.TimeoutExpired:
        pass


def clear_stale_picker() -> None:
    """Before any scan: the native check never enumerates the catalogue. Each
    Escape closes one layer, the catalogue first and then the picker under it."""
    for _ in range(3):
        ax = NativeAX(time.monotonic() + 5)
        try:
            stale = bool(ax.pickers() or ax.popovers())
        except Exception:
            stale = False
        finally:
            ax.close()
        if not stale:
            return
        close_picker()
        time.sleep(0.5)


def failure(r: dict, action: str) -> Stop:
    error = r.get("error") or "failed"
    if error == "event-access-denied":
        return Stop(error, EX_NOPERM, "event-posting permission is missing for the bridge process; nothing was sent")
    if error in {"emoji-not-offered", "emoji-picker-unavailable", "ambiguous-emoji"}:
        return Stop(error, EX_NOT_OFFERED,
                    "Messages did not expose that exact emoji as an accessible reaction; nothing was sent. "
                    "Try a recently used emoji or a classic Tapback")
    if error == "picker-elsewhere":
        return Stop(error, EX_TEMPFAIL, "the tapback picker opened on another message; nothing was done")
    if error == "no-picker":
        return Stop(error, EX_UNAVAILABLE, "Messages did not open its tapback picker; nothing was done")
    if error == "not-offered":
        return Stop("not-offered", EX_NOT_OFFERED,
                    f"the bubble does not offer '{action}' (Messages may have renamed it); nothing was done",
                    action=action, offered=r.get("offered", [])[:20])
    if error == "no-conversation":
        return Stop("unavailable", EX_UNAVAILABLE, "Messages shows no conversation")
    return Stop(error, EX_TEMPFAIL, f"{error}{': ' + r['detail'] if r.get('detail') else ''}")


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="imsg-react", add_help=True,
                                description="Add or remove one tapback. Dry run unless --yes.")
    p.add_argument("tapback", nargs="?", choices=sorted(TAPBACKS))
    p.add_argument("--guid", required=True, help="the message's GUID (message.guid)")
    p.add_argument("--emoji-stdin", action="store_true", help="read an exact emoji and optional search name as JSON on stdin")
    p.add_argument("--remove", action="store_true", help="remove this tapback instead of adding it")
    p.add_argument("--yes", action="store_true", help="act; without it nothing on the Mac changes")
    try:
        a = p.parse_args(argv)
    except SystemExit as e:
        return EX_USAGE if e.code else 0
    if not re.fullmatch(r"[A-Za-z0-9:/_-]{1,128}", a.guid):
        return emit(Stop("usage", EX_USAGE, "that is not a message GUID"))
    if bool(a.tapback) == bool(a.emoji_stdin):
        return emit(Stop("usage", EX_USAGE, "choose one classic tapback or --emoji-stdin"))
    try:
        custom = read_emoji(sys.stdin) if a.emoji_stdin else {"emoji": "", "name": ""}
        imsg = sibling("imsg")
        try:
            self_handles = sibling("imsg-send").detect_self_handles()
        except Exception:
            self_handles = []
        con = sqlite3.connect(f"file:{imsg.DB_PATH}?mode=ro", uri=True, timeout=5)
        con.row_factory = sqlite3.Row
        target = resolve(con, imsg, a.guid, self_handles)
        action, kind = (custom["emoji"], 6) if a.emoji_stdin else TAPBACKS[a.tapback]
        if not a.yes:
            rows = my_rows(con, target["guids"], self_handles)
            expected = emoji_plan(rows, custom["emoji"], a.remove) if a.emoji_stdin else plan(current_kind(rows), kind, a.remove)
            would = "unchanged" if expected is None else ("remove" if expected >= 3000 else "add")
            return emit({"ok": True, "result": "dry-run", "would": would, "action": action})
        ui = sibling("imsg-read")
        with ui.messages_ui_lock():
            return emit(react(con, target, kind, a.remove, self_handles, ui, **custom))
    except Stop as stop:
        return emit(stop)
    except TimeoutError as exc:   # the Messages lock; before OSError, which it is
        return emit(Stop("busy", EX_TEMPFAIL, str(exc)))
    except (sqlite3.Error, OSError) as exc:
        return emit(Stop("unavailable", EX_UNAVAILABLE, str(exc)))
    except Exception as exc:   # never exit 1 by accident: that is "not-offered"
        return emit(Stop("error", EX_SOFTWARE, f"{type(exc).__name__}: {exc}"))


REACT_LOG = os.path.expanduser("~/.blip/react.log")


def log_outcome(code: str, exit_code: int, seconds=None) -> None:
    """One line per run beside the tools: when, the outcome code, the exit
    status. Never a GUID or message text. Kept under 64 KB."""
    try:
        if os.path.exists(REACT_LOG) and os.path.getsize(REACT_LOG) > 65536:
            os.replace(REACT_LOG, REACT_LOG + ".1")
        line = f"{dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {code} exit={exit_code}"
        if seconds is not None:
            line += f" {seconds}s"
        with open(REACT_LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def emit(result) -> int:
    if isinstance(result, Stop):
        log_outcome(str(result.result.get("code", "?")), result.exit_code)
        if result.why:
            sys.stderr.write(f"imsg-react: {result.why}\n")
        print(json.dumps(result.result, ensure_ascii=False))
        return result.exit_code
    log_outcome(str(result.get("result", "ok")), 0, result.get("seconds"))
    print(json.dumps(result, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
