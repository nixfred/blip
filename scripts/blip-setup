#!/usr/bin/env bash
# blip-setup — Linux-side first run for Blip. Idempotent; safe to re-run.
#
#   blip-setup [user@]mac-host        # e.g. blip-setup you@mac-mini, or a Tailscale name
#
# Steps:
#   1. ~/.config/blip/bridge.conf   host= (and remote_bin=, python=)
#   2. ~/.ssh/config                 ControlMaster block for the host (47 ms warm
#                                    round trips — Blip polls; this is required)
#   3. ~/bin/{imsg,imsg-send,imsg-read,contacts}  the bridge shim (existing files backed up;
#                                    claude-on-mac remote shims are left alone)
#   4. Mac install                   copies bridge/mac to the Mac and runs
#                                    install.sh there (needs ssh access already)
#   5. smoke test                    imsg recent 1 through the shim
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
host="${1:-}"

# 0. Linux prerequisites — say exactly what is missing instead of failing later
missing=()
for dep in ssh scp bun jq notify-send wl-copy xdg-open; do
  command -v "$dep" >/dev/null 2>&1 || missing+=("$dep")
done
if (( ${#missing[@]} )); then
  echo "✗ missing on this machine: ${missing[*]}" >&2
  echo "  pacman -S --needed openssh bun jq libnotify wl-clipboard xdg-utils   (Omarchy/Arch names)" >&2
  exit 69
fi
echo "✓ Linux prerequisites present (ssh scp bun jq notify-send wl-copy xdg-open)"
conf_dir="$HOME/.config/blip"
conf="$conf_dir/bridge.conf"

# bridge.conf is DATA (audit #7): read the two keys we care about, never source it.
prev_automation=""; prev_country=""; prev_contact_writes=""
if [[ -r "$conf" ]]; then
  [[ -z "$host" ]] && host="$(sed -n 's/^host=//p' "$conf" | head -1 | tr -d '"\x27 ')"
  prev_automation="$(sed -n 's/^automation=//p' "$conf" | head -1 | tr -d '"\x27 ')"
  prev_country="$(sed -n 's/^country_code=//p' "$conf" | head -1 | tr -d '"\x27 ')"
  prev_contact_writes="$(sed -n 's/^contact_writes=//p' "$conf" | head -1 | tr -d '"\x27 ')"
fi
if [[ -z "${host:-}" ]]; then
  read -r -p "Mac ssh target ([user@]host, Tailscale name works best): " host
fi
[[ -n "$host" ]] || { echo "no host given" >&2; exit 64; }
if ! [[ "$host" =~ ^([A-Za-z0-9._-]+@)?[A-Za-z0-9._:-]+$ ]]; then
  echo "✗ '$host' is not a [user@]hostname — no spaces, quotes, or shell characters" >&2; exit 64
fi

# 1. config. Keys the installer does not own — push_read, link_previews,
# ui_font, ui_font_size, anything set by hand — must survive a re-run; a
# wholesale rewrite silently re-enabled what the user had turned off (Astra #18).
kept=""
[[ -r "$conf" ]] && kept="$(grep -vE '^[[:space:]]*(#|$|host=|remote_bin=|python=|key=|automation=|country_code=|contact_writes=)' "$conf" || true)"
mkdir -p "$conf_dir"
{
  echo "# Blip bridge — read (never sourced) by ~/bin/imsg, imsg-send, imsg-read, contacts"
  echo "host=$host"
  echo "# single-quoted on purpose: expanded on the MAC, not here"
  echo "remote_bin='\$HOME/.blip/bin'"
  echo "python=python3"
  echo "key=$HOME/.ssh/blip_ed25519"
  echo "# on = local scripts may send/read through 'qs ipc call nixfred.blip …'"
  echo "automation=${BLIP_AUTOMATION:-${prev_automation:-off}}"   # a re-run keeps a hand-set value
  echo "# country calling code for numbers typed without one (1 = US/Canada, 44 = UK, 49 = DE…)"
  echo "country_code=${prev_country:-1}"
  echo "# on = show confirmed, undoable Mac Contacts repair controls"
  echo "contact_writes=${BLIP_CONTACT_WRITES:-${prev_contact_writes:-off}}"
  if [[ -n "$kept" ]]; then echo "# kept from the previous bridge.conf"; printf '%s\n' "$kept"; fi
} > "$conf"
chmod 0600 "$conf"
echo "✓ $conf"

# 2. ssh ControlMaster (append a block only if this host has none)
mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
sshcfg="$HOME/.ssh/config"
touch "$sshcfg"
hostname_only="${host##*@}"
if ! grep -qE "^Host[[:space:]]+.*\b${hostname_only}\b" "$sshcfg"; then
  cat >> "$sshcfg" <<EOF

# blip-setup: multiplexed sessions so Blip's polling costs ~50 ms, not a handshake
Host $hostname_only
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m
  ServerAliveInterval 30
EOF
  echo "✓ ssh ControlMaster block added for $hostname_only"
else
  echo "• ssh config already has a Host block for $hostname_only — left as is (make sure ControlMaster auto is on)"
fi

# 3. shims
mkdir -p "$HOME/bin"
for t in imsg imsg-send imsg-read contacts; do
  target="$HOME/bin/$t"
  if [[ -e "$target" && ! -L "$target" ]] && ! grep -q "blip-shim" "$target" 2>/dev/null; then
    cp -p "$target" "$target.pre-blip.$(date +%s)"
    echo "• backed up existing $target"
  fi
  install -m 0755 "$here/bridge/linux/blip-shim" "$target"
done
echo "✓ shims installed: ~/bin/imsg ~/bin/imsg-send ~/bin/imsg-read ~/bin/contacts"

# 4. Mac install (needs ssh to already work — key-based)
if ssh -n -o ConnectTimeout=6 -o BatchMode=yes "$host" true 2>/dev/null; then
  ssh "$host" 'mkdir -p ~/.blip/src'
  scp -q "$here"/bridge/mac/* "$host:~/.blip/src/"
  ssh "$host" 'bash ~/.blip/src/install.sh --no-check'   # the check runs below, after the "be at the Mac" pause

  # python3 on a fresh Mac is a Command Line Tools STUB that exits 1 (and may
  # pop an install dialog). Every bridge tool needs the real thing; say so
  # here instead of letting the key-confinement check misdiagnose it.
  if ! ssh "$host" "python3 -c 'import sqlite3, subprocess'" >/dev/null 2>&1; then
    echo "✗ python3 on $host cannot run: install Xcode Command Line Tools there —  xcode-select --install  — then re-run blip-setup" >&2
    exit 1
  fi

  # Contact writes require a second, Mac-local gate that the restricted Blip
  # key cannot create for itself. Only an explicit setup environment opt-in
  # installs it; ordinary setup remains read-only/open-only.
  if [[ "${BLIP_CONTACT_WRITES:-off}" == on ]]; then
    ssh "$host" 'umask 077; mkdir -p ~/.blip; printf "enabled-v1\n" > ~/.blip/contact-writes-enabled; chmod 0600 ~/.blip/contact-writes-enabled'
    echo "✓ Mac contact-write gate enabled (explicit BLIP_CONTACT_WRITES=on)"
  fi

  # 4b. Dedicated key, confined on the Mac to blip-dispatch (restrict = no
  # shell, no forwarding, no pty). Your everyday key is untouched; Blip's key
  # cannot do anything but run the five bridge tools.
  key="$HOME/.ssh/blip_ed25519"
  [[ -f "$key" ]] || ssh-keygen -q -t ed25519 -N "" -C "blip@$(hostname)" -f "$key"
  pub="$(cut -d" " -f1,2 < "$key.pub")"
  ssh "$host" "umask 077; mkdir -p ~/.ssh; touch ~/.ssh/authorized_keys; \
    if [ -s ~/.ssh/authorized_keys ] && [ \"\$(tail -c1 ~/.ssh/authorized_keys)\" != '' ]; then echo >> ~/.ssh/authorized_keys; fi; \
    grep -qF -- '$pub' ~/.ssh/authorized_keys || \
    printf '%s\n' 'restrict,command=\"\$HOME/.blip/bin/blip-dispatch\" $pub' >> ~/.ssh/authorized_keys"
  if [[ "$(ssh -i "$key" -o IdentitiesOnly=yes -o BatchMode=yes -o ControlPath=none "$host" ping 2>/dev/null)" == pong ]] \
     && ! ssh -i "$key" -o IdentitiesOnly=yes -o BatchMode=yes -o ControlPath=none "$host" true >/dev/null 2>&1; then
    echo "✓ dedicated key enrolled: $key can run only the Blip tools on $host"
  else
    echo "✗ dedicated key did not confine as expected — check ~/.ssh/authorized_keys on the Mac" >&2; exit 1
  fi

  # The three grants, checked in the ssh context that matters. The automation
  # check TALKS to Messages.app, which pops the one-time Allow prompt on the
  # Mac's screen when the grant is missing — so give the user a beat to click.
  # The prompt expires in about two minutes and an EXPIRED prompt is recorded
  # as a denial that macOS 26's Settings switch may then refuse to flip (#36):
  # say so before it fires, not after.
  echo
  echo "Next: the Mac will ask, ON ITS OWN SCREEN, whether sshd may control Messages."
  echo "  Be at the Mac (or in Screen Sharing) and click Allow within two minutes — an"
  echo "  unanswered prompt is recorded as a denial. Ready?"
  read -r -p "  Press Enter to run the permission check: " _
  granted=0
  for attempt in 1 2 3; do
    echo; echo "Checking Mac permissions (attempt $attempt)…"
    # a grant applies to NEW sessions: drop the multiplexed master so the re-check sees it
    ssh -O exit "$host" >/dev/null 2>&1 || true
    if ssh "$host" 'python3 ~/.blip/bin/blip-check'; then granted=1; break; fi
    if [[ $attempt -lt 3 ]]; then
      read -r -p "Grant what is missing on the Mac (an Allow prompt may be on its screen), then press Enter to re-check (or Ctrl-C): " _
    fi
  done
  if [[ $granted != 1 ]]; then
    # Reading chat.db works without the Automation grant, so the smoke test
    # below would have said "bridge is up" over a Mac that cannot send (Astra #19).
    echo "✗ The Mac is still missing a permission after 3 checks. Blip can read but cannot send until it is granted." >&2
    echo "  Fix it on the Mac, then re-run blip-setup — or check any time with: ssh $host python3 ~/.blip/bin/blip-check" >&2
    exit 1
  fi
else
  echo "✗ cannot ssh to $host non-interactively yet. Set up key auth (ssh-copy-id $host), then re-run blip-setup." >&2
  echo "  On the Mac, you can also run the installer by hand:" >&2
  echo "    scp -r $here/bridge/mac $host:~/.blip/src && ssh $host bash ~/.blip/src/install.sh" >&2
  exit 69
fi

# 5. smoke test (through the shim, i.e. the dedicated key)
echo
# Content-free on purpose: a message body echoed raw into a terminal is an
# escape-sequence injection vector (audit / war room #53) and a shoulder-surf.
if out="$("$HOME/bin/imsg" --json recent 1 2>&1)"; then
  n="$(printf '%s' "$out" | jq -r 'length' 2>/dev/null || echo "?")"
  echo "✓ bridge is up — $n message(s) readable through the shim"
  echo
  # 6. the UI font. Blip renders in SF Pro when the machine has it, else Inter,
  # else the Omarchy theme font. We install Inter (OFL, in Arch's `extra`) and
  # only POINT AT Apple for SF Pro: its licence forbids redistribution, so the
  # font is never carried in this repo and never fetched by us.
  if fc-list : family 2>/dev/null | grep -qiE '"'"'(^|,)\s*(SF Pro Text|SF Pro Display|Inter)\s*($|,)'"'"'; then
    echo "✓ UI font present — Blip will render like Messages rather than in the theme's monospace"
  else
    echo "Blip looks most like Messages in a UI sans. Omarchy's font is monospace."
    echo "  Inter  — open licence, drawn for interfaces:  sudo pacman -S --needed inter-font"
    echo "           https://github.com/rsms/inter"
    echo "  SF Pro — Apple's own, what Messages uses; download it from Apple:"
    echo "           https://developer.apple.com/fonts/   (AUR: otf-san-francisco fetches it for you)"
    echo "  Neither is required, and Blip ships no fonts. Set ui_font=theme in bridge.conf to always"
    echo "  use the Omarchy family."
    if command -v pacman >/dev/null 2>&1; then
      read -r -p "Install Inter now with pacman? [y/N] " ans
      case "$ans" in
        [Yy]*) sudo pacman -S --needed --noconfirm inter-font && echo "✓ Inter installed" || echo "  (skipped — install it yourself later)" ;;
        *) echo "  (skipped)" ;;
      esac
    fi
    echo
  fi
  echo "Next: restart the Omarchy shell (omarchy-restart-shell). Toasts are allowlist-only:"
  echo "  ~/.config/blip/allowlist.json  →  { \"allow\": [\"+15551234567\"] }"
else
  echo "✗ imsg failed through the bridge:"; echo "  $out"
  echo "  Usually a missing Full Disk Access grant on the Mac — see install.sh's notes, then re-run."
  exit 1
fi
