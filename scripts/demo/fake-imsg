#!/usr/bin/env bun
/**
 * A stand-in for the Mac bridge, for screenshots and demos.
 *
 * Blip's whole Linux side talks to one program: `$HOME/bin/imsg`. Point HOME
 * at a sandbox with this script in `bin/` and the REAL collector, thread
 * loader, avatar fetcher and QML run against invented people instead of
 * someone's actual Messages database. That is how the README screenshots are
 * made: real rendering, no real conversation.
 *
 * Serves exactly the subcommands Blip uses:
 *   --json chats N · --json groups · --json recent N
 *   --json --rich thread --chat <id> N · avatar -- <handle> · avatar --chat <id>
 *
 * Every name here is invented and every number is in the 555-0100..555-0199
 * range reserved for fiction.
 */
import { readFileSync } from "node:fs";
import { spawnSync } from "node:child_process";
import { join, dirname } from "node:path";
import { fileURLToPath } from "node:url";

const HERE = dirname(fileURLToPath(import.meta.url));
const F = JSON.parse(readFileSync(join(HERE, "fixtures.json"), "utf8"));

const argv = process.argv.slice(2);
const has = (f: string) => argv.includes(f);
const val = (f: string) => { const i = argv.indexOf(f); return i >= 0 ? argv[i + 1] ?? "" : ""; };
const sub = argv.find((a) => !a.startsWith("-") && a !== val("--chat")) ?? "";

/** Fixed clock so screenshots are reproducible: today at 09:41 local. */
const BASE = (() => { const d = new Date(); d.setHours(9, 41, 0, 0); return d; })();
const stamp = (minutes: number): string => {
  const d = new Date(BASE.getTime() + minutes * 60_000);
  const p = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
};

const person = (h: string) => F.people.find((p: { handle: string }) => p.handle === h);
const group = (c: string) => F.groups.find((g: { chat: string }) => g.chat === c);
const nameOf = (h: string) => person(h)?.name ?? null;

/** Whatever bold sans this box actually has — font NAMES vary per distro. */
const FONT = (() => {
  const r = spawnSync("fc-match", ["-f", "%{file}", "sans:bold"], { encoding: "utf8" });
  return r.status === 0 && r.stdout ? r.stdout.trim() : "helvetica";
})();

/** One deterministic tile per handle: initials on a flat colour, via magick. */
function avatarPng(seedName: string | null, color: string): Buffer | null {
  const initials = (seedName ?? "#")
    .split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join("") || "#";
  const r = spawnSync("magick", [
    "-size", "240x240", `xc:${color}`,
    "-gravity", "center", "-font", FONT, "-pointsize", "96",
    "-fill", "white", "-annotate", "+0+0", initials,
    "png:-",
  ], { maxBuffer: 8 << 20 });
  return r.status === 0 && r.stdout?.length ? (r.stdout as Buffer) : null;
}

/** A group's "photo": two initials on a split field, so it reads as a group. */
function groupPng(name: string, color: string): Buffer | null {
  const r = spawnSync("magick", [
    "-size", "240x240", `xc:${color}`,
    "-gravity", "center", "-font", FONT, "-pointsize", "64",
    "-fill", "white", "-annotate", "+0+0", name.split(/\s+/).map((w) => w[0]).join("").toUpperCase(),
    "png:-",
  ], { maxBuffer: 8 << 20 });
  return r.status === 0 && r.stdout?.length ? (r.stdout as Buffer) : null;
}

/** One preview per person, so a screenshot of the list does not read as
 *  eight copies of the same sentence. */
const PREVIEWS = [
  "sounds good, see you then",
  "the part came in, want me to grab it?",
  "running 10 late, traffic on the bridge",
  "did you ever hear back about the quote",
  "sent the photos to the printer",
  "yes! saturday works",
  "no rush, whenever you get a sec",
  "that place closed, try the one on 5th",
  "ok I found it, it was in the car",
];

interface Row { [k: string]: unknown }

/** The demo conversation, newest last, with rich extras filled in. */
function conversation(): Row[] {
  const c = F.conversation;
  const who = person(c.chat);
  return c.messages.map((m: Record<string, never>, i: number) => {
    const row: Row = {
      id: 900000 + i,
      guid: `DEMO-${String(i).padStart(4, "0")}`,
      ts: stamp(Number(m.min)),
      from_me: m.from_me === true,
      handle: c.chat,
      name: m.from_me ? null : who?.name ?? null,
      service: "iMessage",
      chat: c.chat,
      text: String(m.text ?? ""),
      read: true,
      tapback: m.tapback === true,
      error: 0,
      read_at: m.read_at ? stamp(Number(m.min) + 2) : null,
      tapbacks: m.tapbacks || null,
      stickers: Array.isArray(m.stickers) ? (m.stickers as any[]).map(sticker => ({...sticker, ts: stamp(Number(m.min) + 1)})) : [],
      attachments: Array.isArray(m.attachments)
        ? (m.attachments as unknown as Array<{ name: string; mime: string; sticker?: unknown }>).map((a, k) => ({
          id: String(700000 + i * 10 + k), name: a.name, mime: a.mime, bytes: a.mime.startsWith("audio/") ? 1152044 : a.sticker ? 12000 : 1843200, ...(a.sticker ? {sticker:a.sticker} : {}),
        }))
        : null,
      reply_to: m.reply_to ? { text: String(m.reply_to), from_me: false } : null,
      edited: m.edited === true, retracted: m.retracted === true, effect: null, audio: m.audio === true, link: null,
    };
    return row;
  });
}

function chatsRows(): Row[] {
  const rows: Row[] = [];
  const conv = conversation();
  const last = conv[conv.length - 1]!;
  const pinIndex = (id: string) => {
    const i = F.pinned.indexOf(id);
    return i < 0 ? null : i;
  };

  for (const p of F.people) {
    const isConv = p.handle === F.conversation.chat;
    rows.push({
      id: p.handle, name: p.name, service: "iMessage",
      messages: isConv ? conv.length : 12,
      last: isConv ? String(last.ts) : stamp(-300 - rows.length * 47),
      last_text: isConv ? String(last.text) : PREVIEWS[F.people.indexOf(p) % PREVIEWS.length],
      last_from_me: isConv ? last.from_me : false,
      last_handle: p.handle, last_name: p.name,
      pinned: pinIndex(p.handle) !== null, pin_order: pinIndex(p.handle), aliases: [],
    });
  }
  for (const g of F.groups) {
    rows.push({
      id: g.chat, name: g.name, service: "iMessage", messages: 214,
      last: stamp(-70 - rows.length * 31),
      last_text: g.name === "Trail Crew" ? "who has the topo map" : "chapter 4 by thursday?",
      last_from_me: false, last_handle: g.members[0], last_name: nameOf(g.members[0]),
      pinned: pinIndex(g.chat) !== null, pin_order: pinIndex(g.chat), aliases: [],
    });
  }
  for (const s of F.shortcodes) {
    rows.push({
      id: s.handle, name: null, service: s.service, messages: 9,
      last: stamp(-150), last_text: s.text, last_from_me: false,
      last_handle: s.handle, last_name: null, pinned: false, pin_order: null, aliases: [],
    });
  }
  return rows.sort((a, b) => (String(a.last) < String(b.last) ? 1 : -1));
}

function main(): void {
  if (sub === "chats") { console.log(JSON.stringify(chatsRows(), null, 2)); return; }

  if (sub === "groups") {
    console.log(JSON.stringify(F.groups.map((g: Record<string, never>) => ({
      chat: g.chat, guid: g.guid, name: g.name, participants: g.members, last: stamp(-70),
    })), null, 2));
    return;
  }

  if (sub === "avatar") {
    const chat = val("--chat");
    const png = chat
      ? (() => { const g = group(chat); return g ? groupPng(g.name, g.color) : null; })()
      : (() => {
        const h = argv[argv.indexOf("--") + 1] ?? "";
        const p = person(h);
        return p ? avatarPng(p.name, p.color) : null;
      })();
    if (!png) process.exit(1);
    process.stdout.write(png);
    return;
  }

  if (sub === "thread" || sub === "recent" || sub === "from") {
    const chat = val("--chat");
    const rows = chat === "" || chat === F.conversation.chat ? conversation() : [];
    console.log(JSON.stringify(rows, null, 2));
    return;
  }

  // Real bytes for the inline-photo path: fetch.ts asks for `attachment <id>
  // --jpeg [--max-dim N]`, so serve a generated JPEG at the size requested.
  // Without this the demo could never show what a photo message looks like.
  if (sub === "attachment") {
    const dim = val("--max-dim") || "1600";
    const id = argv.find((a) => /^[0-9]+$/.test(a)) ?? "0";
    const isAudio = conversation().some(row => (row.attachments as any[] || []).some(a => a.id === id && a.mime.startsWith("audio/")));
    if (isAudio) {
      // Synthetic tone envelope, never a recording of a real voice.
      const frames = 48000 * 12, data = Buffer.alloc(44 + frames * 2);
      data.write("RIFF"); data.writeUInt32LE(data.length - 8, 4); data.write("WAVEfmt ", 8);
      data.writeUInt32LE(16, 16); data.writeUInt16LE(1, 20); data.writeUInt16LE(1, 22);
      data.writeUInt32LE(48000, 24); data.writeUInt32LE(96000, 28); data.writeUInt16LE(2, 32); data.writeUInt16LE(16, 34);
      data.write("data", 36); data.writeUInt32LE(frames * 2, 40);
      for (let i = 0; i < frames; i++) {
        const envelope = Math.max(0, Math.sin(i / 11000) * Math.sin(i / 37000));
        data.writeInt16LE(Math.round(18000 * envelope * Math.sin(2 * Math.PI * 220 * i / 48000)), 44 + i * 2);
      }
      process.stdout.write(data); return;
    }
    const isSticker = id === "990001" || id === "990002" || conversation().some(row => (row.attachments as any[] || []).some(a => a.id === id && a.sticker));
    if (isSticker) {
      // Procedural transparent art: no real person's image or downloaded media.
      const r = spawnSync("magick", ["-size", "192x192", "xc:none", "-fill", "#ffd45c", "-stroke", "#edb742", "-strokewidth", "3", "-draw", "polygon 96,10 118,64 176,68 132,108 146,168 96,138 46,168 60,108 16,68 74,64", "-stroke", "none", "-fill", "#513d32", "-draw", "circle 75,87 79,87 circle 117,87 121,87", "-stroke", "#513d32", "-strokewidth", "5", "-fill", "none", "-draw", "path 'M 76,110 Q 96,130 116,110'", "png:-"], { maxBuffer: 8 << 20 });
      if (r.status !== 0 || !r.stdout?.length) process.exit(1);
      process.stdout.write(r.stdout as Buffer); return;
    }
    const hue = (Number(id) % 12) * 30;
    const r = spawnSync("magick", [
      "-size", `${dim}x${Math.round(Number(dim) * 0.75)}`,
      `gradient:hsl(${hue},60%,42%)-hsl(${(hue + 40) % 360},55%,22%)`,
      "-gravity", "center", "-font", FONT, "-pointsize", String(Math.round(Number(dim) / 12)),
      "-fill", "white", "-annotate", "+0+0", "LAKE TRAIL",
      "-quality", "80", "jpg:-",
    ], { maxBuffer: 32 << 20 });
    if (r.status !== 0 || !r.stdout?.length) process.exit(1);
    process.stdout.write(r.stdout as Buffer);
    return;
  }

  if (sub === "watch") { setInterval(() => {}, 1 << 30); return; }   // never fires

  process.stderr.write(`fake-imsg: unsupported subcommand ${JSON.stringify(sub)}\n`);
  process.exit(2);
}

main();
